#Claude
.claude/


# Dependencies
node_modules/
package-lock.json

# Build artifacts — TypeScript
dist/
!hooks/dist/
build/
out/
*.tsbuildinfo

# Build artifacts — Go (but keep shipped helpers).
# WARNING: every shipped helper MUST be listed here as `!bin/<name>` or it
# gets silently dropped from the plugin distribution. New helper added?
# Add the exception line here AND verify with `git ls-files bin/`.
bin/*
!bin/monitor
!bin/fusion-rules
!bin/fusion-workbench-root
!bin/fusion-session-mark
!bin/fusion-commit-lock
!bin/fusion-paths
!bin/fusion-plane
!bin/fusion-plugin-cwd
!bin/fusion-count-sources
*.exe
# Generated protobuf (rebuild from .proto)
*.pb.go
*_grpc.pb.go
# Named Go binaries in reactor/
fusion/reactor/reactor

# Secrets and environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json

# Claude Code local settings (per arch-003: hooks in local only)
.claude/settings.local.json
.claude/.needs-reanchor

# fusion-workbench is a runtime artifact created by agents in the consuming project
## fusion-workbench/

# .fusion/ is the fusion install directory (install.sh default: ~/.fusion, overridable
# via FUSION_HOME). Runtime artifact, never source.
.fusion/

# Audit logs (append-only, machine-generated)
fusion_journal/audit/*.log

# Archives and backups
*.zip
*.tar.gz
*.tgz

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*.swn

# Test and coverage
coverage/
*.lcov

# Temp files
*.tmp
*.bak
*.pid
