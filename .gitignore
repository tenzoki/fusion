#Claude
.claude/


# Dependencies
node_modules/
package-lock.json

# Build artifacts — TypeScript
dist/
!hooks/dist/
# Per-invocation compile staging (hooks/scripts/build.mjs). The shipped
# hooks/dist/ is synced from here by atomic rename so a concurrent test run
# never sees it absent; these directories are the transient half and are
# removed by the build that made them.
hooks/.build-staging/
build/
out/
*.tsbuildinfo

# Build artifacts — Go (but keep shipped helpers).
# WARNING: every shipped helper MUST be listed here as `!bin/<name>` or it
# gets silently dropped from the plugin distribution. New helper added?
# Add the exception line here AND verify with `git ls-files bin/`. Helper
# REMOVED? Take its line out too — nothing checks that this list matches `bin/`,
# so a stale exception sits here naming a file that does not exist and reads to
# the next editor as a helper that failed to ship.
bin/*
!bin/monitor
!bin/fusion-rules
!bin/fusion-workbench-root
!bin/fusion-session-mark
!bin/fusion-commit-lock
!bin/fusion-paths
!bin/fusion-plugin-cwd
!bin/fusion-source-root
!bin/fusion-count-sources
!bin/fusion-review-coverage
!bin/fusion-staging-drift
!bin/fusion-turn-budget
!bin/fusion-prose-metric
!bin/fusion-identity
!bin/fusion-session-domain
!bin/fusion-events
!bin/fusion-cadence-anchor
*.exe
# Generated protobuf (rebuild from .proto)
*.pb.go
*_grpc.pb.go
# Named Go binaries in reactor/
fusion/reactor/reactor

# Secrets and environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json

# Claude Code local settings (per arch-003: hooks in local only)
.claude/settings.local.json
.claude/.needs-reanchor

# fusion-workbench. In THIS repository it is deliberately tracked (a consuming project
# decides for itself; fusion ships no rule for it). Tracked does not mean all of it:
# rules/workbench-tracking.md partitions every root-anchored entry into four classes and
# is their authoring home. Git carries R1, R2 and R3; class L stays in the checkout that
# wrote it, because it only ever produces diff noise and — restored by a checkout — a lie
# about a session that ended. This repository applies exactly that partition, so every
# path excluded below is class L. The partition's two consequences, one binding the
# lifecycle skills and one binding any command that sweeps the tree, are stated there too.
# KEPT: orchestrator-events.jsonl, .fusion-setup, .asset-provenance.
# The guard's own event log (.guard-state/events.jsonl) is class L like the rest of that
# directory, and it is deliberately NOT excepted here: what preserves it is the archive
# step of /fusion:cleanup, which rolls it into fusion-workbench/archive/ under a dated
# name, where the rolled copy is an ordinary class R1 archived file. So the evidence lands
# in git without the live log producing a diff on every tool call.
# Directory entries use `dir/*`, not `dir/`, so a later `!path` exception still works.
fusion-workbench/agentstate.yaml
fusion-workbench/orchestrator-live.md
fusion-workbench/.session-marker
fusion-workbench/.active-circle
# The checkout identifier, minted once by bin/fusion-identity. Class L for the
# reason the field exists: a checkout that pulled another checkout's copy would
# be indistinguishable from it, which is the collision the identifier prevents.
fusion-workbench/.checkout-id
# High-water marks of this checkout's cleanup passes (bin/fusion-cadence-anchor); a pulled
# mark would claim coverage this checkout never performed.
fusion-workbench/.cadence-anchors
fusion-workbench/.guard-state/*
fusion-workbench/.commit-lock/*
# Verbatim copy of the tracked bin/monitor, re-created by /fusion:setup.
fusion-workbench/monitor
# Regenerated in full on every playmaker run.
fusion-workbench/portfolio.md

# .fusion/ is the fusion install directory (install.sh default: ~/.fusion, overridable
# via FUSION_HOME). Runtime artifact, never source.
.fusion/

# Audit logs (append-only, machine-generated)
fusion_journal/audit/*.log

# Archives and backups
*.zip
*.tar.gz
*.tgz

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*.swn

# Test and coverage
coverage/
*.lcov

# Temp files
*.tmp
*.bak
*.pid
