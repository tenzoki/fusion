#!/usr/bin/env bash
# fusion-session-domain — the one place a skill body reads the session's
# domain, instead of each body carrying its own two-line read of
# agentstate.yaml (issue 260810-2110_*_the-domain-capture-one-liner-is-now-copied-into-a-fourth-skill-body-and-the-copying-is-the-stated-justification.md: the same lines stood in three skill
# bodies and had already diverged on the first copy; decision 260810-2145_*_should-a-repeated-skill-body-snippet-become-a-bin-helper-now-that-one-fact-lives-in-four-executable-copies.md,
# the reserved half, chose a bin/ helper over a DOMAIN key in fusion-paths,
# which resolves paths and not state).
#
# Usage:
#   fusion-session-domain
#
# Takes no arguments. Output on stdout, two KEY=value lines in the shape
# `bin/fusion-paths` uses, always both and always in this order:
#
#   domain=code                  # code | data
#   source=event-log             # or `agentstate` or `default`; a caller
#                                # prints `helper-missing`
#
#   domain  `code` or `data`, resolved from three sources in this order and
#           defaulted to `code` when none of them answers.
#   source  WHICH of the three answered, so a caller that must report a
#           fallback rather than apply it silently has the fact on its own line:
#
#             event-log   the `domain` on the newest hook-written
#                         `session_start` row for this checkout in
#                         fusion-workbench/orchestrator-events.jsonl. Preferred
#                         because it is machine-written at SessionStart and
#                         cannot go stale, and because it is what survives the
#                         removal of the state file.
#             agentstate  `session.domain` in fusion-workbench/agentstate.yaml.
#                         The fallback while that file exists — every session
#                         whose installed hook predates the row's writer has no
#                         row to read.
#             default     neither answered. Never silent: one line on stderr
#                         says which of the two was absent, unset or holding a
#                         value that is neither `code` nor `data`.
#
#           A fourth value, `helper-missing`, is never printed here: it is what
#           each call site prints on its `[ -x ]` miss, when this program is not
#           installed at all, so the same line reports that case too.
#
# Exit codes:
#   0  both lines printed. A fallback is still a 0: the caller decides what a
#      defaulted domain means for its run, and this program does not.
#   2  usage error: an argument was given, or -h/--help. Nothing on stdout.
#   3  no fusion workbench above the working directory. Nothing on stdout;
#      the fallback is NOT printed, because without a workbench there is no
#      session for the domain to be the domain of, and `domain=code` here
#      would be a made-up answer about a project that has not run setup.
#
# The agentstate read is deliberately narrow, and its true bound is this: the FIRST
# `domain:` key sitting exactly two spaces deep, in whichever top-level block
# holds it, with the value double-quoted or bare. Only `session:` carries one today
# (`agents/orchestrator.md` `## Persistent State File`), so the read is the session's;
# a two-space `domain:` added to an earlier block would be read instead, and
# a `domain:` at any other depth is never read. The three call sites are
# skills/next/SKILL.md, skills/direct/SKILL.md and skills/cleanup/SKILL.md,
# each guarded with `[ -x ]` (decision 260810-0921_*_how-should-a-prompt-call-a-bin-helper-that-the-installed-copy-may-not-have.md) because an installed copy
# may predate this helper.

set -eu

usage() {
  echo "usage: fusion-session-domain" >&2
}

if [ "$#" -ne 0 ]; then
  usage
  exit 2
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

root=''
if [ -x "$here/fusion-workbench-root" ]; then
  root="$("$here/fusion-workbench-root" 2>/dev/null || true)"
fi
if [ -z "$root" ]; then
  echo "fusion-session-domain: no fusion workbench found above $(pwd). Run /fusion:setup at the project root." >&2
  exit 3
fi

# The event log first. Three filters decide a row and each answers a measured
# defect: `writer` tells the hook's row from the model's own `session_start` for
# the same session, which carries no domain; `checkout` drops another
# checkout's block, which a `merge=union` pull leaves interleaved with ours
# (260823-1302_*_the-monitor-attributes-a-merged-event-log-to-one-session-and-reports-another-checkouts-state.md);
# and `sort | tail -1` takes the newest, correct on the whole line because the
# emit convention puts a fixed-width UTC `ts` first, so lexical order IS
# chronological order. A row carrying no `checkout` reads as ours, which is what
# keeps every row written before that field existed readable.
log="$root/fusion-workbench/orchestrator-events.jsonl"
idfile="$root/fusion-workbench/.checkout-id"
mine=''
if [ -f "$idfile" ]; then
  mine="$(tr -d '[:space:]' < "$idfile" || true)"
fi

domain=''
if [ -f "$log" ]; then
  domain="$(awk -v mine="$mine" '
    index($0, "\"event\":\"session_start\"") == 0 { next }
    index($0, "\"writer\":\"session-start-hook\"") == 0 { next }
    {
      c = ""
      i = index($0, "\"checkout\":\"")
      if (i > 0) { r = substr($0, i + 12); c = substr(r, 1, index(r, "\"") - 1) }
      if (mine != "" && c != "" && c != mine) next
      print
    }' "$log" 2>/dev/null | sort | tail -1 |
    sed -nE 's/.*"domain":"([^"]*)".*/\1/p' || true)"
fi

case "$domain" in
  code|data)
    printf 'domain=%s\nsource=event-log\n' "$domain"
    exit 0
    ;;
esac
log_why="carries no hook-written session_start row with a domain for this checkout"
[ -f "$log" ] || log_why="does not exist"

state="$root/fusion-workbench/agentstate.yaml"
domain=''
if [ -f "$state" ]; then
  # Capture whatever stands there, so a value that is not `code` or `data`
  # is named as itself on stderr rather than as the whole line.
  domain="$(grep -E '^  domain:' "$state" | head -1 | sed -E 's/^  domain:[[:space:]]*"?([^"[:space:]]*)"?.*/\1/' || true)"
fi

case "$domain" in
  code|data)
    printf 'domain=%s\nsource=agentstate\n' "$domain"
    ;;
  *)
    echo "fusion-session-domain: $log $log_why." >&2
    if [ ! -f "$state" ]; then
      echo "fusion-session-domain: $state does not exist; domain defaulted to code." >&2
    elif [ -z "$domain" ]; then
      echo "fusion-session-domain: $state carries no session.domain; domain defaulted to code." >&2
    else
      echo "fusion-session-domain: $state carries session.domain=$domain, which is neither code nor data; domain defaulted to code." >&2
    fi
    printf 'domain=code\nsource=default\n'
    ;;
esac
