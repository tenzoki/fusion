#!/usr/bin/env bash
# fusion-events — read fusion-workbench/orchestrator-events.jsonl by the
# identity on each line, rather than by a line's position in the file.
#
# Usage:
#   fusion-events presence [--days N]      who else has been here (default 7)
#   fusion-events turns                    this session's Turn count
#
# Output on stdout, one KEY=value per line in the shape bin/fusion-paths
# established. Every reason goes to stderr, including bin/fusion-identity's own,
# which is passed through untouched. **A figure that could not be taken is
# absent from stdout and named on stderr; nothing here prints a zero it did not
# measure.**
#
#   presence
#     window_days=7
#     scope=pulled
#     other_people=1
#     other_checkouts=1
#     party=person<TAB>Jane Roe <jane@example.com><TAB>4f21ab90<TAB>2026-08-24T09:12:00<TAB>260824-0530-record-attribution-and-circle-claim
#     party=checkout<TAB>Kai Stalmann <ks@qantr.com><TAB>9c30ee11<TAB>2026-08-25T07:40:00<TAB>shared
#
#   turns
#     turns=3
#     history_file=circles/<stamp>-<slug>/history/<stamp>-orchestrator-session.md
#     scope=checkout
#
# **Two counts are on stderr and never on stdout**: lines of the log that were
# not a JSON object at all, and `turn_start` lines that named a Turn and could
# not say when. Neither is a figure taken from the log; each says how far the
# log fell short of letting one be taken. A `turns` count that is short by an
# unstamped line says it is short by an unstamped line rather than passing for
# whole.
#
# ---------------------------------------------------------------------------
# The `scope=` key, which both subcommands print and neither counts
#
# It is the figure's own disclaimer, in the shape of a figure's key.
#
# **`scope=pulled`** on presence is a constant: presence reflects only what this
# checkout has pulled, so a session another person started since the last fetch
# is invisible here and is not absence.
#
# **`scope=` on turns is not a constant.** It says what the count was taken
# over. `checkout` is the ordinary case, this checkout's own lines. It reads
# `all-checkouts` when the checkout identifier did not resolve, because then
# every line in the merged file is counted — the exact pre-C4 behaviour, kept
# deliberately as the stated degradation, and now named on stdout instead of on
# stderr alone.
#
# The key exists rather than a sixth exit code, and that is the whole of the
# choice. The widening used to be announced on stderr while stdout carried a
# number and the exit was 0; a caller instructed never to fall back to the
# whole-file count could not tell that this helper just had, because a prompt
# reads stdout and an exit code and captures no stderr. **The exit stays 0**:
# the count was taken, over a scope the key names, so a caller that ignores the
# key behaves exactly as it did before the key existed. A caller that must not
# accept a widened count reads the key and treats `all-checkouts` as
# unavailable. Record:
# `circles/260825-2023-presence-travels-monitor-filters-own-checkout/issues/260826-0131_*_turns-returns-exit-0-and-a-whole-file-count-when-the-checkout-is-unresolved-and-stdout-says-nothing.md`.
#
# `scope=` is printed **last**, so the two lines a caller was written against
# stay where they were, and it is printed on the exit-4 branch too, where the
# count could not be taken but the scope the search ran over still was.
#
# ---------------------------------------------------------------------------
# The `party=` line
#
# One `party=` line per distinct pair of person and checkout other than this
# one's, most recent first, carrying five TAB-separated fields: the class, the
# person, the checkout, the timestamp of that pair's most recent `session_start`
# in the window, and the Circle it ran on. **The separator is a TAB** because
# the person value is git's `Name <email>` form and contains spaces by
# construction. A person the line did not record renders `(not recorded)`; the
# Circle is read off `history_file` (`circles/<dir>/…` names its Circle,
# anything else is `shared`, an absent field is `unknown`) and off no field of
# its own.
#
# **Every field is flattened before it is joined**: a control character inside
# one, TAB and newline included, becomes a single space. `person` is git's
# `user.name` and `user.email` as some other machine holds them, and JSON
# carries a `\t` or a `\n` through the round trip intact — so without this a TAB
# in a person value shifted every later field by one and a newline split the
# record in two. The record is therefore always one line of exactly five fields.
# The flattening is not reversible, which is the price: none of the five fields
# means anything different for having had a control character taken out of it.
#
# **The order is total.** Most recent first, then by checkout, then by person —
# which is the whole of the pair a party is distinguished by, so no two lines
# fall back on their position in the file.
#
# Three classes, and the split is disjoint and complete:
#
#   this checkout's own   `checkout` absent, or equal to ours. Not presence, and
#                         not printed. **An absent identifier reads as ours**,
#                         which is what carries the whole pre-C4 log and what
#                         makes an unresolved reader behave exactly as it did
#                         before this helper existed.
#   checkout              a further checkout of the reading person.
#   person                another party — named by its person where the field is
#                         present, and counted as its own party by its checkout
#                         where it is not.
#   unknown               reached only on exit 4, where the two cannot be told
#                         apart at all.
#
# Exit codes. The 0/1/2 core is shared with bin/fusion-paths and
# bin/fusion-rules; 3 and 4 are this helper's own and mean something different
# per subcommand.
#
#   0  measured. `other_people=0` and `turns=0` are real answers and reach this
#      code, and so does a `turns` count taken over `scope=all-checkouts`: the
#      figure was taken, and the key says what it was taken over.
#   1  usage error.
#   2  no fusion workbench above the working directory.
#   3  presence: no line can be classified, so no count is printed. Two causes,
#      both named on stderr — this checkout could not be identified, or the log
#      could not be read.
#      turns: there is no session to scope to. Three causes, named on stderr —
#      no agentstate.yaml, no `session.history_file` in it, or no log.
#   4  presence: the person half is not in hand, so another person cannot be
#      told from a further checkout of your own. `other_checkouts` is printed,
#      `other_people` is not, and every party line reads `unknown`.
#      **Two different states reach this code and stderr says which.** Either
#      the person could not be read (bin/fusion-identity's 1, 3 or 127, or a
#      code this reader does not know), or **no git identity is owed at all**
#      because this is not a git work tree (its 4 and 5). The second is not a
#      fault and nothing is missing; fusion supports a non-git project
#      deliberately. The code is 4 for both because what a caller does is
#      identical, and because exit 0 would promise an `other_people` this run
#      did not take.
#      **`other_checkouts` denotes a wider set here.** At exit 0 it counts
#      further checkouts of the reading person; at exit 4 it counts every other
#      checkout, because without the reading person none of them can be told
#      from one of the reader's own. One key, two denotations, and the exit code
#      is which.
#      turns: the count could not be taken. `history_file=` and `scope=` are
#      printed and `turns=` is not. **A finding, not a zero.** Two causes, both
#      named on stderr: no `session_start` among the counted lines names that
#      history file, or the one that does carries no readable `ts`, so no window
#      can be opened. They share what the caller does, which is why one code
#      carries both — the same reasoning 3 gives below.
#   5  the plugin's compiled hooks are missing, so nothing could be asked.
#
# Two notes on that table, because both are easy to get wrong.
#
# **3 names an outcome, never a cause**, the way bin/fusion-identity's 3 does.
# Its causes differ in what a human goes and fixes, and not at all in what the
# caller does, so the cause is on stderr and the code is one number.
#
# **A broken install is 5 here and 3 in the sibling helpers.** Each of
# bin/fusion-turn-budget, bin/fusion-review-coverage and bin/fusion-staging-drift
# spends its 3 on it, for the reason their headers give: "there is nothing to check"
# is an answer about the project, and a broken install must never be reported as
# one. That reasoning is why the code moved rather than the principle — here 3
# is already an answer about the project, so the broken install needs a number
# of its own.
#
# ---------------------------------------------------------------------------
# Why the identity is passed in rather than looked up
#
# `bin/fusion-identity` is the one place in the tree a run obtains who wrote a
# record and which checkout holds it. This script runs it, and hands PERSON,
# CHECKOUT and its exit code to the node program in the environment
# (FUSION_EVENTS_PERSON, FUSION_EVENTS_CHECKOUT, FUSION_EVENTS_IDENTITY_EXIT).
#
# Two things follow, and both are the point. The criterion stays evaluated in
# one place: nothing downstream re-derives a person from git or mints a checkout
# identifier, and a reader that could not obtain either says so from a number
# rather than by testing an empty capture. And `hooks/lib/events-query.ts` stays
# a pure function of the log text, the reading identity and the current time —
# no git, no workbench, no subprocess — so every case in the classification
# table above is a fixture string and an assertion.
#
# **That helper's exit vocabulary is translated in exactly one place**, and
# every branch of this reader consults it rather than testing a code of its own:
# `resolveIdentity` in hooks/events-query.ts. The reason is the helper's own —
# its header devotes a section to why 1 and 4 must stay distinguishable, and a
# switch repeated per branch is precisely how they stop being. It had already
# happened: exit 4 was read as though it said the identity could not be read,
# when what it says is that none is owed, and the two sentences the program then
# printed contradicted each other. Record:
# `circles/260825-2023-presence-travels-monitor-filters-own-checkout/issues/260826-0135_*_a-tree-that-owes-no-git-identity-is-read-as-one-whose-identity-could-not-be-read.md`.
#
# The call is `[ -x ]`-guarded per
# `shared/decisions/260810-0921_*_how-should-a-prompt-call-a-bin-helper-that-the-installed-copy-may-not-have.md`:
# an installed copy need not carry a helper added between releases, and a bare
# call would be exit 127 in the middle of this script. The missing case is
# passed through as the sentinel 127 and reported, never silently treated as an
# unidentified checkout.
#
# ---------------------------------------------------------------------------
# Why this exists
#
# The event log is class R2 in rules/workbench-tracking.md and carries
# `merge=union`, so after a pull it holds two checkouts' lines with no ordering
# between the blocks — and every reader treated it as one session's chronology.
# Sorting it moves that reading from vague to wrong rather than repairing it
# (`circles/260823-0023-settle-what-travels-between-checkouts/issues/260823-1302_*_the-monitor-attributes-a-merged-event-log-to-one-session-and-reports-another-checkouts-state.md`).
# So membership is read off the line instead of inferred from its neighbours,
# and this is the two readings that follow.
#
# `turns` also replaces four copies of a whole-file `grep -c turn_start`, which
# counted every checkout's Turns and every previous session's. It reports
# `unavailable` to its callers through exit 3 and 4 rather than through a
# smaller number, because the defect being repaired is exactly a count that
# looked like an answer.
#
# The work is hooks/dist/events-query.js, resolved relative to this script
# rather than through $FUSION_PLUGIN_ROOT, so an install copy and a work tree
# each run their own build. node is already a hard requirement — the guard hooks
# are node programs (hooks/hooks.json).

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
entry="$here/../hooks/dist/events-query.js"

if [ ! -f "$entry" ]; then
  echo "fusion-events: $entry is missing — the plugin's compiled hooks are not installed." >&2
  exit 5
fi

# --- the identity, obtained in the one place that obtains it ----------------

id_out=''
id_exit=127

if [ ! -x "$here/fusion-identity" ]; then
  echo "fusion-events: $here/fusion-identity is missing — this install predates it." >&2
else
  # Its stderr passes through: the cause of a missing half is worth more to a
  # human than the code alone, and the node program phrases only what the code
  # can carry.
  if id_out="$("$here/fusion-identity")"; then
    id_exit=0
  else
    id_exit=$?
  fi
fi

person="$(printf '%s\n' "$id_out" | sed -n 's/^PERSON=//p' | head -1)"
checkout="$(printf '%s\n' "$id_out" | sed -n 's/^CHECKOUT=//p' | head -1)"

export FUSION_EVENTS_PERSON="$person"
export FUSION_EVENTS_CHECKOUT="$checkout"
export FUSION_EVENTS_IDENTITY_EXIT="$id_exit"

exec node "$entry" "$@"
