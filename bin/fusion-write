#!/usr/bin/env bash
# fusion-write — the Claude side's one route to a change of JSON control data.
#
# Usage:
#   fusion-write <subcommand> --actor <token> [--record <control path>] [flags]
#   fusion-write log-repair
#   fusion-write initialize --workbench <dir>
#
# One codec mutation per run, through `hooks/dist/write.js` and the record
# client, over the workbench found above the working directory. Every
# subcommand but `create` names its record with `--record`. A control path is
# workbench-relative, the `path` that `show` and `list` answer. `--actor` is
# who acts, `user` or an agent's name: attribution, never authorisation.
#
#   claim             this checkout claims the package
#   release           --reason <text>
#   transition        --to <state> --reason <text> [payload flags]
#   set-mode          --value ordinary | --value autonomous --source <JSON>
#   set-dependencies  --on <terminal|succeeded>:<control path> (repeatable) | --clear
#   adopt-plan        --plan <control path> [--role plan|spec]
#   attach-evidence   --evidence <control path of the evidence record>
#   create            --kind package|issue|plan|discussion|decision
#                     --narrative-file <workbench path> --origin user-request|<package
#                     control path> [--domain <token>, a package's alone]. The caller
#                     writes the Markdown first, at a marker-free name; the codec
#                     writes the control file beside it, in the kind's initial state
#   evidence          --record <package control path> --report <workbench path>
#                     --verdict accept|revise|escalate: a reviewer's evidence record
#                     beside its report, against the package's brief and plan, over
#                     the project's HEAD tree, host claude-code, claude-guided
#   log-repair        append rows an earlier run retained; sends no request
#   initialize        /fusion:setup's alone: --workbench names the target, which
#                     has no marker yet, so no workbench is looked up and no
#                     identity read. Split on `inspect` (`hooks/lib/record-write.ts`
#                     `## Initialize, Setup's route to a new workbench`): reused,
#                     legacy (a pre-JSON workbench, its `.fusion-setup` present or,
#                     the marker lost, a fusion store: work-packages, circles,
#                     shared), the pending intent resent once, or a new one sent
#                     once (a target holding no fusion store); after
#                     a landed answer `inspect` must name the id sent
#
# Payload flags of `transition`, each a JSON value, each read only for the
# kinds that carry it; any other is a usage error:
#   package   --claim --outcome
#   issue     --disposition
#   plan      --steps --criteria
#   decision  --answer-ref --implementation-ref --superseded-by --deferral
# The table is `PAYLOAD_FIELDS` in `hooks/lib/record-write.ts`, held equal to
# the codec's schemas by `hooks/lib/__tests__/record-write.test.ts`.
#
# A re-send, the one route after an unknown outcome, repeats the same
# arguments with `--operation-id <id> --expected-revision <sha256>` (and
# `--claimed-at <time>` for claim; `--id <uuid>` for create, and with
# `--accepted-at <time>` for evidence), exactly as the unknown outcome printed
# them. It composes no `record_change` row.
#
# Output on stdout, `KEY=value`:
#   landed    result=landed, operation_id=, a path= and revision= pair per
#             record written, event= (logged | pending | unlogged | none)
#   refused   result=refused, operation_id=
#   unknown   result=unknown, operation_id=, then what the re-send repeats:
#             expected_revision= and claimed_at=, or id= and accepted_at=
#   log-repair  appended=, retained=
#   initialize  result=initialized|reused|legacy, workbench_id= (not for legacy),
#             operation_id= when one was sent; on a stop result=<kind> of the
#             exit table below, with operation_id= when one was sent
#   any mutation, last: retained= (a count, or unread) when the repair of
#             retained rows run before it failed or left rows retained, with
#             one stderr line; the outcome above stands either way
# Every reason on stderr, one line each, prefixed `fusion-write:`.
#
# Exit codes:
#   0  landed. `event=pending` names rows retained in
#      `.guard-state/record-change-pending.jsonl` for a later run, and
#      `event=unlogged` a change no row records; neither is resent.
#      For log-repair: answered, `retained=` counting what is still held.
#      For initialize: Setup continues (initialized, reused or legacy).
#   1  the caller stops: no fusion workbench above the working directory, or
#      `bin/fusion-identity` exiting 1, its own stop code.
#   2  usage error. Nothing sent. A payload flag the record's kind does not
#      carry is found after `show` names the kind, before the mutation.
#   3  install incomplete: this helper's entry, `bin/fusion-identity`, the
#      codec bundle or (for evidence) the plugin's version is missing, or an
#      internal fault stopped the entry.
#   4  the workbench, a named record or what evidence binds was not read:
#      legacy (with a pending initialize, which /fusion:setup finishes),
#      unsupported, a read the codec refused or left unanswered, the report
#      file, or the project's HEAD tree. Nothing sent. For initialize also a
#      blocked or unreadable pending intent (corrected by hand), and a landed
#      answer after which `inspect` does not name the id sent.
#   5  ownership refused. `release` and every `transition` out of `claimed`
#      need the standing claim to be this checkout's, and a request that
#      writes a claim (`claim`, or a `transition` into `claimed` or carrying a
#      non-null `--claim`) must name this checkout's identifier as its
#      `checkout_id`; a foreign claim, standing or written, or an unreadable
#      identity refuses, and no flag overrides it. Nothing sent.
#   6  the codec refused the mutation, its class and reason on stderr
#      (`conflict/revision-mismatch` when the record moved after `show`;
#      for initialize `target-not-empty` or `manifest-present`, naming entries).
#      Nothing landed; nothing is retried.
#   7  outcome unknown: no answer arrived, and the change may have landed.
#      Nothing is retried; the re-send above learns the outcome. For
#      initialize, Setup run again resends the intent `inspect` names.
#
# Called by a person, a skill block or an agent, never by an automatic hook
# (`hooks/lib/record-client.ts` `## The recovery declaration`), which
# `hooks/lib/__tests__/hook-route-exclusion.test.ts` pins with a stub of this
# file. Ownership is response 22 (a) of `codec/fixtures/prior/REQUESTS.md`,
# checked on the checkout identity alone, as stated there for Prior.

set -eu

usage() {
  sed -n '3,7p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  printf 'See the header of this script for the flags and the exit table.\n' >&2
}

case "${1:-}" in
  ""|-h|--help)
    usage
    exit 2
    ;;
esac

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
entry="$here/../hooks/dist/write.js"

# Setup's call names a target that has no marker yet, so it comes before the
# workbench lookup and reads no identity.
if [ "$1" = "initialize" ]; then
  if [ "$#" -ne 3 ] || [ "$2" != "--workbench" ] || [ -z "$3" ]; then
    printf 'fusion-write: initialize takes --workbench <dir> and nothing else. Nothing sent.\n' >&2
    exit 2
  fi
  if [ ! -f "$entry" ]; then
    printf 'fusion-write: %s is missing; the plugin install is incomplete. Nothing sent.\n' "$entry" >&2
    exit 3
  fi
  exec node "$entry" initialize "$3" "" ""
fi

if [ ! -x "$here/fusion-workbench-root" ]; then
  printf 'fusion-write: %s is missing; the plugin install is incomplete. Nothing sent.\n' "$here/fusion-workbench-root" >&2
  exit 3
fi
root="$("$here/fusion-workbench-root" 2>/dev/null || true)"
if [ -z "$root" ]; then
  printf 'fusion-write: no fusion workbench found above %s. Run /fusion:setup at the project root.\n' "$(pwd)" >&2
  exit 1
fi

if [ ! -f "$entry" ]; then
  printf 'fusion-write: %s is missing; the plugin install is incomplete. Nothing sent.\n' "$entry" >&2
  exit 3
fi

sub="$1"
shift

if [ "$sub" = "log-repair" ]; then
  exec node "$entry" log-repair "$root/fusion-workbench" "" "" "$@"
fi

# --- this checkout ----------------------------------------------------------
#
# Read once, here, and handed to the entry: the ownership check, a claim and
# the rows all use this one reading. Exit 3, 4 and 5 of the identity helper
# leave a half unread, which the entry receives as "".

if [ ! -x "$here/fusion-identity" ]; then
  printf 'fusion-write: %s is missing; the plugin install is incomplete. Nothing sent.\n' "$here/fusion-identity" >&2
  exit 3
fi
set +e
id_out="$("$here/fusion-identity")"
id_rc=$?
set -e
case "$id_rc" in
  0|3|4|5) ;;
  1)
    printf 'fusion-write: bin/fusion-identity stopped, for the reason it printed above. Nothing sent.\n' >&2
    exit 1
    ;;
  *)
    printf 'fusion-write: bin/fusion-identity exited %s, which this program does not recognise. Nothing sent.\n' "$id_rc" >&2
    exit 3
    ;;
esac
person="$(printf '%s\n' "$id_out" | sed -n 's/^PERSON=//p' | head -n 1)"
checkout="$(printf '%s\n' "$id_out" | sed -n 's/^CHECKOUT=//p' | head -n 1)"

exec node "$entry" "$sub" "$root/fusion-workbench" "$person" "$checkout" "$@"
