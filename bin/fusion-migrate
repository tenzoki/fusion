#!/usr/bin/env bash
# fusion-migrate — a v12 Markdown workbench to JSON control, on this machine.
#
# Usage:
#   fusion-migrate survey
#   fusion-migrate repair --list [--optional]
#   fusion-migrate repair --apply <finding> [--value <key>=<value>]... [--consent]
#   fusion-migrate run
#   fusion-migrate resume
#   fusion-migrate rollback [--end-fence]
#   fusion-migrate restore-backup --consent
#   fusion-migrate set-aside --consent
#   fusion-migrate status
# Every subcommand also takes --session <dir> (default
# $HOME/.fusion-migrate/<12 hex of the workbench's real path>).
#
# Over the workbench found above the working directory, through
# `hooks/dist/migrate.js`, whose header is the account of the session, the
# ids and setup metadata. The host reads the Markdown and composes; the codec
# (`bin/fusion-record`'s bundle) writes every control, plan and answer byte.
# Plugin and Node only outside a git repository. Inside one (a `.git` entry at
# or above the workbench) git is required too, and is asked.
# Each entry says what the subcommand does where it proceeds; where it stops,
# stderr says why (the exit table below) and `status` shows where the run stands.
#
#   survey          counts of the record cut, findings by class, the derived
#                   and defaulted values by rule, and each blocking finding
#                   with its id. Writes nothing.
#   repair --list   per blocking finding its proposed edit and every question,
#                   or why it stays blocking; with --optional, the same for
#                   each reported finding that has a repair. Writes nothing.
#                   The migration requires no repair: what the Markdown does
#                   not record is derived from git, carried as unknown or
#                   defaulted, and marked in the control's
#                   legacy_fields.derived (hooks/lib/legacy-import.ts).
#   repair --apply  one finding, blocking or optional, with consent and every
#                   asked value; the value is then a recorded one. The first
#                   repair takes the full backup into the session, verified by
#                   tree hash, before any edit, and each is logged with its
#                   hashes. A terminal record's actor goes into its control
#                   file only. A finding id binds its file's bytes: an edit
#                   since `--list` makes it unknown.
#   run             the migration: its preconditions; a live .session-marker
#                   reported, untracked and ignored files listed; the backup;
#                   the survey, and a refusal while any blocking finding
#                   remains, printing those lines first; then the proposal into
#                   .json-state/migration/, plan, one apply per chunk, verify,
#                   setup metadata and `maintenance end`. A refused precondition
#                   is exit 5 and names itself on stderr; a v11 store name is
#                   routed to /fusion:migrate's rename, a codec without
#                   `migration` to an update. While the session holds a record
#                   not rolled back, it sends no migration request.
#   resume          sends the next request whose answer is not stored, under
#                   its recorded id, after an interruption or an unknown outcome.
#   rollback        every landed chunk in reverse, chunk 0, and the fence's end;
#                   after activation under a fence of its own. Resumable.
#                   Restores the frozen post-repair input. When the codec
#                   refuses the first chunk after activation, it ends that
#                   fence only where work stored since the plan already bars
#                   every rollback of this migration (the codec's audit);
#                   otherwise the fence stays.
#   rollback --end-fence
#                   ends the fence this session's rollback began and left
#                   standing: on a store under JSON control through the codec's
#                   `maintenance end`, after which the codec refuses every
#                   later rollback of this migration; over a tree that reads
#                   as legacy Markdown again (a git reset is one way there),
#                   where the codec cannot, by removing
#                   .json-state/maintenance.json itself. It ends no other
#                   fence and itself removes no other file of the workbench,
#                   and it removes that one only where no rollback chunk of
#                   the record is stored. Whether the file may be deleted by
#                   hand is said only by the helper's own message.
#   restore-backup  the pre-repair backup back over a legacy store with no
#                   fence and no plan files, checked by tree hash; .json-state/
#                   stays. Never calls the codec.
#   set-aside       with --consent, renames the session directory to
#                   <dir>.stale-<UTC stamp>, so its backup, repair log and ids
#                   stay readable through --session; for a record `status`
#                   reports as record=stale. It deletes nothing and renames
#                   nothing else; it renames no record that reads as current,
#                   nothing while the codec reports a fence or a pending
#                   intent, and nothing where the new name exists.
#   status          where the recorded run stands, and with record=stale that
#                   the session's record and the tree disagree.
#
# Output on stdout, `KEY=value`, fields separated by a tab; every reason on
# stderr, prefixed `fusion-migrate:`.
#
# Exit codes:
#   0  done, or nothing left to do.
#   1  no fusion workbench above the working directory.
#   2  usage.
#   3  install incomplete (this entry or the codec bundle missing) or an
#      internal fault; `status` names where the run stands. Inside a git
#      repository, a git that is missing or refuses (not installed, dubious
#      ownership, killed) is an exit 3 naming the call and the reason.
#   4  Node is missing or older than codec/package.json's engines; nothing
#      was read or written.
#   5  a precondition refused, named on stderr.
#   6  blocking findings remain, or a repair was not applied (no consent, an
#      unanswered question, a file changed).
#   7  an outcome is unknown: the codec gave no answer. `resume` (or
#      `rollback`) sends the same request again.
#   8  the codec refused a request; its class and reason are on stderr.
#   9  the backup does not verify; nothing was repaired or restored.
#
# Called by a person or `/fusion:migrate`, never by an automatic hook
# (`hooks/lib/record-client.ts` `## The recovery declaration`), which
# `hooks/lib/__tests__/hook-route-exclusion.test.ts` pins with a stub of this
# file. A call site guards with [ -x ].

set -eu

usage() {
  sed -n '3,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
}

case "${1:-}" in
  survey|repair|run|resume|rollback|restore-backup|set-aside|status) ;;
  *)
    usage
    exit 2
    ;;
esac

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Node before anything else: no read, backup, repair or request without it.
want="$(sed -n 's/.*"node": *">=\([0-9][0-9.]*\)".*/\1/p' "$here/../codec/package.json" 2>/dev/null | head -n 1)"
want="${want:-20.12.0}"
if ! command -v node >/dev/null 2>&1; then
  printf 'fusion-migrate: Node %s or later is required and `node` is not on PATH. Nothing was read or written.\n' "$want" >&2
  exit 4
fi
have="$(node --version 2>/dev/null | sed 's/^v//')"
older() {
  local IFS=.
  local -a a=($1) b=($2)
  local i
  for i in 0 1 2; do
    if [ "${a[$i]:-0}" -lt "${b[$i]:-0}" ] 2>/dev/null; then return 0; fi
    if [ "${a[$i]:-0}" -gt "${b[$i]:-0}" ] 2>/dev/null; then return 1; fi
  done
  return 1
}
if [ -z "$have" ] || ! [[ "$have" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]] || older "${have%%-*}" "$want"; then
  printf 'fusion-migrate: Node %s or later is required; `node` reports %s. Nothing was read or written.\n' "$want" "${have:-nothing}" >&2
  exit 4
fi

entry="$here/../hooks/dist/migrate.js"
if [ ! -x "$here/fusion-workbench-root" ]; then
  printf 'fusion-migrate: %s is missing; the plugin install is incomplete.\n' "$here/fusion-workbench-root" >&2
  exit 3
fi
root="$("$here/fusion-workbench-root" 2>/dev/null || true)"
if [ -z "$root" ]; then
  printf 'fusion-migrate: no fusion workbench found above %s. Run /fusion:setup at the project root.\n' "$(pwd)" >&2
  exit 1
fi
if [ ! -f "$entry" ] || [ ! -f "$here/../codec/dist/fusion-record.js" ]; then
  printf 'fusion-migrate: %s or the codec bundle is missing; the plugin install is incomplete.\n' "$entry" >&2
  exit 3
fi

sub="$1"
shift
exec node "$entry" "$sub" "$root/fusion-workbench" "$@"
