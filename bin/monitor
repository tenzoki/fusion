#!/usr/bin/env bash
# monitor — HTML-based orchestrator monitor
# Serves a live dashboard for orchestrator-live.md, agentstate.yaml,
# orchestrator-events.jsonl and .guard-state/events.jsonl
# Usage: ./monitor <name> <port> [-d workbench_dir] [-n events] [-i interval_sec]

set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: $0 <name> <port> [-d workbench_dir] [-n events] [-i interval_sec]" >&2
  echo "" >&2
  echo "  name   Display name shown in the browser tab (e.g. 'F03-fusion', 'unite')" >&2
  echo "  port   HTTP port to serve on (e.g. 8088, 8089)" >&2
  echo "" >&2
  echo "  -d     Path to fusion-workbench/ directory (default: ./fusion-workbench)" >&2
  echo "  -n     Max event lines to show (default: 100)" >&2
  echo "  -i     Refresh interval in seconds (default: 2)" >&2
  echo "" >&2
  echo "  Both name and port are required so multiple monitors can run in parallel." >&2
  echo "" >&2
  echo "  Note: if another process is listening on <port> when monitor starts, monitor" >&2
  echo "  will SIGTERM it before binding (intentional — clears stale prior monitors)." >&2
  echo "  Pass an unused port if you don't want this behavior." >&2
  echo "" >&2
  echo "  Env: MONITOR_BIND sets the bind address. The default is the dual-stack" >&2
  echo "  wildcard — LAN-reachable, and answering on both 127.0.0.1 and ::1, so" >&2
  echo "  the localhost URL below is true whichever family the resolver returns" >&2
  echo "  first. Set MONITOR_BIND=127.0.0.1 for a loopback-only IPv4 server." >&2
  echo "" >&2
  echo "  The URL the banner prints, and the one the browser tab opens at, is" >&2
  echo "  the address the server actually bound — so it names localhost only" >&2
  echo "  where localhost is true, and 127.0.0.1 where it is not." >&2
  echo "" >&2
  echo "  Env: MONITOR_NO_BROWSER, set to any non-empty value, starts the server" >&2
  echo "  without opening a browser tab on it." >&2
  echo "" >&2
  echo "  The tab only ever opens when stdout is a terminal. A monitor started" >&2
  echo "  from a script, a test, a CI job or any redirected stdout serves the" >&2
  echo "  dashboard and opens nothing." >&2
  exit 1
fi

MONITOR_NAME="$1"
PORT="$2"
shift 2

MAX_EVENTS=100
INTERVAL=2
WORKBENCH_DIR=""

while getopts "d:n:i:" opt; do
  case $opt in
    d) WORKBENCH_DIR=$OPTARG ;;
    n) MAX_EVENTS=$OPTARG ;;
    i) INTERVAL=$OPTARG ;;
    *) echo "Usage: $0 <name> <port> [-d workbench_dir] [-n events] [-i interval_sec]" >&2; exit 1 ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Default workbench directory: look for fusion-workbench/ in current directory
if [[ -z "$WORKBENCH_DIR" ]]; then
  if [[ -d "./fusion-workbench" ]]; then
    WORKBENCH_DIR="./fusion-workbench"
  else
    WORKBENCH_DIR="$SCRIPT_DIR"
  fi
fi
WORKBENCH_DIR="$(cd "$WORKBENCH_DIR" 2>/dev/null && pwd || echo "$WORKBENCH_DIR")"
TMPDIR_PATH="$(mktemp -d)"
TMPFILE="$TMPDIR_PATH/monitor-server.py"
# The server writes the URL it actually answers at here, once it has bound. See
# the `local_host` block in the python below for why the wrapper may not
# compose that URL itself.
URL_FILE="$TMPDIR_PATH/monitor-url"

cleanup() { rm -rf "$TMPDIR_PATH"; }
trap cleanup EXIT INT TERM

cat > "$TMPFILE" << 'PYTHON_SCRIPT'
import http.server
import json
import os
import sys

MONITOR_NAME = sys.argv[1]
PORT = int(sys.argv[2])
MAX_EVENTS = int(sys.argv[3])
INTERVAL = int(sys.argv[4])
BASE_DIR = sys.argv[5]
BIND = sys.argv[6]
# Where to publish the URL this server actually answers at, for the bash
# wrapper's browser launcher. The wrapper forks this process and then has no
# channel back from it, so it used to compose the tab's URL from a constant —
# `http://localhost:$PORT` — while only this process knows which server got
# built. Optional: an argv short of it just means nobody asked, and the
# launcher keeps its constant.
LOCAL_URL_FILE = sys.argv[7] if len(sys.argv) > 7 else ""

# Line-buffer stdout, because this process prints once and then blocks forever.
#
# Python block-buffers stdout whenever it is not a terminal, and the only
# writer here is the startup banner — a few hundred bytes, nowhere near the
# 8 KB that would flush a block buffer on its own. serve_forever() then blocks,
# so a monitor started with stdout redirected to a log file wrote an empty log
# for its entire life and emitted the banner only at shutdown, if it was shut
# down gently enough to run its exit handlers at all. Under SIGKILL the banner
# was simply lost. Every non-interactive caller — a test harness, a CI job,
# nohup, a background job whose output someone tails — is in exactly that case,
# and the banner is the one place the serving URL and the watched directory are
# stated.
#
# Line buffering rather than a single flush after the banner: it also covers
# the shutdown line, and it leaves the next print anyone adds here correct by
# default instead of correct only if they remember.
try:
    sys.stdout.reconfigure(line_buffering=True)
except (AttributeError, OSError):
    pass

LIVE_MD = os.path.join(BASE_DIR, "orchestrator-live.md")
EVENTS_JSONL = os.path.join(BASE_DIR, "orchestrator-events.jsonl")
STATE_YAML = os.path.join(BASE_DIR, "agentstate.yaml")
GUARD_EVENTS_JSONL = os.path.join(BASE_DIR, ".guard-state", "events.jsonl")
# This checkout's own identifier. Read, never written: see _read_checkout_id().
CHECKOUT_ID_FILE = os.path.join(BASE_DIR, ".checkout-id")

# Guard events surfaced as sticky rows in the warnings panel. Three kinds
# qualify, and the distinction is what the panel is for:
#
#   - Warnings and blocks (guard_block, guard_halt) report something the user
#     did not ask for.
#   - Advisories (guard_advisory) report something the user DID ask for: a
#     write the guard would normally deny, let through because an override
#     flag was set. The user turned the guard down, so the user is the one
#     who has to see what that bought. Rendered at its own "Advisory" level,
#     not as a warning — see the level mapping in renderWarnings().
#   - Fail-opens (guard_error) report that a check did not run at all. Both
#     hooks catch an unexpected exception, allow the call anyway, and record
#     one of these (hooks/guard.ts and hooks/tracker.ts, in their respective
#     main().catch handlers). It is the one event meaning "the guard is not
#     protecting you", so a panel that omits it shows a guard protecting
#     nothing as normal operation. Rendered at the loudest level the panel
#     has — see renderWarnings().
#   - Stale session state (state_drift) reported that the numbers the dashboard
#     itself was drawing had stopped being written. NOTHING EMITS THIS ANY MORE.
#     hooks/tracker.ts measured agentstate.yaml, the active Circle's Turn log
#     and the session history against git and orchestrator-events.jsonl on every
#     guarded tool call (issue 260801-2038, measured six times); the measurement
#     was removed on 2026-08-15 with the hand-maintained session counters that
#     were its subject.
#
#     It stays in this panel, and the reason is the log rather than the hook:
#     orchestrator-events.jsonl is APPEND-ONLY and holds 29 real state_drift
#     rows, the most recent from the day the emitter was removed, and the
#     monitor is read across sessions against logs older than itself. A renderer
#     is styling for data, and this data still exists. Dropping the arm would
#     not remove a row — the rows still reach the panel through
#     WARNING_EVENT_TYPES — it would render them at the amber default with the
#     label "Warning", which is a worse reading of a historical divergence than
#     the one below. Same call, same reasoning, as the queue_built colour rule
#     kept one step earlier.
#
#     The divergence was never recomputed here — one measurement, in the hook,
#     surfaced by its event — so nothing in this file went looking for a state
#     file that has ceased to exist, then or now.
#
#   - A review gap (review_coverage) and an unstaged record (staging_drift)
#     are the two siblings of state_drift that outlived it. hooks/tracker.ts
#     still emits both, throttled on signature so a persisting miss is one
#     row, and the record that led to them (issue 260811-1143) argued that a
#     staging_drift row is the one whose subject can be LOST: a record that
#     missed its commit survives only in the working tree. Until they joined
#     this set both were written to events.jsonl and read by nothing, which is
#     the arrangement staging-drift.ts was written to end.
#
# Everything else a guard hook writes (guard_allow, tracker_record, clears)
# is bookkeeping: it records the ordinary path, nobody asked to be told
# about it, and it stays out of the panel.
WARNING_EVENT_TYPES = {
    "guard_block", "guard_halt",
    "guard_advisory",
    "guard_error",
    "state_drift",
    "review_coverage",
    "staging_drift",
}

# Subsets of WARNING_EVENT_TYPES, carved out so each can be capped separately.
# The set above decides what reaches the panel at all; these decide which
# budget a row is charged to.
ADVISORY_EVENT_TYPES = {"guard_advisory"}
ERROR_EVENT_TYPES = {"guard_error"}
DRIFT_EVENT_TYPES = {"state_drift"}
COVERAGE_EVENT_TYPES = {"review_coverage"}
STAGING_EVENT_TYPES = {"staging_drift"}

# INDEPENDENT CAPS, NOT ONE SHARED BUDGET.
#
# The classes arrive at very different rates. A block or a halt was rare and each
# one individually worth reading; neither is written any more, and historical
# rows are exactly the ones a burst would evict. An advisory is emitted per
# guarded tool call for as long as its cause stands — a project whose fusion.json
# carries a wrong-typed key, or whose root still holds the retired
# fusion-guard.json file, gets one on every single call until it is fixed. Under
# a single shared budget, one un-fixed configuration line is an unbounded stream
# of advisory rows and every older row is off the panel. That is the failure
# guard.ts already refuses to cause with guard_allow, arriving through a
# different door.
#
# So the warning class keeps its full 30 whatever the other classes do, and each
# carve-out gets its own small allowance on top. A burst can no longer evict
# anything; the worst case is a taller panel.
#
# 8 for advisories, deliberately a minority of the panel. What an advisory row
# has to tell the user is "the guard set something aside, and here is what" —
# one row establishes that, and a handful gives the shape of the repetition.
# Eight shows a small burst in full and enough of a long one to recognise the
# pattern, while leaving the panel still legible as a warnings panel at full
# advisory load. The complete record is in events.jsonl, which is append-only
# and where an exhaustive audit belongs; the panel is the 30-row window, and the
# window is the scarce thing.
#
# 8 for fail-opens, and the reason is the same measurement rather than symmetry
# with the number above. A guard_error is NOT one event per fault. Both hooks
# fail open per invocation, so a fault that sits on disk — an unparseable
# config, an unwritable state directory, a bug — emits one row per guarded tool
# call for as long as it sits there. Charged to the warning class it behaves
# exactly like the advisory burst: thirty ordinary tool calls with a broken
# tracker push every older row off the panel, including the historical
# guard_block and guard_halt rows that are now the only ones there will ever
# be. The reverse is why the
# class is not simply capped small and forgotten: a busy session's warnings must
# not push the fail-open row off either, and only a separate budget prevents
# both directions at once. Eight rather than one because a repeating fault
# repeats one detail string, which renderWarnings() collapses to a single
# visible row, so what the budget buys is the VARIETY of errors — two emitters,
# with room for their exception texts to differ.
#
# 8 for stale-state rows. The rate this was sized for is now historical — the
# emitter was removed on 2026-08-15 — and the carve-out is kept because the rows
# it caps are still in the log. hooks/tracker.ts throttled state_drift on the
# drift SIGNATURE, so a divergence that merely persisted across a hundred tool
# calls emitted once, but a divergence that GREW emitted again, and a session
# that committed sixteen times without ever bringing agentstate.yaml current
# produced a row per commit. Those bursts are on disk. Charged to the warning
# class they would push guard_block and guard_halt rows off the panel of anyone
# reading a log from before the removal, which is the advisory burst exactly.
# Eight is enough to show the divergence widening, which is the part a reader
# acts on.
#
# 8 each for review gaps and unstaged records, for the rate the drift budget
# above was sized for and that these two still run at: hooks/tracker.ts
# throttles both on signature, so a miss that persists is one row and a miss
# that changes is another. A session that never runs a review, or that files a
# record per Turn and commits none of them, emits a row per commit; charged to
# the warning class those rows would evict the historical guard_block and
# guard_halt rows exactly as the advisory burst would.
MAX_WARNINGS_RETURNED = 30
MAX_ADVISORIES_RETURNED = 8
MAX_ERRORS_RETURNED = 8
MAX_DRIFTS_RETURNED = 8
MAX_COVERAGE_RETURNED = 8
MAX_STAGING_RETURNED = 8

# The carve-outs, in the order a row is charged against them. A row matching
# none of them is charged to the warning class, which is the default and the
# largest. A fourth class is one entry here plus its own constant above, not a
# fourth branch in _read_warnings().
SUBSET_BUDGETS = (
    (ADVISORY_EVENT_TYPES, MAX_ADVISORIES_RETURNED),
    (ERROR_EVENT_TYPES, MAX_ERRORS_RETURNED),
    (DRIFT_EVENT_TYPES, MAX_DRIFTS_RETURNED),
    (COVERAGE_EVENT_TYPES, MAX_COVERAGE_RETURNED),
    (STAGING_EVENT_TYPES, MAX_STAGING_RETURNED),
)

HTML_PAGE = r"""<!DOCTYPE html>
