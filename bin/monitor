LIVE_MD = os.path.join(BASE_DIR, "orchestrator-live.md")
EVENTS_JSONL = os.path.join(BASE_DIR, "orchestrator-events.jsonl")
STATE_YAML = os.path.join(BASE_DIR, "agentstate.yaml")
GUARD_EVENTS_JSONL = os.path.join(BASE_DIR, ".guard-state", "events.jsonl")

# Path D bus daemon IPC paths. The monitor only reads .daemon-state.json /
# .pending/ / .daemon.log and writes .daemon-cmd*.json via the same
# O_CREAT|O_EXCL collision pattern as bin/fusion-bus. Everything else under
# bus/ is the daemon's territory.
BUS_DIR = os.path.join(BASE_DIR, "bus")
BUS_STATE_JSON = os.path.join(BUS_DIR, ".daemon-state.json")
BUS_PENDING_DIR = os.path.join(BUS_DIR, ".pending")
BUS_LOG = os.path.join(BUS_DIR, ".daemon.log")
BUS_LOG_TAIL_N = 50

# Closed-set validation for POST /api/bus/cmd. Mirrors VALID_CMDS / VALID_MODES
# in bin/fusion-bus-daemon — kept in sync by hand (small surface, low churn).
BUS_VALID_CMDS = ("pause", "resume", "set-mode", "approve", "deny")
BUS_VALID_MODES = ("strict", "observe", "silent")

# Guard events surfaced as sticky warnings on the dashboard. Other guard
# events (guard_allow, tracker_record, clears) are bookkeeping and are
# excluded from the warnings panel.
WARNING_EVENT_TYPES = {
    "churn_warning", "churn_critical",
    "cross_file_warning", "cross_file_critical",
    "guard_block", "guard_halt",
    "gate_filed_consultation",
}
MAX_WARNINGS_RETURNED = 30

