<script>
(function() {
  var POLL_INTERVAL = INTERVAL_PLACEHOLDER * 1000;
  var MAX_EV = MAX_EVENTS_PLACEHOLDER;
  var currentPage = 'dashboard';
  var markedLoaded = false;
  var markedReady = false;

  // Load marked.js from CDN
  var s = document.createElement('script');
  s.src = 'https://cdn.jsdelivr.net/npm/marked@14/marked.min.js';
  s.onload = function() { markedLoaded = true; markedReady = true; rerender(); };
  s.onerror = function() { markedLoaded = true; markedReady = false; };
  document.head.appendChild(s);

  var lastDashboardMd = '';
  var lastEvents = '';
  var lastState = '';

  function showPage(name) {
    currentPage = name;
    document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });
    var target = document.getElementById(name);
    if (target) target.classList.add('active');
    document.querySelectorAll('nav button').forEach(function(b) {
      b.classList.toggle('active', b.getAttribute('data-page') === name);
    });
  }
  window.showPage = showPage;
  // Wire up nav buttons declaratively from data-page attributes
  document.querySelectorAll('nav button[data-page]').forEach(function(b) {
    b.addEventListener('click', function() { showPage(b.getAttribute('data-page')); });
  });

  function renderMarkdown(md) {
    if (markedReady && typeof marked !== 'undefined') {
      return marked.parse(md);
    }
    // Fallback: wrap in pre
    return '<pre>' + escapeHtml(md) + '</pre>';
  }

  function escapeHtml(t) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(t));
    return d.innerHTML;
  }

  // Render a UTC ISO timestamp in the browser's local timezone. Events are
  // persisted in UTC (canonical) but displayed local so they line up with
  // the header "Updated" clock the user sees.
  function formatLocalTime(iso, mode) {
    if (!iso) return '';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    var hh = String(d.getHours()).padStart(2, '0');
    var mm = String(d.getMinutes()).padStart(2, '0');
    var ss = String(d.getSeconds()).padStart(2, '0');
    if (mode === 'date') {
      var yyyy = d.getFullYear();
      var mo = String(d.getMonth() + 1).padStart(2, '0');
      var dd = String(d.getDate()).padStart(2, '0');
      return yyyy + '-' + mo + '-' + dd + ' ' + hh + ':' + mm;
    }
    return hh + ':' + mm + ':' + ss;
  }

  // Compute a stable dismissal key for a warning. Same (event,file,detail)
  // means "the same warning" — dismissing once suppresses recurrence even
  // if the warning re-emits during the session.
  function warningKey(w) {
    return 'fusion-mon-dismissed:' + (w.event || '') + ':' +
           (w.file || '') + ':' + (w.detail || '');
  }

  function renderWarnings(warnings) {
    var section = document.getElementById('warnings-section');
    var panel = document.getElementById('warnings-panel');
    if (!warnings || warnings.length === 0) {
      section.style.display = 'none';
      panel.innerHTML = '';
      return;
    }
    // Latest-first; collapse duplicate keys keeping the most recent.
    var seen = {};
    var visible = [];
    for (var i = warnings.length - 1; i >= 0; i--) {
      var w = warnings[i];
      var key = warningKey(w);
      if (seen[key]) continue;
      seen[key] = true;
      if (localStorage.getItem(key)) continue;
      visible.push(w);
    }
    if (visible.length === 0) {
      section.style.display = 'none';
      panel.innerHTML = '';
      return;
    }
    var html = '';
    for (var j = 0; j < visible.length; j++) {
      var w = visible[j];
      var levelClass = 'warning';
      var levelLabel = 'Warning';
      if (w.event === 'churn_critical' || w.event === 'cross_file_critical') {
        levelClass = 'critical'; levelLabel = 'Critical';
      } else if (w.event === 'cross_file_warning') {
        levelClass = 'warning'; levelLabel = 'Cross-file';
      } else if (w.event === 'guard_block') { levelClass = 'block'; levelLabel = 'Blocked'; }
      else if (w.event === 'guard_halt')  { levelClass = 'halt'; levelLabel = 'Halt'; }
      var ts = formatLocalTime(w.ts || '', 'date');
      var key = warningKey(w);
      html += '<div class="warning-row ' + levelClass + '">' +
        '<span class="warning-level">' + escapeHtml(levelLabel) + '</span>' +
        '<span class="warning-detail">' + escapeHtml(w.detail || w.event) + '</span>' +
        '<span class="warning-ts">' + escapeHtml(ts) + '</span>' +
        '<button class="warning-dismiss" data-key="' + escapeHtml(key) + '">dismiss</button>' +
        '</div>';
    }
    panel.innerHTML = html;
    section.style.display = 'block';
    var btns = panel.querySelectorAll('.warning-dismiss');
    for (var k = 0; k < btns.length; k++) {
      btns[k].addEventListener('click', function(ev) {
        var btn = ev.currentTarget;
        try { localStorage.setItem(btn.getAttribute('data-key'), '1'); } catch (e) {}
        btn.parentElement.parentNode.removeChild(btn.parentElement);
        if (panel.children.length === 0) section.style.display = 'none';
      });
    }
  }

  // Dismiss All — wired once on load; sets dismissal keys for every visible
  // warning currently in the panel and clears the section.
  document.getElementById('dismiss-all-btn').addEventListener('click', function() {
    var section = document.getElementById('warnings-section');
    var panel = document.getElementById('warnings-panel');
    var btns = panel.querySelectorAll('.warning-dismiss');
    for (var k = 0; k < btns.length; k++) {
      try { localStorage.setItem(btns[k].getAttribute('data-key'), '1'); } catch (e) {}
    }
    panel.innerHTML = '';
    section.style.display = 'none';
  });

  function highlightYaml(text) {
    var lines = text.split('\n');
    var result = [];
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      var escaped = escapeHtml(line);
      // Comments
      if (/^\s*#/.test(line)) {
        result.push('<span class="yaml-comment">' + escaped + '</span>');
        continue;
      }
      // Key-value lines
      escaped = escaped.replace(/^(\s*)(- )/, '$1<span class="yaml-list-marker">- </span>');
      escaped = escaped.replace(/^(\s*(?:<span[^>]*>- <\/span>)?)([A-Za-z_][A-Za-z0-9_.-]*)(:\s*)/, function(m, pre, key, sep) {
        return pre + '<span class="yaml-key">' + key + '</span>' + sep;
      });
      // Inline comment at end
      escaped = escaped.replace(/(#.*)$/, '<span class="yaml-comment">$1</span>');
      // Strings in quotes
      escaped = escaped.replace(/"([^"]*)"/, '"<span class="yaml-string">$1</span>"');
      escaped = escaped.replace(/'([^']*)'/, '\'<span class="yaml-string">$1</span>\'');
      // Booleans and null
      escaped = escaped.replace(/:\s+(true|false)(\s|$)/, function(m, val, after) {
        return ': <span class="yaml-bool">' + val + '</span>' + after;
      });
      escaped = escaped.replace(/:\s+(null|~)(\s|$)/, function(m, val, after) {
        return ': <span class="yaml-null">' + val + '</span>' + after;
      });
      // Numbers
      escaped = escaped.replace(/:\s+(\d+\.?\d*)(\s|$)/, function(m, val, after) {
        return ': <span class="yaml-number">' + val + '</span>' + after;
      });
      result.push(escaped);
    }
    return result.join('\n');
  }

  function formatEvent(ev) {
    var timePart = formatLocalTime(ev.ts || '');
    var evType = ev.event || 'unknown';
    var detail = ev.detail || '';
    if (ev.task) detail = '[' + ev.task + '] ' + detail;
    // Events without an explicit agent field are by definition orchestrator-
    // emitted (session_start, gate_hit, commit, turn_*, reconciliation, …).
    // Default rather than render an unlabeled row, so every event displays
    // <agent>: <detail> uniformly.
    detail = (ev.agent || 'orchestrator') + ': ' + detail;

    return '<div class="event-row">' +
      '<span class="event-ts">' + escapeHtml(timePart) + '</span>' +
      '<span class="event-type ' + escapeHtml(evType) + '">' + escapeHtml(evType) + '</span>' +
      '<span class="event-detail" title="' + escapeHtml(detail) + '">' + escapeHtml(detail) + '</span>' +
      '</div>';
  }

  function updateStatus(hasFile, age, mode) {
    var dot = document.getElementById('status-dot');
    var text = document.getElementById('status-text');
    if (!hasFile) {
      dot.className = 'status-dot missing';
      text.textContent = 'No dashboard file found';
    } else if (mode === 'gate') {
      dot.className = 'status-dot gate';
      text.textContent = '⏸ Paused at gate — waiting on user';
    } else if (mode === 'setup') {
      dot.className = 'status-dot setup';
      text.textContent = 'Setting up…';
    } else if (mode === 'done') {
      dot.className = 'status-dot done';
      text.textContent = 'Session complete';
    } else if (mode === 'error') {
      dot.className = 'status-dot error';
      text.textContent = 'Error';
    } else if (age !== undefined && age > 300) {
      dot.className = 'status-dot stale';
      text.textContent = 'Dashboard stale (' + Math.round(age/60) + 'm ago) — agent may be stuck';
    } else {
      dot.className = 'status-dot live';
      text.textContent = 'Live';
    }
    document.getElementById('last-update').textContent = 'Updated: ' + new Date().toLocaleTimeString();
  }

  function rerender() {
    if (lastDashboardMd) {
      document.getElementById('dashboard-content').innerHTML = renderMarkdown(lastDashboardMd);
    }
  }

  function pollDashboard() {
    fetch('/api/dashboard')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        updateStatus(data.exists, data.age, data.mode);
        renderWarnings(data.warnings);
        if (data.dashboard && data.dashboard !== lastDashboardMd) {
          lastDashboardMd = data.dashboard;
          document.getElementById('dashboard-content').innerHTML = renderMarkdown(data.dashboard);
        }
        if (!data.exists) {
          document.getElementById('dashboard-content').innerHTML =
            '<div class="no-file">Waiting for orchestrator-live.md...<span>File will appear when the orchestrator starts</span></div>';
        }
        var evHtml = '';
        var evContent = document.getElementById('events-content');
        if (data.events && data.events.length > 0) {
          var evStr = JSON.stringify(data.events);
          if (evStr !== lastEvents) {
            lastEvents = evStr;
            for (var i = data.events.length - 1; i >= 0; i--) {
              evHtml += formatEvent(data.events[i]);
            }
            evContent.innerHTML = evHtml;
          }
        } else if (lastEvents !== '__empty__') {
          lastEvents = '__empty__';
          evContent.innerHTML =
            '<div class="no-file">No events yet<span>Events appear here as the orchestrator runs</span></div>';
        }
      })
      .catch(function() {});
  }

  function pollState() {
    fetch('/api/state')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.exists) {
          var content = data.content || '';
          if (content !== lastState) {
            lastState = content;
            document.getElementById('state-content').innerHTML =
              '<pre class="yaml-content">' + highlightYaml(content) + '</pre>';
          }
        } else {
          if (lastState !== '__missing__') {
            lastState = '__missing__';
            document.getElementById('state-content').innerHTML =
              '<div class="no-file">No active session<span>agentstate.yaml does not exist (created when orchestrator starts, deleted on clean exit)</span></div>';
          }
        }
      })
      .catch(function() {});
  }

  // ------------------------------------------------------------------
  // Bus traffic panel (Path D)
  // ------------------------------------------------------------------

  var lastBusKey = '';

  // Render a short relative-age string ("3m ago", "12s ago", "—" when
  // missing). Used for queued_at, last_route_at, and recent_routes rows.
  function relativeAge(iso) {
    if (!iso) return '—';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    var s = Math.floor((Date.now() - d.getTime()) / 1000);
    if (s < 0) s = 0;
    if (s < 60) return s + 's ago';
    if (s < 3600) return Math.floor(s / 60) + 'm ago';
    if (s < 86400) return Math.floor(s / 3600) + 'h ago';
    return Math.floor(s / 86400) + 'd ago';
  }

  function shortId(id) {
    if (!id) return '';
    if (id.length <= 24) return id;
    return id.substring(0, 24) + '…';
  }

  function trim60(s) {
    if (!s) return '';
    if (s.length <= 60) return s;
    return s.substring(0, 57) + '…';
  }

  function setBusCmdStatus(text, color) {
    var el = document.getElementById('bus-cmd-status');
    el.textContent = text || '';
    el.style.color = color || 'var(--fg3)';
  }

  function postBusCmd(payload, onDone) {
    setBusCmdStatus('…', 'var(--fg3)');
    fetch('/api/bus/cmd', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function(r) {
        if (r.status === 204) {
          setBusCmdStatus('filed ' + payload.cmd, 'var(--green)');
          // Immediate re-poll so the UI reflects the daemon's reaction
          // ASAP instead of waiting for the next periodic tick.
          pollBus();
          if (onDone) onDone(true);
        } else {
          return r.text().then(function(txt) {
            setBusCmdStatus('error: ' + r.status + ' ' + txt, 'var(--red)');
            if (onDone) onDone(false);
          });
        }
      })
      .catch(function(e) {
        setBusCmdStatus('network error', 'var(--red)');
        if (onDone) onDone(false);
      });
  }

  function renderBusHeader(state, daemonPresent) {
    var statusBadge = document.getElementById('bus-status-badge');
    var modeBadge = document.getElementById('bus-mode-badge');
    var pendingCount = document.getElementById('bus-pending-count');
    var lastRoute = document.getElementById('bus-last-route');

    if (!daemonPresent || !state) {
      statusBadge.className = 'bus-badge down';
      statusBadge.textContent = 'daemon down';
      modeBadge.style.display = 'none';
      pendingCount.textContent = '0';
      lastRoute.textContent = '—';
      return;
    }
    var running = state.running === true;
    statusBadge.className = 'bus-badge ' + (running ? 'running' : 'paused');
    statusBadge.textContent = running ? 'running' : 'paused';
    var mode = state.mode || 'strict';
    modeBadge.style.display = '';
    modeBadge.className = 'bus-badge mode-' + mode;
    modeBadge.textContent = mode;
    pendingCount.textContent = String(state.pending_count != null ? state.pending_count : 0);
    lastRoute.textContent = relativeAge(state.last_route_at);
  }

  function renderBusControls(state, daemonPresent) {
    var toggleBtn = document.getElementById('bus-toggle-running');
    var modeSel = document.getElementById('bus-mode-select');
    if (!daemonPresent || !state) {
      toggleBtn.disabled = true;
      toggleBtn.textContent = 'Pause';
      modeSel.disabled = true;
      return;
    }
    toggleBtn.disabled = false;
    modeSel.disabled = false;
    toggleBtn.textContent = state.running ? 'Pause' : 'Resume';
    toggleBtn.dataset.action = state.running ? 'pause' : 'resume';
    // Only set value if the user is not actively interacting; otherwise
    // a periodic poll would clobber their in-progress selection. We use a
    // simple "focused" check.
    if (document.activeElement !== modeSel) {
      modeSel.value = state.mode || 'strict';
    }
  }

  function renderPendingTable(pending, daemonPresent) {
    var host = document.getElementById('bus-pending');
    if (!pending || pending.length === 0) {
      host.innerHTML = '<div class="bus-empty">No pending messages.</div>';
      return;
    }
    var html = '<table class="bus-table"><thead><tr>' +
      '<th>msg_id</th><th>target</th><th>from</th><th>re</th>' +
      '<th>queued</th><th>actions</th></tr></thead><tbody>';
    for (var i = 0; i < pending.length; i++) {
      var e = pending[i];
      var mid = e.msg_id || '';
      var disabled = daemonPresent ? '' : ' disabled';
      html += '<tr data-msgid="' + escapeHtml(mid) + '">' +
        '<td class="bus-msgid" title="' + escapeHtml(mid) + '">' + escapeHtml(shortId(mid)) + '</td>' +
        '<td class="bus-target">' + escapeHtml(e.target_agent || '') + '</td>' +
        '<td class="bus-from">' + escapeHtml(e.from || '') + '</td>' +
        '<td class="bus-re" title="' + escapeHtml(e.re || '') + '">' + escapeHtml(trim60(e.re || '')) + '</td>' +
        '<td class="bus-age">' + escapeHtml(relativeAge(e.queued_at)) + '</td>' +
        '<td class="bus-action-cell">' +
          '<button class="bus-btn approve" data-action="approve"' + disabled + '>Approve</button>' +
          '<button class="bus-btn deny"    data-action="deny-open"' + disabled + '>Deny</button>' +
          '<div class="bus-deny-form">' +
            '<textarea placeholder="Reason (optional)"></textarea>' +
            '<button class="bus-btn primary" data-action="deny-submit"' + disabled + '>Submit</button>' +
            '<button class="bus-btn" data-action="deny-cancel"' + disabled + '>Cancel</button>' +
          '</div>' +
        '</td>' +
        '</tr>';
    }
    html += '</tbody></table>';
    host.innerHTML = html;

    // Wire up per-row buttons.
    host.querySelectorAll('tr[data-msgid]').forEach(function(row) {
      var mid = row.getAttribute('data-msgid');
      var denyForm = row.querySelector('.bus-deny-form');
      row.querySelectorAll('button[data-action]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var act = btn.getAttribute('data-action');
          if (act === 'approve') {
            postBusCmd({ cmd: 'approve', arg: mid });
          } else if (act === 'deny-open') {
            denyForm.classList.add('open');
          } else if (act === 'deny-cancel') {
            denyForm.classList.remove('open');
          } else if (act === 'deny-submit') {
            var ta = denyForm.querySelector('textarea');
            var reason = (ta && ta.value || '').trim();
            postBusCmd({ cmd: 'deny', arg: mid, reason: reason });
            denyForm.classList.remove('open');
          }
        });
      });
    });
  }

  function renderRecentRoutes(routes) {
    var host = document.getElementById('bus-recent');
    if (!routes || routes.length === 0) {
      host.innerHTML = '<div class="bus-empty">No routes recorded.</div>';
      return;
    }
    var take = routes.slice(0, 10);
    var html = '<table class="bus-table"><thead><tr>' +
      '<th>when</th><th>action</th><th>target</th><th>msg_id</th><th>note</th>' +
      '</tr></thead><tbody>';
    for (var i = 0; i < take.length; i++) {
      var r = take[i];
      var note = r.reason || r.note || r.approved_by || r.denied_by || '';
      html += '<tr>' +
        '<td class="bus-age">' + escapeHtml(relativeAge(r.at)) + '</td>' +
        '<td class="bus-action"><span class="bus-route-action ' + escapeHtml(r.action || '') + '">' +
          escapeHtml(r.action || '') + '</span></td>' +
        '<td class="bus-target">' + escapeHtml(r.target_agent || '') + '</td>' +
        '<td class="bus-msgid" title="' + escapeHtml(r.msg_id || '') + '">' +
          escapeHtml(shortId(r.msg_id || '')) + '</td>' +
        '<td class="bus-from">' + escapeHtml(note) + '</td>' +
        '</tr>';
    }
    html += '</tbody></table>';
    host.innerHTML = html;
  }

  function renderBusLog(lines) {
    var host = document.getElementById('bus-log');
    if (!lines || lines.length === 0) {
      host.innerHTML = '<span class="log-empty">No log entries.</span>';
      return;
    }
    host.textContent = lines.join('\n');
    // Auto-scroll to the bottom (newest line) when user is near the bottom.
    var nearBottom = (host.scrollTop + host.clientHeight) >= (host.scrollHeight - 40);
    if (nearBottom) host.scrollTop = host.scrollHeight;
  }

  function renderBusFooter(user) {
    var el = document.getElementById('bus-footer');
    el.textContent = 'Localhost only. $USER: ' + (user || 'unknown');
  }

  function pollBus() {
    fetch('/api/bus')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var daemonPresent = data && data.daemon_present !== false && !!data.state;
        renderBusHeader(data.state, daemonPresent);
        renderBusControls(data.state, daemonPresent);
        // Pending list:
        var pending = (data && data.pending) || [];
        // Identity check (avoid clobbering an in-flight deny textarea unless
        // the actual data changed).
        var key = JSON.stringify({
          d: daemonPresent,
          m: data.state ? data.state.mode : null,
          r: data.state ? data.state.running : null,
          lr: data.state ? data.state.last_route_at : null,
          pc: data.state ? data.state.pending_count : null,
          p: pending.map(function(p) { return p.msg_id; }),
          rr: data.state ? (data.state.recent_routes || []).map(function(r) {
            return (r.msg_id || '') + ':' + (r.action || '') + ':' + (r.at || '');
          }) : [],
          ll: (data && data.log_tail) ? data.log_tail.length : 0
        });
        if (key !== lastBusKey) {
          lastBusKey = key;
          renderPendingTable(pending, daemonPresent);
          renderRecentRoutes(data.state ? (data.state.recent_routes || []) : []);
        }
        renderBusLog((data && data.log_tail) || []);
        renderBusFooter(data && data.user);
      })
      .catch(function() {
        // On fetch failure, render as daemon-down but don't clobber the
        // footer or log (transient network blip).
        renderBusHeader(null, false);
        renderBusControls(null, false);
      });
  }

  // Wire up the Pause/Resume button and Mode dropdown once on load.
  document.getElementById('bus-toggle-running').addEventListener('click', function() {
    var btn = this;
    var action = btn.dataset.action || 'pause';
    postBusCmd({ cmd: action });
  });
  document.getElementById('bus-mode-select').addEventListener('change', function() {
    postBusCmd({ cmd: 'set-mode', arg: this.value });
  });

  function poll() {
    pollDashboard();
    pollState();
    pollBus();
  }

  poll();
  setInterval(poll, POLL_INTERVAL);
})();
</script>
</body>
</html>""".replace('MONITOR_NAME_PLACEHOLDER', MONITOR_NAME).replace('INTERVAL_PLACEHOLDER', str(INTERVAL)).replace('MAX_EVENTS_PLACEHOLDER', str(MAX_EVENTS))


def _now_utc_z():
    """RFC-3339 UTC timestamp with Z suffix — matches fusion-bus-daemon."""
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _atomic_write_json(path, payload):
    """Temp-write-and-rename so readers (the daemon) never see a partial file."""
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    tmp = path + ".tmp." + str(os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, indent=2, sort_keys=False)
        fh.write("\n")
    os.rename(tmp, path)


def _write_bus_cmd(payload):
    """Write `bus/.daemon-cmd.json` if free, else `.daemon-cmd.<seq>.json`.

    Mirrors the collision pattern in `bin/fusion-bus._write_cmd_file`: uses
    `os.open` with `O_CREAT|O_EXCL` to atomically reserve the name, then
    atomic-renames the real payload over the placeholder so the daemon never
    polls a half-written file.
    """
    os.makedirs(BUS_DIR, exist_ok=True)
    seq = 0
    while True:
        name = ".daemon-cmd.json" if seq == 0 else f".daemon-cmd.{seq}.json"
        target = os.path.join(BUS_DIR, name)
        try:
            fd = os.open(target, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except FileExistsError:
            seq += 1
            continue
        os.close(fd)
        _atomic_write_json(target, payload)
        return target


def _pid_alive(pid):
    """Return True if `pid` exists. POSIX-canonical existence check."""
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        # PID exists but owned by another user — still alive for our purpose.
        return True
    except OSError:
        return False


def _read_bus_state():
    """Read `.daemon-state.json` and return (state, present, alive).

    `present` is True when the state file exists and parses. `alive` is True
    when `.daemon.pid` exists, parses, and its PID is alive — that's the
    distinction between "paused" (running:false, alive) and "daemon down"
    (running:false because the shutdown handler wrote it, pid file deleted).
    """
    try:
        with open(BUS_STATE_JSON, "r", encoding="utf-8") as fh:
            state = json.load(fh)
    except FileNotFoundError:
        return None, False, False
    except (OSError, json.JSONDecodeError):
        return None, False, False
    # Check pid file for liveness — same convention used by fusion-bus-daemon.
    pid_path = os.path.join(BUS_DIR, ".daemon.pid")
    alive = False
    try:
        with open(pid_path, "r", encoding="utf-8") as fh:
            pid_data = json.load(fh)
        alive = _pid_alive(pid_data.get("pid"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        alive = False
    return state, True, alive


def _read_bus_pending():
    """List every `bus/.pending/*.json` entry, sorted by `queued_at`.

    Silently skips unparseable files (the daemon's atomic_write_json briefly
    leaves a `.tmp.<pid>` sibling; that's harmless).
    """
    if not os.path.isdir(BUS_PENDING_DIR):
        return []
    rows = []
    for entry in os.listdir(BUS_PENDING_DIR):
        if not entry.endswith(".json"):
            continue
        path = os.path.join(BUS_PENDING_DIR, entry)
        try:
            with open(path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(data, dict):
            rows.append(data)
    rows.sort(key=lambda r: (str(r.get("queued_at", "")), str(r.get("msg_id", ""))))
    return rows


def _tail_bus_log(n=BUS_LOG_TAIL_N):
    """Return the last `n` lines of `bus/.daemon.log` as a list (no trailing newlines).

    Reads the whole file (the daemon's log is append-only and small in
    practice — kilobytes, not megabytes). If we ever need a true streaming
    tail, swap in a seek-from-end implementation.
    """
    try:
        with open(BUS_LOG, "r", encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except FileNotFoundError:
        return []
    except OSError:
        return []
    return lines[-n:] if n > 0 else lines


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        # Suppress default request logging
        pass

    def _headers(self, content_type="application/json", status=200):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()

    def _read_file(self, path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return f.read(), True
        except FileNotFoundError:
            return "", False
        except Exception as e:
            return f"Error reading file: {e}", False

    def _file_age(self, path):
        try:
            import time
            return time.time() - os.path.getmtime(path)
        except Exception:
            return None

    # Map the orchestrator's most recent event to a UI mode. Markdown markers
    # in orchestrator-live.md are inconsistent across sessions ("## Current"
    # vs "## Status", with-marker vs free text), but the events log is
    # structured and append-only — the most recent event reliably tells us
    # what the orchestrator is doing right now. Any event not in this map
    # leaves mode unset and falls back to the age-based logic.
    LAST_EVENT_TO_MODE = {
        "session_start": "setup",
        "gate_hit": "gate",
        "session_end": "done",
        "task_error": "error",
        "bugfix_failure": "error",
    }

    def _parse_mode(self, events):
        if not events:
            return None
        last = events[-1].get("event") if isinstance(events[-1], dict) else None
        return self.LAST_EVENT_TO_MODE.get(last)

    def _read_warnings(self):
        """Read .guard-state/events.jsonl and return the most recent
        warning-class events. Filters out noise (guard_allow, tracker_record).
        Returns up to MAX_WARNINGS_RETURNED events, newest last."""
        content, exists = self._read_file(GUARD_EVENTS_JSONL)
        if not exists or not content.strip():
            return []
        warnings = []
        for line in content.strip().split("\n"):
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("event") in WARNING_EVENT_TYPES:
                warnings.append(ev)
        return warnings[-MAX_WARNINGS_RETURNED:]

    def do_GET(self):
        if self.path == "/":
            self._headers("text/html")
            self.wfile.write(HTML_PAGE.encode("utf-8"))

        elif self.path == "/api/dashboard":
            self._headers()
            content, exists = self._read_file(LIVE_MD)
            age = self._file_age(LIVE_MD)

            events = []
            ev_content, ev_exists = self._read_file(EVENTS_JSONL)
            if ev_exists and ev_content.strip():
                lines = ev_content.strip().split("\n")
                # Take last N events
                for line in lines[-MAX_EVENTS:]:
                    line = line.strip()
                    if line:
                        try:
                            events.append(json.loads(line))
                        except json.JSONDecodeError:
                            pass

            resp = json.dumps({
                "dashboard": content,
                "exists": exists,
                "age": age,
                "mode": self._parse_mode(events),
                "events": events,
                "warnings": self._read_warnings(),
            })
            self.wfile.write(resp.encode("utf-8"))

        elif self.path == "/api/state":
            self._headers()
            content, exists = self._read_file(STATE_YAML)
            resp = json.dumps({
                "content": content,
                "exists": exists,
            })
            self.wfile.write(resp.encode("utf-8"))

        elif self.path == "/api/bus":
            self._headers()
            state, present, alive = _read_bus_state()
            # `daemon_present` is the frontend's truth-source: True only when
            # the state file is readable AND the PID it points at is alive.
            # That maps "stopped daemon" (state file present, but process
            # dead — last shutdown wrote running:false then exited) to the
            # same UI as "daemon never started", per the spec's "daemon
            # down" requirement.
            daemon_present = present and alive
            pending = _read_bus_pending() if daemon_present else []
            log_tail = _tail_bus_log() if (present or alive) else []
            resp = {
                "daemon_present": daemon_present,
                "state": state if daemon_present else None,
                "pending": pending,
                "log_tail": log_tail,
                "user": os.environ.get("USER", "unknown"),
            }
            self.wfile.write(json.dumps(resp).encode("utf-8"))

        else:
            self._headers(status=404)
            self.wfile.write(b'{"error": "not found"}')

    def do_POST(self):
        if self.path == "/api/bus/cmd":
            return self._handle_bus_cmd()
        self._headers(status=404)
        self.wfile.write(b'{"error": "not found"}')

    def _handle_bus_cmd(self):
        """Validate body, refuse if daemon not running, write a cmd file.

        Closed-set validation against BUS_VALID_CMDS / BUS_VALID_MODES; writes
        via the same O_CREAT|O_EXCL collision pattern as `bin/fusion-bus`.
        Response codes per the plan: 204 ok, 400 bad request, 503 daemon not
        running.
        """
        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0 or length > 65536:
            return self._json_error(400, "missing or oversized body")
        try:
            raw = self.rfile.read(length).decode("utf-8")
            data = json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError):
            return self._json_error(400, "malformed JSON body")
        if not isinstance(data, dict):
            return self._json_error(400, "body must be a JSON object")

        cmd = (data.get("cmd") or "").strip()
        if cmd not in BUS_VALID_CMDS:
            return self._json_error(400, f"unknown cmd: {cmd!r}")

        arg = data.get("arg")
        reason = data.get("reason")

        # Per-cmd shallow validation.
        if cmd == "set-mode":
            if not isinstance(arg, str) or arg not in BUS_VALID_MODES:
                return self._json_error(400, f"invalid mode: {arg!r}")
        elif cmd in ("approve", "deny"):
            if not isinstance(arg, str) or not arg.strip():
                return self._json_error(400, f"{cmd} requires arg (msg-id)")
            arg = arg.strip()
        # pause / resume take no arg.

        # Daemon must be alive (process exists). A "paused" daemon (state
        # `running: false`, PID still alive) keeps draining its command queue,
        # so we must accept commands then — otherwise the dashboard's Resume
        # button could never reach the daemon. 503 only when the daemon
        # process is genuinely dead.
        state, present, alive = _read_bus_state()
        if not present or not alive:
            return self._json_error(
                503, "daemon not running — start it with `fusion-bus daemon start`"
            )

        payload = {
            "cmd": cmd,
            "arg": arg if arg is not None else None,
            "reason": reason if reason is not None else None,
            "filed_by": os.environ.get("USER", "unknown"),
            "filed_at": _now_utc_z(),
        }
        try:
            _write_bus_cmd(payload)
        except OSError as exc:
            return self._json_error(500, f"failed to write cmd file: {exc}")

        # 204 No Content — body must be empty.
        self.send_response(204)
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()

    def _json_error(self, status, message):
        self._headers(status=status)
        self.wfile.write(json.dumps({"error": message}).encode("utf-8"))


import socket, signal, subprocess

# Kill any previous monitor on this port
try:
    out = subprocess.check_output(["lsof", "-ti", f":{PORT}"], stderr=subprocess.DEVNULL).decode().strip()
    for pid in out.split("\n"):
        pid = pid.strip()
        if pid and int(pid) != os.getpid():
            os.kill(int(pid), signal.SIGTERM)
            import time; time.sleep(0.3)
except (subprocess.CalledProcessError, ValueError, ProcessLookupError):
    pass

class ReuseServer(http.server.HTTPServer):
    allow_reuse_address = True
    def server_bind(self):
        self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except (AttributeError, OSError):
            pass
        super().server_bind()

server = ReuseServer(("127.0.0.1", PORT), Handler)
print(f"\n  {MONITOR_NAME} — Orchestrator Monitor")
print(f"  http://localhost:{PORT}")
print(f"  Watching: {BASE_DIR}")
print(f"  Polling every {INTERVAL}s | Showing last {MAX_EVENTS} events")
print(f"  Press Ctrl+C to stop\n")

try:
    server.serve_forever()
except KeyboardInterrupt:
    print("\n  Stopped.")
    server.server_close()
PYTHON_SCRIPT

python3 "$TMPFILE" "$MONITOR_NAME" "$PORT" "$MAX_EVENTS" "$INTERVAL" "$WORKBENCH_DIR" &
SERVER_PID=$!

trap 'kill $SERVER_PID 2>/dev/null; wait $SERVER_PID 2>/dev/null; exit 0' INT TERM

sleep 0.5
open "http://localhost:${PORT}"
wait $SERVER_PID
