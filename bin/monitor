<script>
(function() {
  var POLL_INTERVAL = INTERVAL_PLACEHOLDER * 1000;
  var MAX_EV = MAX_EVENTS_PLACEHOLDER;
  var currentPage = 'dashboard';
  var markedLoaded = false;
  var markedReady = false;

  // Load marked.js from CDN
  var s = document.createElement('script');
  s.src = 'https://cdn.jsdelivr.net/npm/marked@14/marked.min.js';
  s.onload = function() { markedLoaded = true; markedReady = true; rerender(); };
  s.onerror = function() { markedLoaded = true; markedReady = false; };
  document.head.appendChild(s);

  var lastDashboardMd = '';
  var lastEvents = '';
  var lastState = '';

  function showPage(name) {
    currentPage = name;
    document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });
    var target = document.getElementById(name);
    if (target) target.classList.add('active');
    document.querySelectorAll('nav button').forEach(function(b) {
      b.classList.toggle('active', b.getAttribute('data-page') === name);
    });
  }
  window.showPage = showPage;
  // Wire up nav buttons declaratively from data-page attributes
  document.querySelectorAll('nav button[data-page]').forEach(function(b) {
    b.addEventListener('click', function() { showPage(b.getAttribute('data-page')); });
  });

  // When the dashboard's first counter line still has uninitialised Turn /
  // Task slots (`--/5 | Tasks: --/--`) the visual reads as "nothing
  // happening" even though the Session line shows real activity (Phase 0 /
  // Phase 1 / Setup gate). Until Turn 1 begins, surface the parsed Phase
  // from the `Session:` line so the user sees what stage the orchestrator
  // is in rather than a row of dashes. Pure client-side overlay — the file
  // format the orchestrator writes is untouched.
  function decorateDashboardMd(md) {
    if (!md || md.indexOf('--/--') === -1) return md;
    // Pull Phase from the Session line if present, e.g.
    //   "Session: Phase 0 form-decision gate" → "Phase 0"
    //   "Session: Setup"                       → "Setup"
    var phase = '';
    var sessMatch = md.match(/^Session:\s*(.+)$/m);
    if (sessMatch) {
      var sess = sessMatch[1].trim();
      var phaseMatch = sess.match(/^(Phase\s+\d+|Setup|Pre-Turn)/i);
      phase = phaseMatch ? phaseMatch[1] : sess.split(/\s+/).slice(0, 2).join(' ');
    }
    if (!phase) phase = 'Setup / Pre-Turn';
    // Replace the first `Turn: --/N` (or `--/--`) line with a Phase prefix.
    // Match conservatively so we only touch counter lines, not random text.
    return md.replace(/^(Turn:\s*[^|\n]*--\/[^|\n]*\|[^\n]*)$/m,
      'Phase: ' + phase + ' · $1');
  }

  function renderMarkdown(md) {
    var prepared = decorateDashboardMd(md);
    if (markedReady && typeof marked !== 'undefined') {
      return marked.parse(prepared);
    }
    // Fallback: wrap in pre
    return '<pre>' + escapeHtml(prepared) + '</pre>';
  }

  function escapeHtml(t) {
    var d = document.createElement('div');
    d.appendChild(document.createTextNode(t));
    return d.innerHTML;
  }

  // Render a UTC ISO timestamp in the browser's local timezone. Events are
  // persisted in UTC (canonical) but displayed local so they line up with
  // the header "Updated" clock the user sees. orchestrator-events.jsonl
  // timestamps lack a 'Z' designator (written by `date -u +…`); route them
  // through parseUTCTs so naked timestamps are interpreted as UTC instead of
  // local — otherwise getHours()/getMinutes() would be wrong by the user's
  // TZ offset. parseUTCTs is function-declaration-hoisted from below.
  function formatLocalTime(iso, mode) {
    if (!iso) return '';
    var d = new Date(parseUTCTs(iso));
    if (isNaN(d.getTime())) return iso;
    var hh = String(d.getHours()).padStart(2, '0');
    var mm = String(d.getMinutes()).padStart(2, '0');
    var ss = String(d.getSeconds()).padStart(2, '0');
    if (mode === 'date') {
      var yyyy = d.getFullYear();
      var mo = String(d.getMonth() + 1).padStart(2, '0');
      var dd = String(d.getDate()).padStart(2, '0');
      return yyyy + '-' + mo + '-' + dd + ' ' + hh + ':' + mm;
    }
    return hh + ':' + mm + ':' + ss;
  }

  // Compute a stable dismissal key for a warning. Same (event,file,detail)
  // means "the same warning" — dismissing once suppresses recurrence even
  // if the warning re-emits during the session.
  function warningKey(w) {
    return 'fusion-mon-dismissed:' + (w.event || '') + ':' +
           (w.file || '') + ':' + (w.detail || '');
  }

  function renderWarnings(warnings) {
    var section = document.getElementById('warnings-section');
    var panel = document.getElementById('warnings-panel');
    if (!warnings || warnings.length === 0) {
      section.style.display = 'none';
      panel.innerHTML = '';
      return;
    }
    // Latest-first; collapse duplicate keys keeping the most recent.
    var seen = {};
    var visible = [];
    for (var i = warnings.length - 1; i >= 0; i--) {
      var w = warnings[i];
      var key = warningKey(w);
      if (seen[key]) continue;
      seen[key] = true;
      // Guarded like the writes below: a browser that refuses storage (a
      // private window, blocked site data) used to throw here, the render
      // died before the first row, and the catch at the end of pollDashboard
      // swallowed it, so the panel never appeared (issue 260812-0253). An
      // unreadable store means nothing was dismissed.
      var dismissed = false;
      try { dismissed = !!localStorage.getItem(key); } catch (e) {}
      if (dismissed) continue;
      visible.push(w);
    }
    if (visible.length === 0) {
      section.style.display = 'none';
      panel.innerHTML = '';
      return;
    }
    var html = '';
    // Dismissal keys travel as JS properties, never through the markup. A key
    // is built from the event's own text, and warning text carries quotes
    // routinely: a JSON fragment, a SyntaxError, a quoted path. Interpolated
    // into an attribute one truncated there, so localStorage stored a prefix,
    // the next render recomputed the whole key, matched nothing, and the row
    // came back. Dismissal silently never stuck (issue 260817-1217).
    var keys = [];
    for (var j = 0; j < visible.length; j++) {
      var w = visible[j];
      var levelClass = 'warning';
      var levelLabel = 'Warning';
      if (w.event === 'guard_block') { levelClass = 'block'; levelLabel = 'Blocked'; }
      else if (w.event === 'guard_halt')  { levelClass = 'halt'; levelLabel = 'Halt'; }
      // An advisory is not a warning: an override flag the user set let a
      // normally-denied write through, and this row is the receipt. The
      // default level would render it amber and label it "Warning", which
      // says something went wrong. Nothing did.
      else if (w.event === 'guard_advisory') { levelClass = 'advisory'; levelLabel = 'Advisory'; }
      // A fail-open is the one row that means the check did not run: the hook
      // threw, allowed the call, and recorded this. The default level would
      // render it amber and label it "Warning", which is below a block — and a
      // block is a guard that worked. Both emitters word their detail
      // "<X> error (fail-open): ...", so the label names the half they share
      // and the detail beside it says which hook.
      else if (w.event === 'guard_error') { levelClass = 'failopen'; levelLabel = 'Fail-open'; }
      // Stale session state. Historical only — the emitter was removed on
      // 2026-08-15 with the counters it measured — and kept because the log is
      // append-only and holds these rows. It keeps the amber warning level —
      // something WAS wrong — but not the label: "Warning" beside a row reading
      // "progress.commits: surface=0 record=12" invites the reader to treat it
      // as one more guard event, when what it says is that the counters that
      // stood in the header above had stopped being written. The label names that.
      else if (w.event === 'state_drift') { levelClass = 'warning'; levelLabel = 'Stale state'; }
      // The two siblings that are still emitted. Same reasoning as the label
      // above: "Warning" beside "commits no review opened: a1b2c3d" or
      // "fusion-workbench/… is in no commit" invites the guard reading, and
      // what each row says is that something the session owes is missing.
      else if (w.event === 'review_coverage') { levelClass = 'warning'; levelLabel = 'Review gap'; }
      else if (w.event === 'staging_drift') { levelClass = 'warning'; levelLabel = 'Unstaged record'; }
      var ts = formatLocalTime(w.ts || '', 'date');
      keys.push(warningKey(w));
      html += '<div class="warning-row ' + levelClass + '">' +
        '<span class="warning-level">' + escapeHtml(levelLabel) + '</span>' +
        '<span class="warning-detail">' + escapeHtml(w.detail || w.event) + '</span>' +
        '<span class="warning-ts">' + escapeHtml(ts) + '</span>' +
        '<button class="warning-dismiss">dismiss</button>' +
        '</div>';
    }
    panel.innerHTML = html;
    section.style.display = 'block';
    var btns = panel.querySelectorAll('.warning-dismiss');
    for (var k = 0; k < btns.length; k++) {
      btns[k].fusionDismissKey = keys[k];
      btns[k].addEventListener('click', function(ev) {
        var btn = ev.currentTarget;
        try { localStorage.setItem(btn.fusionDismissKey, '1'); } catch (e) {}
        btn.parentElement.parentNode.removeChild(btn.parentElement);
        if (panel.children.length === 0) section.style.display = 'none';
      });
    }
  }

  // Dismiss All — wired once on load; sets dismissal keys for every visible
  // warning currently in the panel and clears the section.
  document.getElementById('dismiss-all-btn').addEventListener('click', function() {
    var section = document.getElementById('warnings-section');
    var panel = document.getElementById('warnings-panel');
    var btns = panel.querySelectorAll('.warning-dismiss');
    for (var k = 0; k < btns.length; k++) {
      try { localStorage.setItem(btns[k].fusionDismissKey, '1'); } catch (e) {}
    }
    panel.innerHTML = '';
    section.style.display = 'none';
  });

  function highlightYaml(text) {
    var lines = text.split('\n');
    var result = [];
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      var escaped = escapeHtml(line);
      // Comments
      if (/^\s*#/.test(line)) {
        result.push('<span class="yaml-comment">' + escaped + '</span>');
        continue;
      }
      // Key-value lines
      escaped = escaped.replace(/^(\s*)(- )/, '$1<span class="yaml-list-marker">- </span>');
      escaped = escaped.replace(/^(\s*(?:<span[^>]*>- <\/span>)?)([A-Za-z_][A-Za-z0-9_.-]*)(:\s*)/, function(m, pre, key, sep) {
        return pre + '<span class="yaml-key">' + key + '</span>' + sep;
      });
      // Inline comment at end
      escaped = escaped.replace(/(#.*)$/, '<span class="yaml-comment">$1</span>');
      // Strings in quotes
      escaped = escaped.replace(/"([^"]*)"/, '"<span class="yaml-string">$1</span>"');
      escaped = escaped.replace(/'([^']*)'/, '\'<span class="yaml-string">$1</span>\'');
      // Booleans and null
      escaped = escaped.replace(/:\s+(true|false)(\s|$)/, function(m, val, after) {
        return ': <span class="yaml-bool">' + val + '</span>' + after;
      });
      escaped = escaped.replace(/:\s+(null|~)(\s|$)/, function(m, val, after) {
        return ': <span class="yaml-null">' + val + '</span>' + after;
      });
      // Numbers
      escaped = escaped.replace(/:\s+(\d+\.?\d*)(\s|$)/, function(m, val, after) {
        return ': <span class="yaml-number">' + val + '</span>' + after;
      });
      result.push(escaped);
    }
    return result.join('\n');
  }

  // Render an event's `detail` field as a human-readable string. Events emit
  // `detail` as either a string (the common case) or an object (richer events
  // like coherence_review carry structured detail). Without this helper an
  // object detail renders as the literal "[object Object]" via implicit
  // toString. Object values are joined as `key=value` pairs with a thin
  // separator; nested objects/arrays fall back to JSON.stringify so the row
  // remains readable even for non-flat payloads.
  function formatDetail(d) {
    if (d === null || d === undefined) return '';
    if (typeof d === 'string') return d;
    if (typeof d === 'object') {
      var parts = [];
      for (var k in d) {
        if (!Object.prototype.hasOwnProperty.call(d, k)) continue;
        var v = d[k];
        if (v !== null && typeof v === 'object') v = JSON.stringify(v);
        parts.push(k + '=' + v);
      }
      return parts.join(' · ');
    }
    return String(d);
  }

  function formatEvent(ev) {
    var timePart = formatLocalTime(ev.ts || '');
    var evType = ev.event || 'unknown';
    var detail = formatDetail(ev.detail);
    if (ev.task) detail = '[' + ev.task + '] ' + detail;
    // Events without an explicit agent field are by definition orchestrator-
    // emitted (session_start, gate_hit, commit, turn_*, reconciliation, …).
    // Default rather than render an unlabeled row, so every event displays
    // <agent>: <detail> uniformly.
    detail = (ev.agent || 'orchestrator') + ': ' + detail;

    return '<div class="event-row">' +
      '<span class="event-ts">' + escapeHtml(timePart) + '</span>' +
      '<span class="event-type ' + escapeHtml(evType) + '">' + escapeHtml(evType) + '</span>' +
      '<span class="event-detail" title="' + escapeHtml(detail) + '">' + escapeHtml(detail) + '</span>' +
      '</div>';
  }

  // Parse an event timestamp as UTC, returning Unix epoch ms (NaN on failure).
  // orchestrator-events.jsonl timestamps are written by `date -u
  // +%Y-%m-%dT%H:%M:%S` — UTC but without a 'Z' suffix. Per ECMA-262, an
  // ISO-8601 string with no timezone designator is interpreted as local time,
  // which would offset every parsed instant by the user's TZ. The fix:
  // append 'Z' unless the string already carries a timezone designator
  // (trailing 'Z' or a ±HH:MM / ±HHMM offset), then parse.
  function parseUTCTs(ts) {
    if (!ts) return NaN;
    if (/[zZ]$|[+-]\d{2}:?\d{2}$/.test(ts)) {
      return new Date(ts).getTime();
    }
    return new Date(ts + 'Z').getTime();
  }

  // Compute an ETA string for the currently running task by pairing past
  // (task_start, task_done) events per agent and averaging the last 10
  // durations. Returns '' when there's no running task; a labelled '—' when
  // history is too thin to estimate; the formatted ETA otherwise.
  //
  // Algorithm:
  //   1. Walk events oldest→newest; for each task_done, pop the most-recent
  //      earlier task_start with the same task id off a per-id stack. The
  //      pair's duration is grouped by the start.agent ('orchestrator' default).
  //      Track the timestamp of the most recent session_start seen so the
  //      candidate-selection step can reject orphan task_starts from prior
  //      sessions (see step 2).
  //   2. After the walk, any task_start ids still on a stack are unmatched —
  //      the last unmatched one (chronologically) is the currently running
  //      task, *provided* its timestamp is at-or-after the most recent
  //      session_start. Unmatched task_starts that predate the latest
  //      session_start are orphans (their session ended without emitting a
  //      matching task_done) and must not be paired as "running". If no
  //      session_start was seen in the window we fall back to the prior
  //      behaviour (latest unmatched across all ids).
  //   3. Tiered estimate selection driven by the per-agent paired-duration
  //      count `n` (window = last 10):
  //        n ≥ 3 → per-agent mean, label "(Nm avg, agent)"
  //        n == 2 or 1 → per-agent mean, label "(Nm avg, agent, n=K) ⚠ low data"
  //        n == 0 and global pairs ≥ 1 → cross-agent mean of last 10 paired
  //          durations across all agents (flattened in chronological completion
  //          order), label "(Nm avg, all agents) ⚠ no per-agent data"
  //        zero pairs anywhere → "ETA: — (no completed tasks yet)"
  //   4. Landing = running.ts + avg, format "HH:MM <suffix>".
  function computeETA(events) {
    if (!events || events.length === 0) {
      return 'ETA: — (no events yet)';
    }
    // Per-task-id stack of pending task_start events, and the per-agent
    // duration history accumulated as we walk. historyGlobal flattens
    // every paired duration across agents in chronological completion order
    // so the n==0 branch can fall back to a global average.
    var pending = {};       // task_id -> [start_event, start_event, ...]
    var historyByAgent = {}; // agent -> [durations in chronological completion order]
    var historyGlobal = []; // [duration, duration, ...] across all agents, completion-order
    var latestSessionStartMs = -1;  // most recent session_start ts in window; -1 if none
    var lastSessionEndMs = -1;      // most recent session_end ts in window; -1 if none
    for (var i = 0; i < events.length; i++) {
      var ev = events[i];
      if (!ev) continue;
      // Track session boundaries before the task-field guard — session_start
      // has no `task` field and would otherwise be skipped.
      if (ev.event === 'session_start') {
        var sessMs = parseUTCTs(ev.ts);
        if (!isNaN(sessMs) && sessMs > latestSessionStartMs) {
          latestSessionStartMs = sessMs;
        }
        continue;
      }
      // Drain pending on session_end — anything unmatched when the session
      // closes is an orphan from that closed session and must not be rendered
      // as "running" (issue 260530-0106). Like session_start, this event has
      // no `task` field, so the branch must come before the guard below.
      // Also record the timestamp so the running-task boundary below can use
      // it: see the boundary computation for why max(start, end) is the right
      // anchor.
      if (ev.event === 'session_end') {
        var endMs = parseUTCTs(ev.ts);
        if (!isNaN(endMs) && endMs > lastSessionEndMs) {
          lastSessionEndMs = endMs;
        }
        pending = {};
        continue;
      }
      if (!ev.task) continue;
      if (ev.event === 'task_start') {
        if (!pending[ev.task]) pending[ev.task] = [];
        pending[ev.task].push(ev);
      } else if (ev.event === 'task_done') {
        var stack = pending[ev.task];
        if (!stack || stack.length === 0) continue;
        var startEv = stack.pop();
        var startMs = parseUTCTs(startEv.ts);
        var doneMs = parseUTCTs(ev.ts);
        if (isNaN(startMs) || isNaN(doneMs)) continue;
        if (doneMs < startMs) continue;  // clock skew / out-of-order — skip
        var durSec = (doneMs - startMs) / 1000;
        var ag = startEv.agent || 'orchestrator';
        if (!historyByAgent[ag]) historyByAgent[ag] = [];
        historyByAgent[ag].push(durSec);
        historyGlobal.push(durSec);
      }
    }
    // Find currently running task: latest unmatched task_start across all ids,
    // rejecting any candidate that predates the current session boundary.
    //
    // The boundary is max(latest session_start, last session_end), NOT just the
    // latest session_start. Keying on session_start alone broke two real cases:
    //   1. A long session whose session_start scrolled out of the last-N-events
    //      window — no session_start in view, so every running task_start was
    //      either always-accepted (orphans leak) or, with a stale prior
    //      session_start in view, wrongly rejected → ETA stuck on "—".
    //   2. A session that never emitted session_start at all (e.g. a
    //      manual-conductor session) — same "—" stickiness.
    // Anchoring to the later of (start, end) handles all of them: after a clean
    // session_end the pending map is already drained, so a fresh task_start that
    // post-dates that end is correctly seen as running even with no session_start
    // in the window; and an interrupted prior session's orphans (which predate
    // the new session_start) are still rejected. If neither boundary was seen,
    // both stay -1 and the predicate degenerates to "always accept" (pre-fix
    // behaviour for a cold window).
    var sessionBoundaryMs = Math.max(latestSessionStartMs, lastSessionEndMs);
    var running = null;
    var runningTs = -1;
    for (var tid in pending) {
      if (!pending.hasOwnProperty(tid)) continue;
      var arr = pending[tid];
      if (arr.length === 0) continue;
      var last = arr[arr.length - 1];
      var ts = parseUTCTs(last.ts);
      if (isNaN(ts)) continue;
      if (ts < sessionBoundaryMs) continue;  // orphan from a prior/ended session
      if (ts > runningTs) {
        runningTs = ts;
        running = last;
      }
    }
    if (!running) return '';  // no task in flight
    var agent = running.agent || 'orchestrator';
    var hist = historyByAgent[agent] || [];
    // Tiered fallback: prefer per-agent; if no per-agent samples, fall back to
    // global; if no samples anywhere, surface the cold-start message.
    function meanOfLast(arr, k) {
      var w = arr.slice(-k);
      var s = 0;
      for (var j = 0; j < w.length; j++) s += w[j];
      return s / w.length;
    }
    function avgLabelOf(avgSec) {
      return avgSec < 60 ? '<1m' : Math.round(avgSec / 60) + 'm';
    }
    function formatLanding(avgSec) {
      var landingMs = runningTs + avgSec * 1000;
      var landing = new Date(landingMs);
      if (isNaN(landing.getTime())) return null;
      var hh = String(landing.getHours()).padStart(2, '0');
      var mm = String(landing.getMinutes()).padStart(2, '0');
      return hh + ':' + mm;
    }
    var avgSec, hhmm, suffix;
    if (hist.length >= 3) {
      avgSec = meanOfLast(hist, 10);
      hhmm = formatLanding(avgSec);
      if (hhmm === null) return '';
      suffix = '(' + avgLabelOf(avgSec) + ' avg, ' + agent + ')';
      return 'ETA: ' + hhmm + ' ' + suffix;
    }
    if (hist.length === 2 || hist.length === 1) {
      avgSec = meanOfLast(hist, hist.length);
      hhmm = formatLanding(avgSec);
      if (hhmm === null) return '';
      suffix = '(' + avgLabelOf(avgSec) + ' avg, ' + agent + ', n=' + hist.length + ') ⚠ low data';
      return 'ETA: ' + hhmm + ' ' + suffix;
    }
    // hist.length === 0: try global fallback.
    if (historyGlobal.length >= 1) {
      avgSec = meanOfLast(historyGlobal, 10);
      hhmm = formatLanding(avgSec);
      if (hhmm === null) return '';
      suffix = '(' + avgLabelOf(avgSec) + ' avg, all agents) ⚠ no per-agent data';
      return 'ETA: ' + hhmm + ' ' + suffix;
    }
    // No completed task anywhere in the window.
    return 'ETA: — (no completed tasks yet)';
  }

  function updateStatus(hasFile, age, mode) {
    var dot = document.getElementById('status-dot');
    var text = document.getElementById('status-text');
    if (!hasFile) {
      dot.className = 'status-dot missing';
      text.textContent = 'No dashboard file found';
    } else if (mode === 'gate') {
      dot.className = 'status-dot gate';
      text.textContent = '⏸ Paused at gate — waiting on user';
    } else if (mode === 'setup' && !(age !== undefined && age > 3600)) {
      // "Awaiting instruction" is honest right after a session_start, but a
      // session_start from an interrupted session (Claude killed before it
      // wrote anything else) would otherwise stick this label forever. After
      // an hour of silence, fall through to the age-based "stale" branch so a
      // dead session reads as "investigate" rather than "awaiting instruction".
      dot.className = 'status-dot setup';
      text.textContent = '⏸ Awaiting instruction';
    } else if (mode === 'done') {
      dot.className = 'status-dot done';
      text.textContent = 'Session complete';
    } else if (mode === 'error') {
      dot.className = 'status-dot error';
      text.textContent = 'Error';
    } else if (age !== undefined && age > 3600) {
      // Past 1h: stronger language, still yellow dot. Past 1h of true silence
      // is genuinely worth a look — but "investigate" is still softer than
      // "agent may be stuck".
      dot.className = 'status-dot stale';
      text.textContent = 'no updates in ' + Math.round(age/3600) + 'h — investigate';
    } else if (age !== undefined && age > 900) {
      // 15min threshold (was 5min). Many legitimate tasks (coder dispatches
      // across multiple files, reconciler passes, smoke tests) exceed 5min;
      // the previous "agent may be stuck" copy alarmed users during normal
      // long-running work. 15min is a more honest first-tier signal.
      dot.className = 'status-dot stale';
      text.textContent = 'no updates in ' + Math.round(age/60) + 'm — agent may be working a long task';
    } else {
      dot.className = 'status-dot live';
      text.textContent = 'Live';
    }
    // Wall-clock poll time (browser-local). The file's own age relative to
    // wall-clock is appended below so the user can distinguish "browser just
    // refreshed" from "fusion just wrote the file".
    var nowStr = new Date().toLocaleTimeString();
    var ageStr = '';
    if (age !== undefined && age > 60) {
      if (age > 3600) ageStr = ' (' + Math.round(age / 3600) + 'h ago)';
      else ageStr = ' (' + Math.round(age / 60) + 'm ago)';
    }
    document.getElementById('last-update').textContent = 'Updated: ' + nowStr + ageStr;
  }

  function rerender() {
    if (lastDashboardMd) {
      document.getElementById('dashboard-content').innerHTML = renderMarkdown(lastDashboardMd);
    }
  }

  // Liveness of the page itself, separate from the liveness of the file it
  // shows. A poll that fails used to be swallowed whole, so a tab whose server
  // had gone (restarted on another port, the machine asleep, the socket closed
  // under a suspended tab) kept every row of its last render, and the panel
  // asserted a state that had stopped being true with nothing to say so
  // (issue 260822-0849, option 1). Every successful poll stamps the time; a
  // failed one reads the stamp, and once it is older than three intervals the
  // status bar says so in place of the last "Updated:" claim. The rows stay:
  // they were true when rendered and the mark says how long ago that was.
  var lastPollOk = 0;
  var STALE_AFTER = 3 * POLL_INTERVAL;
  function markPollFailed() {
    if (!lastPollOk || Date.now() - lastPollOk < STALE_AFTER) return;
    var secs = Math.round((Date.now() - lastPollOk) / 1000);
    var dot = document.getElementById('status-dot');
    var text = document.getElementById('status-text');
    dot.className = 'status-dot error';
    text.textContent = 'not polling: last successful poll ' + secs + 's ago; the monitor may have stopped';
    document.getElementById('last-update').textContent = 'Stale: shown as of ' + new Date(lastPollOk).toLocaleTimeString();
  }

  function pollDashboard() {
    fetch('/api/dashboard')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        lastPollOk = Date.now();
        updateStatus(data.exists, data.age, data.mode);
        renderWarnings(data.warnings);
        // ETA next to the "Updated:" timestamp — recomputed every poll
        // from data.events. Empty string when no task is currently running
        // (so it doesn't show stale data).
        var etaEl = document.getElementById('eta-estimate');
        if (etaEl) {
          var etaStr = computeETA(data.events);
          if (etaStr) {
            etaEl.textContent = ' · ' + etaStr;
          } else {
            // Keep the slot visible when no task is in flight so the user
            // sees the layout is intact (and not broken/loading). Em-dash
            // signals "no estimate available" without alarming.
            etaEl.textContent = ' · ETA: —';
          }
        }
        if (data.dashboard && data.dashboard !== lastDashboardMd) {
          lastDashboardMd = data.dashboard;
          document.getElementById('dashboard-content').innerHTML = renderMarkdown(data.dashboard);
        }
        if (!data.exists) {
          document.getElementById('dashboard-content').innerHTML =
            '<div class="no-file">Waiting for orchestrator-live.md...<span>File will appear when the orchestrator starts</span></div>';
        }
        var evHtml = '';
        var evContent = document.getElementById('events-content');
        if (data.events && data.events.length > 0) {
          var evStr = JSON.stringify(data.events);
          if (evStr !== lastEvents) {
            lastEvents = evStr;
            for (var i = data.events.length - 1; i >= 0; i--) {
              evHtml += formatEvent(data.events[i]);
            }
            evContent.innerHTML = evHtml;
          }
        } else if (lastEvents !== '__empty__') {
          lastEvents = '__empty__';
          evContent.innerHTML =
            '<div class="no-file">No events yet<span>Events appear here as the orchestrator runs</span></div>';
        }
      })
      .catch(markPollFailed);
  }

  function pollState() {
    fetch('/api/state')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.exists) {
          var content = data.content || '';
          if (content !== lastState) {
            lastState = content;
            document.getElementById('state-content').innerHTML =
              '<pre class="yaml-content">' + highlightYaml(content) + '</pre>';
          }
        } else {
          if (lastState !== '__missing__') {
            lastState = '__missing__';
            document.getElementById('state-content').innerHTML =
              '<div class="no-file">No active session<span>agentstate.yaml does not exist (created when orchestrator starts, deleted on clean exit)</span></div>';
          }
        }
      })
      .catch(function() {});
  }

  function poll() {
    pollDashboard();
    pollState();
  }

  poll();
  setInterval(poll, POLL_INTERVAL);
})();
</script>
</body>
</html>""".replace('MONITOR_NAME_PLACEHOLDER', MONITOR_NAME).replace('INTERVAL_PLACEHOLDER', str(INTERVAL)).replace('MAX_EVENTS_PLACEHOLDER', str(MAX_EVENTS))


class _JsonlTail:
    """Incremental JSONL reader shared across requests (module-level, one per
    log): parses only the bytes appended since the last poll, and re-parses
    from zero when the file was REWRITTEN rather than appended to — a changed
    inode or a size below the held offset, which is what a git pull's union
    merge, an archive roll, or a truncation looks like from here.

    WHY. Both logs are append-only with no ceiling by design, the poll
    interval is seconds, and until v10.9.0 every poll re-parsed every line —
    O(file) work thirty times a minute for a fixed-size window, growing
    without bound with the log (measured at 2,420 lines / ~377 KB when the
    cost was audited). The correctness argument that widened the parse to the
    whole file (a foreign block can stand anywhere — see _read_events) is
    untouched: the CACHE holds every parsed row, exactly as the full parse
    did; only the parsing of bytes already parsed is skipped. Filtering,
    sorting and slicing stay per-request on top of the cached rows, so a
    checkout-id that appears mid-session changes the served window without
    any cache concern. A torn final line (a writer mid-append) is left in the
    file until its newline arrives: the offset only ever advances past a
    newline. Thread-safe because the server is ThreadingHTTPServer."""

    def __init__(self, path):
        import threading
        self.path = path
        self._lock = threading.Lock()
        self._key = None
        self._offset = 0
        self._rows = []

    def rows(self):
        with self._lock:
            try:
                st = os.stat(self.path)
            except OSError:
                self._key, self._offset, self._rows = None, 0, []
                return self._rows
            key = (st.st_ino, st.st_dev)
            if key != self._key or st.st_size < self._offset:
                self._key, self._offset, self._rows = key, 0, []
            if st.st_size > self._offset:
                try:
                    with open(self.path, "rb") as f:
                        f.seek(self._offset)
                        chunk = f.read()
                except OSError:
                    return self._rows
                nl = chunk.rfind(b"\n")
                if nl >= 0:
                    for raw in chunk[:nl].split(b"\n"):
                        raw = raw.strip()
                        if not raw:
                            continue
                        try:
                            self._rows.append(json.loads(raw.decode("utf-8")))
                        except (UnicodeDecodeError, json.JSONDecodeError):
                            continue
                    self._offset += nl + 1
            return self._rows


_EVENTS_TAIL = _JsonlTail(EVENTS_JSONL)
_GUARD_TAIL = _JsonlTail(GUARD_EVENTS_JSONL)


class Handler(http.server.BaseHTTPRequestHandler):
    # Per-connection socket timeout. Without this, a client that opens a
    # connection and then stalls mid-request (a backgrounded browser tab, a
    # laptop sleep/wake, a localhost socket blip) would block its worker
    # indefinitely. With ThreadingHTTPServer below, a wedged worker no longer
    # freezes the whole server, but the timeout still reclaims the thread.
    timeout = 15

    def log_message(self, format, *args):
        # Suppress default request logging
        pass

    def _headers(self, content_type="application/json", status=200):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()

    def _read_file(self, path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return f.read(), True
        except FileNotFoundError:
            return "", False
        except Exception as e:
            return f"Error reading file: {e}", False

    def _file_age(self, path):
        try:
            import time
            return time.time() - os.path.getmtime(path)
        except Exception:
            return None

    # Map the orchestrator's most recent event to a UI mode. Markdown markers
    # in orchestrator-live.md are inconsistent across sessions ("## Current"
    # vs "## Status", with-marker vs free text), but the events log is
    # structured and append-only — the most recent event reliably tells us
    # what the orchestrator is doing right now. Any event not in this map
    # leaves mode unset and falls back to the age-based logic.
    LAST_EVENT_TO_MODE = {
        "session_start": "setup",
        "gate_hit": "gate",
        "session_end": "done",
        "task_error": "error",
        "bugfix_failure": "error",
    }

    def _parse_mode(self, events):
        if not events:
            return None
        last = events[-1].get("event") if isinstance(events[-1], dict) else None
        return self.LAST_EVENT_TO_MODE.get(last)

    def _read_warnings(self):
        """Read .guard-state/events.jsonl and return the most recent panel
        events. Filters out noise (guard_allow, tracker_record).

        Each class is capped against its own budget and the classes are merged
        back into one chronological list — up to MAX_WARNINGS_RETURNED warnings
        plus up to MAX_ADVISORIES_RETURNED advisories plus up to
        MAX_ERRORS_RETURNED fail-opens, newest last. See the comment on those
        constants for why the budgets are separate."""
        # Same incremental source as _read_events; the class carving below is
        # per-request and unchanged.
        warnings = []
        carved = [[] for _ in SUBSET_BUDGETS]
        for ev in _GUARD_TAIL.rows():
            if not isinstance(ev, dict):
                continue
            event = ev.get("event")
            if event not in WARNING_EVENT_TYPES:
                continue
            for bucket, (types, _cap) in zip(carved, SUBSET_BUDGETS):
                if event in types:
                    bucket.append(ev)
                    break
            else:
                warnings.append(ev)
        # Nothing carved out: return exactly what this function always returned,
        # down to the ordering. The merge below cannot change the result in
        # this case, but it could change it if the file's timestamps were ever
        # out of order, and "unchanged when no override was used and nothing
        # failed open" is worth more than the uniformity.
        if not any(carved):
            return warnings[-MAX_WARNINGS_RETURNED:]
        merged = list(warnings[-MAX_WARNINGS_RETURNED:])
        for bucket, (_types, cap) in zip(carved, SUBSET_BUDGETS):
            merged += bucket[-cap:]
        # Sort on the raw timestamp string. The guard writes ts as
        # Date.toISOString() — fixed-width, UTC, Z-suffixed — so lexical order
        # IS chronological order and no parsing (and no parsing failure) is
        # involved. An event missing ts sorts oldest rather than raising, and
        # the sort is stable, so events sharing a timestamp keep file order.
        merged.sort(key=lambda e: e.get("ts") or "")
        return merged

    def _read_checkout_id(self):
        """This checkout's identifier, read from BASE_DIR/.checkout-id.

        A plain file read, and never a mint. Minting belongs to the
        bin/fusion-identity helper alone: a dashboard process that creates
        workbench state is a defect of its own, and this file is class L in
        rules/workbench-tracking.md, so it stays in the checkout it was minted in
        and never travels with a pull.

        Returns None when the file is absent, unreadable or empty, which the
        caller reads as "keep every line"."""
        content, exists = self._read_file(CHECKOUT_ID_FILE)
        if not exists:
            return None
        return content.strip() or None

    def _read_events(self):
        """The event window served at /api/dashboard: this checkout's lines
        from orchestrator-events.jsonl, chronological, newest MAX_EVENTS last.

        WHY THE READ IS SHAPED THIS WAY. fusion declares merge=union on this
        file, so a pull interleaves another checkout's session into it and the
        dashboard is reading two independent sessions as one. Four readings go
        false at once, and all four are downstream of this single array:

          1. _parse_mode reads events[-1], so another checkout's session_end
             renders "Session complete" while this session is still working.
          2. computeETA (client side) drains its pending-task map on every
             session_end and rejects any task_start older than the last one, so
             a foreign session_end erases this session's ETA.
          3. The paired-duration average behind that ETA is computed from
             whichever start/end pairs survive the interleaving, so the same
             lines in a different order give a different average.
          4. The Event Log panel renders this array, so a foreign block can
             push this session's most recent events out of the window.

        All four were measured, with commands and output, in
        circles/260823-0023-settle-what-travels-between-checkouts/issues/260823-1302_*_the-monitor-attributes-a-merged-event-log-to-one-session-and-reports-another-checkouts-state.md,
        which also measured that sorting by ts alone does NOT repair them: it
        moved reading 1 from vague to wrong. The question is which session a
        line belongs to, and no ordering of the same bytes answers it. So the
        repair is identity on the line: parse EVERY line rather than the last
        MAX_EVENTS (a foreign block can stand anywhere in the file), drop the
        lines whose checkout is present and differs from ours, sort what
        remains, then take the last MAX_EVENTS.

        Sorting on the raw ts string is correct for the reason _read_warnings
        gives above for the guard log: the emit convention writes a fixed-width
        UTC stamp, so lexical order IS chronological order and no parsing (and
        no parsing failure) is involved. A line missing ts sorts oldest rather
        than raising, and the sort is stable, so lines sharing a timestamp keep
        file order.

        A line carrying no checkout counts as ours, and an unreadable
        identifier keeps every line — which is today's behaviour exactly. That
        is the point rather than a fallback: the whole pre-existing log carries
        no such field and no record is rewritten, so an absent identifier has
        to read as this checkout's own or the panel would come up empty."""
        # Rows come from the incremental tail cache (class _JsonlTail above):
        # every line ever parsed, in file order, at O(new bytes) per poll.
        # The identity filter stays per-request on top of it, so a checkout id
        # that appears or changes mid-session is honoured on the next poll.
        mine = self._read_checkout_id()
        events = []
        for ev in _EVENTS_TAIL.rows():
            if mine is not None and isinstance(ev, dict):
                wrote = ev.get("checkout")
                if wrote and wrote != mine:
                    continue
            events.append(ev)
        events.sort(key=lambda e: (e.get("ts") or "") if isinstance(e, dict) else "")
        return events[-MAX_EVENTS:]

    def do_GET(self):
        if self.path == "/":
            self._headers("text/html")
            self.wfile.write(HTML_PAGE.encode("utf-8"))

        elif self.path == "/api/dashboard":
            self._headers()
            content, exists = self._read_file(LIVE_MD)
            age = self._file_age(LIVE_MD)

            events = self._read_events()

            resp = json.dumps({
                "dashboard": content,
                "exists": exists,
                "age": age,
                "mode": self._parse_mode(events),
                "events": events,
                "warnings": self._read_warnings(),
            })
            self.wfile.write(resp.encode("utf-8"))

        elif self.path == "/api/state":
            self._headers()
            content, exists = self._read_file(STATE_YAML)
            resp = json.dumps({
                "content": content,
                "exists": exists,
            })
            self.wfile.write(resp.encode("utf-8"))

        else:
            self._headers(status=404)
            self.wfile.write(b'{"error": "not found"}')


import socket, signal, subprocess

# Kill any previous monitor on this port.
#
# Two questions, asked separately, and their answers unioned.
#
# `-sTCP:LISTEN` is load-bearing, not a tidy-up. `lsof -ti :PORT` answers "who
# has this port open", which includes every *client* connected to it — and the
# browser tab showing the previous dashboard is exactly such a client. So
# starting a monitor on the port a tab was already watching SIGTERMed the
# user's browser, which is a far larger event than the stale server this step
# exists to clear. Narrowed to listeners, the step reaches the process whose
# existence would make the bind below fail, and no client at all. That is the
# first question, and it is the documented behaviour of this script: whatever
# is *listening* on the port gets a SIGTERM, monitor or not.
#
# The second question exists because a stale monitor need not be in LISTEN.
# The MONITOR_BIND note further down this file records a state measured on this
# machine on 2026-08-06 and written up in
# `fusion-workbench/circles/260805-2005-textschicht-gegen-code-nachziehen/issues/260806-0820_c_*`:
# a non-loopback listener of a process without macOS Local Network permission
# parked in CLOSED and never reached LISTEN. If that is the state a host is in,
# a state-filtered query cannot see the stale monitor it was written to clear,
# and SO_REUSEPORT below means the new bind succeeds anyway — two servers, one
# port, no diagnostic. That premise is **not verified at HEAD** and could not be
# re-measured here (this host has since been granted the permission, so the
# precondition is absent); see the record above and the finding
# `shared/issues/260815-2326_*`.
#
# So the second question does not rest on it. It asks *what a process is
# running* rather than what state its socket is in: of the pids holding this
# port, the ones whose command line runs this very script — `monitor-server.py`,
# the name the wrapper writes — are prior monitors, in LISTEN or CLOSED alike,
# and a browser can never be one. The union is therefore a superset of the
# previous kill set that adds only prior instances of this file, and it adds
# nothing on a host where a stale monitor does reach LISTEN, because there the
# first question already found it.
#
# "Runs" is exactly the script token of the command line, not the string
# appearing anywhere in it — see `_runs_this_script` below, which states what
# that costs. The looser test was the previous version of this predicate and it
# killed a port-holding process whose argv merely mentioned the file
# (`shared/issues/260816-0131_*`).
SERVER_SCRIPT = os.path.basename(os.path.abspath(__file__))


def _lsof_pids(*extra):
    try:
        out = subprocess.check_output(
            ["lsof", "-ti", f":{PORT}", *extra], stderr=subprocess.DEVNULL
        ).decode()
    except (subprocess.CalledProcessError, OSError):
        return set()
    return {p.strip() for p in out.split("\n") if p.strip().isdigit()}


def _runs_this_script(pid):
    """True when pid is *running* this script — not merely naming it.

    `ps -o command=` prints `<interpreter> [interpreter options] <script>
    [args…]`, so only the script token decides. A substring test over the whole
    line does not: a process holding this port whose argv merely contains the
    string was measured being SIGTERMed, while the identical process without it
    survived (`shared/issues/260816-0131_*`). Clients, editors and greps carry
    the name in arguments; none of them runs the file.

    The comparison is on the basename, because the wrapper writes this script
    into a fresh `mktemp -d` on every run — a prior monitor's script path is
    never today's, so a full-path test would match nothing.

    Three residuals, each of which loses a kill rather than gaining a wrong
    one, and each of which leaves the first question's listener kill
    untouched: an interpreter or script path containing a space splits across
    tokens and is not recognised; an interpreter invoked as `-c` never reaches
    a script token; and an interpreter reached through `env` (`env python3
    …/monitor-server.py`) is not recognised either, because the loop below
    returns on the first non-option token and that token is `python3`. The
    third is deliberately not closed by scanning every token, since that
    re-admits the argv-mention kill named above. The wrapper at the foot of
    this file launches as `python3 "$TMPFILE"`, so a monitor it started is
    always matched; the gaps reach only a monitor started some other way.
    """
    try:
        cmd = subprocess.check_output(
            ["ps", "-o", "command=", "-p", pid], stderr=subprocess.DEVNULL
        ).decode()
    except (subprocess.CalledProcessError, OSError):
        return False
    for token in cmd.split()[1:]:
        if token.startswith("-"):
            continue
        return os.path.basename(token) == SERVER_SCRIPT
    return False


_listeners = _lsof_pids("-sTCP:LISTEN")
_stale_monitors = {p for p in (_lsof_pids() - _listeners) if _runs_this_script(p)}
for _pid in _listeners | _stale_monitors:
    try:
        if int(_pid) != os.getpid():
            os.kill(int(_pid), signal.SIGTERM)
            import time; time.sleep(0.3)
    except (ValueError, ProcessLookupError, PermissionError):
        pass

# ThreadingHTTPServer (not the single-threaded HTTPServer): the browser fires
# two concurrent requests every poll (/api/dashboard + /api/state), and any one
# slow or stalled connection on a single-threaded server wedges serve_forever()
# indefinitely — the port stays bound (monitor *looks* alive) but never serves
# fresh data again. That was the root of the "monitor shows no changes / goes
# unstable" reports; prior fixes only touched the ETA algorithm, never the
# server. daemon_threads=True lets the process exit cleanly without joining
# stuck worker threads.
class ReuseServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True
    def server_bind(self):
        self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except (AttributeError, OSError):
            pass
        super().server_bind()


class DualStackServer(ReuseServer):
    """The wildcard bind, carrying both address families on one socket.

    ThreadingHTTPServer is AF_INET, so the wildcard bind `0.0.0.0` listened on
    IPv4 alone — while every URL this script prints and opens says `localhost`,
    which resolves to the IPv6 loopback `::1` first on macOS and on modern
    Linux. The program was therefore naming an address it was not listening at.
    Clients that walk the whole address list (curl, the browsers) recover by
    retrying on 127.0.0.1 and pay only the delay of one refused connection;
    a client that takes the first address gets `connection refused` from a URL
    the program itself handed it.

    Printing `127.0.0.1` everywhere would also close that gap, and it is the
    smaller edit. It is not what this file does. `localhost` is the string a
    user copies, pastes and bookmarks, so on the bind the user gets without
    asking for one — the wildcard — the fix is to make the name true rather
    than to route around it, and that is what this class is for.

    On every other path the file prints the address it actually bound, which
    *is* `127.0.0.1`: the OSError fallback below, and an explicit
    `MONITOR_BIND=127.0.0.1` or its `localhost` spelling. The `local_host`
    block further down is where that choice is made, and it follows the socket
    rather than a constant. `hooks/lib/__tests__/monitor-warnings-panel.test.ts`
    pins both halves of it — `http://127.0.0.1:${port}` for its loopback-bound
    cases (~:906), `http://localhost:${port}` answering on both families for
    the default wildcard (~:1052) — so the pins assert that the printed name
    follows the socket, not that either spelling is the constant one.

    IPV6_V6ONLY=0 is what makes the one socket answer IPv4 too, via v4-mapped
    addresses. It is not universal — OpenBSD refuses v4-mapped sockets outright
    — so a platform that rejects the option raises here and the caller below
    falls back to the IPv4 server this file has always built.
    """
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


# BIND defaults to 0.0.0.0 (LAN-reachable). MONITOR_BIND=127.0.0.1 gives a
# loopback-only server, and the test suite pins that for cases whose subject is
# not the bind.
#
# The reason it pins it is a measurement, and the measurement's status matters
# because three things lean on it. On 2026-08-06, on this development machine,
# macOS parked a non-loopback listener of a process without Local Network
# permission in CLOSED state — never LISTEN — and dropped its inbound SYNs even
# from 127.0.0.1, while a loopback bind was exempt. Nine tests were red for it.
# That is measured and written up in
# `fusion-workbench/circles/260805-2005-textschicht-gegen-code-nachziehen/issues/260806-0820_c_*`,
# which labels the CLOSED/LISTEN dichotomy as measured and the attribution to
# the Local Network TCC service as inference.
#
# **It does not reproduce here any more, and that is not the same as being
# false.** Re-measured 2026-08-16 on macOS 15.7.7 (24G720): all four binds —
# `0.0.0.0`, `::`, the en0 LAN address and `127.0.0.1` — reach LISTEN and answer.
# The precondition is what changed: this process tree now *has* Local Network
# permission (an outbound TCP connect to the LAN gateway succeeds, which a
# denied process cannot do), because the 2026-08-06 record closed by asking the
# user to grant it. Re-testing the claim needs a host where the permission is
# denied, and revoking it here is a system-settings change no fix is worth.
# Treat the claim as unverified-at-HEAD rather than as either fact or fiction:
# do not delete it, and do not build anything that only works if it is true.
#
# Only the wildcard goes dual-stack. An explicit MONITOR_BIND names one
# address and gets exactly that address, on the family it belongs to: a
# loopback IPv6 socket cannot carry 127.0.0.1 (v4-mapping works on the
# wildcard only), so widening `127.0.0.1` would silently move the server off
# the address the caller asked for.
WILDCARD_BINDS = ("0.0.0.0", "::", "")
dual_stack = False
if BIND in WILDCARD_BINDS:
    try:
        server = DualStackServer(("::", PORT), Handler)
        dual_stack = True
    except OSError:
        # No IPv6 on this host, or a kernel that will not clear V6ONLY. IPv4
        # alone is what this file did before, and it still serves — but it
        # serves at 127.0.0.1 and not at every address `localhost` can name,
        # so `dual_stack` stays False and the printed URL follows it below.
        server = ReuseServer(("0.0.0.0", PORT), Handler)
else:
    server = ReuseServer((BIND, PORT), Handler)

# Loopback-only bind: no LAN URL to print, the server answers on 127.0.0.1 only.
# IPv4 spellings only — an explicit bind builds the AF_INET server above, so an
# IPv6 bind like ::1 fails at construction and never reaches this check. The
# wildcard is dual-stack and is not a loopback bind, so it is not listed here.
LOOPBACK_BINDS = ("127.0.0.1", "localhost")

# The address this program prints is the address this program is listening at.
#
# `localhost` is the name a user copies, pastes and bookmarks, so it is what
# belongs in the URL — but only when it is true. It resolves to `::1` first on
# macOS and on modern Linux, so it is true of the dual-stack server and false
# of every IPv4-only server this file can end up with: the OSError fallback
# above, and an explicit `MONITOR_BIND=127.0.0.1` (or the `localhost` spelling
# of it, which python resolves to an AF_INET socket). Printing `localhost` on
# those paths is exactly the defect the dual-stack bind was written to remove,
# reinstated on the paths nobody watches — the fallback is the
# platform-compatibility arm, so it fires where there is no one to notice.
#
# So the spelling follows the socket rather than being a constant: the name
# when both loopback families answer, the literal `127.0.0.1` when only one
# does, and the caller's own address when the caller named one.
if dual_stack:
    local_host = "localhost"
elif BIND in WILDCARD_BINDS or BIND in LOOPBACK_BINDS:
    local_host = "127.0.0.1"
else:
    local_host = BIND
LOCAL_URL = f"http://{local_host}:{PORT}"

# Publish it for the wrapper's browser launcher, which forks this process and
# cannot otherwise learn which of the two servers got built. Best-effort by
# construction: the launcher falls back to its own constant, and a monitor that
# could not write a scratch file must still serve.
if LOCAL_URL_FILE:
    try:
        with open(LOCAL_URL_FILE, "w") as fh:
            fh.write(LOCAL_URL)
    except OSError:
        pass

# Best-effort LAN address for the printed URL only — failure to detect an
# address must never be fatal.
lan_host = None
if BIND not in LOOPBACK_BINDS:
    try:
        lan_host = subprocess.check_output(["ipconfig", "getifaddr", "en0"], stderr=subprocess.DEVNULL).decode().strip()
    except Exception:
        pass
    if not lan_host:
        try:
            lan_host = socket.gethostname()
        except Exception:
            lan_host = None

print(f"\n  {MONITOR_NAME} — Orchestrator Monitor")
print(f"  Local: {LOCAL_URL}")
if lan_host:
    print(f"  LAN:   http://{lan_host}:{PORT}")
print(f"  Watching: {BASE_DIR}")
print(f"  Polling every {INTERVAL}s | Showing last {MAX_EVENTS} events")
print(f"  Press Ctrl+C to stop\n")

try:
    server.serve_forever()
except KeyboardInterrupt:
    print("\n  Stopped.")
    server.server_close()
PYTHON_SCRIPT

python3 "$TMPFILE" "$MONITOR_NAME" "$PORT" "$MAX_EVENTS" "$INTERVAL" "$WORKBENCH_DIR" "${MONITOR_BIND:-0.0.0.0}" "$URL_FILE" &
SERVER_PID=$!

trap 'kill $SERVER_PID 2>/dev/null; wait $SERVER_PID 2>/dev/null; exit 0' INT TERM

# Hand the dashboard to a person, and only to a person.
#
# `open` exists to put the dashboard in front of a human who just started the
# monitor at a terminal. Everything else that starts this script (the harness
# in hooks/lib/__tests__/monitor-warnings-panel.test.ts, a CI job, a
# background job, nohup) wants a server and nothing else, and got a browser
# tab anyway. One `npm test` run
# spawns the monitor eleven times on eleven throwaway ports, each killed
# seconds later, so eleven tabs open on eleven ports that answer nothing; run
# by several agents in parallel that is hundreds of focus-stealing tabs on
# dead ports. `[ -t 1 ]` is the honest discriminator, and it makes every
# non-interactive caller silent by construction, with no caller change
# anywhere: a spawn with stdio ignored, piped or redirected has no terminal on
# stdout, and a person at a terminal does.
#
# MONITOR_NO_BROWSER is the second, independent gate: a person at a terminal
# who wants the server without the tab. Any non-empty value suppresses.
#
# The launcher never decides the wrapper's lifetime. This script runs under
# `set -e`, and a failing command inside an `if` body is not exempt from it —
# only the condition is. So a missing `open` (Linux, or a macOS whose PATH is
# narrowed) used to exit 127 as the wrapper's own status before `wait
# $SERVER_PID` was ever reached: the forked python server was left orphaned,
# still holding the port, with the INT/TERM trap dead along with the shell
# that installed it. `|| true` is the load-bearing half of the fix — every
# launcher can fail for reasons that are none of the server's business (no
# display, no registered handler, a browser that refuses to start).
#
# The platform dispatch is the other half, and it earns its three lines twice:
# it makes the tab actually open on Linux, where `open` does not exist, and it
# avoids the trap that a bare `command -v open` walks into there — on many
# Linux distributions `/usr/bin/open` is util-linux's `openvt`, which switches
# virtual terminals and has nothing to do with a URL. Darwin gets `open`,
# everything else gets `xdg-open`.
#
# `sleep` is a command like any other: it sits in the `if` body, so it is under
# `set -e` exactly as the launcher is, and it was the one command in this block
# left unguarded. The fractional argument is a GNU/BSD extension — POSIX
# specifies an integer operand, and BusyBox built without FEATURE_FANCY_SLEEP,
# Solaris `sleep` and AIX `sleep` reject it non-zero. Those are the same
# platforms the `*)` arm exists for, so the dispatch that made the tab work on
# Linux is what brought this line within reach of the machines it breaks on.
# The whole-second fallback keeps the delay rather than dropping it, because
# the delay is what stops the tab reaching a port the forked server has not
# bound yet; `2>/dev/null` keeps the rejected fractional call from printing an
# error a user can do nothing about; and the final `|| true` means even a
# `sleep` missing outright cannot decide the wrapper's lifetime.
#
# Whichever way the tab fails to appear, one line on stderr says so and names
# the URL. In silence a person who was promised a tab cannot tell an absent
# launcher from a launcher that refused from a server that never started, and
# the remedy is one line away. MONITOR_NO_BROWSER is exempt by construction,
# and so is every non-interactive caller: neither reaches this block, and the
# gap is only a gap for someone who wanted the tab.
#
# The URL is read from the server, not composed here. A tab opened at a name
# the server does not answer at is the same defect as a banner printing one,
# and this half is the half that would have kept it: only the python process
# knows whether the dual-stack bind succeeded. `$URL_FILE` is written right
# after the bind, so waiting for it is also a better startup gate than the flat
# `sleep` — it waits for the event the sleep was estimating. The constant stays
# as the fallback for a server that never wrote the file, because a tab at the
# old URL is what this script did before and is better than no tab at all.
if [[ -t 1 && -z "${MONITOR_NO_BROWSER:-}" ]]; then
  case "$(uname -s)" in
    Darwin) BROWSER_LAUNCHER=open ;;
    *)      BROWSER_LAUNCHER=xdg-open ;;
  esac
  BROWSER_GAP=""
  LOCAL_URL="http://localhost:${PORT}"
  if command -v "$BROWSER_LAUNCHER" >/dev/null 2>&1; then
    # Same fractional-sleep caveat as before, and the same whole-second
    # fallback: BusyBox without FEATURE_FANCY_SLEEP, Solaris and AIX reject a
    # fractional operand. Probed once so the fallback cannot turn a 1 s wait
    # into a 10 s one.
    if sleep 0.1 2>/dev/null; then
      for _ in 1 2 3 4 5 6 7 8 9; do
        if [[ -s "$URL_FILE" ]]; then break; fi
        sleep 0.1 || true
      done
    else
      sleep 1 || true
    fi
    if [[ -s "$URL_FILE" ]]; then
      LOCAL_URL="$(cat "$URL_FILE" 2>/dev/null || echo "$LOCAL_URL")"
    fi
    "$BROWSER_LAUNCHER" "$LOCAL_URL" ||
      BROWSER_GAP="$BROWSER_LAUNCHER could not open a browser"
  else
    BROWSER_GAP="no $BROWSER_LAUNCHER on PATH"
  fi
  if [[ -n "$BROWSER_GAP" ]]; then
    echo "monitor: ${BROWSER_GAP}. Open ${LOCAL_URL} yourself; set MONITOR_NO_BROWSER=1 to silence this." >&2 || true
  fi
fi
wait $SERVER_PID
