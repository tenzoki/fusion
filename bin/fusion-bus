#!/usr/bin/env python3
"""fusion-bus — inspect and process workbench bus inboxes.

Reads `fusion-workbench/bus/<agent>/inbox/` produced by the workbench-mediated
A2A messaging protocol (see rules/fusion-workbench-conventions.md `## Bus
protocol`). The user remains the trigger — this helper does not route or
notify. It only surfaces what is filed and lets the user mark items processed.

Subcommands:
  list                  Table of unread messages across all inboxes (oldest first).
  show <stem>           Print path + contents of the message whose filename
                        contains <stem> (case-insensitive substring).
  mark-read <stem>      Move the matched message into inbox/.processed/
                        (atomic rename; dual-write race-safe per protocol).
  daemon start          Launch bin/fusion-bus-daemon in the background
                        (use --foreground to exec in place for debugging).
  daemon stop           Send SIGTERM to the running daemon, escalate to
                        SIGKILL after 5s if it doesn't exit cleanly.
  daemon status         Print PID, mode, pending count, and recent-route
                        stats from bus/.daemon-state.json + bus/.daemon.pid.
  pending               Table of pending injections from bus/.pending/*.json
                        (works regardless of daemon state).
  approve <stem>        File an approve command for the matched .pending/
                        entry; daemon picks up on next tick.
  deny <stem> [--reason TEXT]
                        File a deny command; daemon annotates the message
                        body and routes both files to their .processed/ /
                        .denied/ targets.
  pause                 File a pause command (daemon stops reacting).
  resume                File a resume command.
  mode <strict|observe|silent>
                        File a set-mode command (validated against the
                        closed set).

Exit codes: 0 success, 1 operational error / no match / ambiguous match /
"daemon expected to be running but isn't", 2 bad invocation. Python 3 stdlib
only.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

PROG = "fusion-bus"
# Tolerates either `Field: value` (YAML-style) or `**Field:** value`
# (bold-prefixed markdown). The bold-close `**` may sit either side of the
# colon depending on the writer's convention.
FM_RE = re.compile(r"^\**(From|To|Re|Filed)\**\s*:\**\s*(.+?)\s*$")

# Valid mode strings — mirrors VALID_MODES in fusion-bus-daemon.
VALID_MODES = ("strict", "observe", "silent")


def resolve_root() -> Path:
    helper = Path(__file__).resolve().parent / "fusion-workbench-root"
    res = subprocess.run([str(helper)], capture_output=True, text=True, check=False)
    if res.returncode != 0 or not res.stdout.strip():
        print(f"{PROG}: no fusion workbench found above {Path.cwd()}. "
              "Run /fusion:setup at the project root first.", file=sys.stderr)
        sys.exit(1)
    return Path(res.stdout.strip())


def parse_frontmatter(path: Path) -> dict[str, str]:
    out = {k: "" for k in ("From", "To", "Re", "Filed")}
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i >= 20:
                    break
                m = FM_RE.match(line.strip())
                if m:
                    out[m.group(1)] = m.group(2).strip()
    except OSError:
        pass
    return out


def iter_unread(root: Path):
    bus = root / "fusion-workbench" / "bus"
    if not bus.is_dir():
        return
    for inbox in sorted(bus.glob("*/inbox")):
        if not inbox.is_dir():
            continue
        agent = inbox.parent.name
        for entry in sorted(inbox.iterdir(), key=lambda p: p.name):
            if entry.is_file() and entry.suffix == ".md":
                yield agent, entry


def find_message(root: Path, stem: str):
    needle = stem.lower()
    return [(a, p) for a, p in iter_unread(root) if needle in p.name.lower()]


def _candidates_to_stderr(matches) -> None:
    print(f"{PROG}: multiple matches:", file=sys.stderr)
    for agent, path in matches:
        print(f"  {agent}  {path.name}", file=sys.stderr)


def cmd_list(root: Path) -> int:
    rows = []
    for agent, path in iter_unread(root):
        fm = parse_frontmatter(path)
        mt = _dt.datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y-%m-%d %H:%M")
        re_val = fm["Re"]
        if len(re_val) > 70:
            re_val = re_val[:67] + "..."
        rows.append((path.stat().st_mtime, agent, path.name, fm["From"], re_val, mt))
    if not rows:
        print("no unread bus messages")
        return 0
    rows.sort(key=lambda r: (r[0], r[2]))
    headers = ("agent", "filename", "from", "re", "filed")
    table = [(a, fn, frm, rv, mt) for (_, a, fn, frm, rv, mt) in rows]
    widths = [max(len(h), max(len(r[i]) for r in table)) for i, h in enumerate(headers)]
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    print(fmt.format(*headers))
    print(fmt.format(*("-" * w for w in widths)))
    for r in table:
        print(fmt.format(*r))
    return 0


def cmd_show(root: Path, stem: str) -> int:
    matches = find_message(root, stem)
    if not matches:
        print(f"{PROG}: no message matching '{stem}'", file=sys.stderr)
        return 1
    if len(matches) > 1:
        _candidates_to_stderr(matches)
        return 1
    _, path = matches[0]
    print(str(path))
    print()
    sys.stdout.write(path.read_text(encoding="utf-8", errors="replace"))
    return 0


def cmd_mark_read(root: Path, stem: str) -> int:
    matches = find_message(root, stem)
    if len(matches) > 1:
        _candidates_to_stderr(matches)
        return 1
    if matches:
        _, src = matches[0]
        dst = src.parent / ".processed" / src.name
        dst.parent.mkdir(parents=True, exist_ok=True)
        try:
            os.rename(src, dst)
            print(f"moved: {src.name} -> .processed/")
            return 0
        except FileNotFoundError:
            if dst.exists():
                print(f"already marked read by another party: {src.name}")
                return 0
            print(f"{PROG}: no message matching '{stem}'", file=sys.stderr)
            return 1
    # No unread match — see if already in any .processed/ (dual-write tolerance).
    needle = stem.lower()
    bus = root / "fusion-workbench" / "bus"
    if bus.is_dir():
        for processed in sorted(bus.glob("*/inbox/.processed")):
            for entry in processed.iterdir():
                if entry.is_file() and entry.suffix == ".md" and needle in entry.name.lower():
                    print(f"already marked read by another party: {entry.name}")
                    return 0
    print(f"{PROG}: no message matching '{stem}'", file=sys.stderr)
    return 1


# ---------------------------------------------------------------------------
# Daemon lifecycle (start | stop | status)
# ---------------------------------------------------------------------------
#
# These subcommands manage `bin/fusion-bus-daemon`. The daemon owns the state
# file `bus/.daemon-state.json` and the PID file `bus/.daemon.pid`; this
# helper only spawns/signals/reads them. See Path D Step B2 in the plan.


def _pid_alive(pid: int) -> bool:
    """Return True if `pid` exists; mirrors fusion-bus-daemon's pid_alive."""
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        # PID exists but is owned by another user — still alive.
        return True


def _read_pid_file(pid_path: Path) -> int | None:
    """Parse bus/.daemon.pid (JSON `{"pid": N, ...}`); return None on failure."""
    try:
        with pid_path.open("r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None
    if isinstance(data, dict) and isinstance(data.get("pid"), int):
        return data["pid"]
    return None


def _daemon_binary_path() -> Path:
    """Sibling `bin/fusion-bus-daemon` next to this script."""
    return Path(__file__).resolve().parent / "fusion-bus-daemon"


def cmd_daemon_start(root: Path, foreground: bool) -> int:
    bus = root / "fusion-workbench" / "bus"
    pid_path = bus / ".daemon.pid"
    log_path = bus / ".daemon.log"
    daemon_bin = _daemon_binary_path()

    if not daemon_bin.exists():
        print(f"{PROG}: daemon binary not found at {daemon_bin}", file=sys.stderr)
        return 1

    # Conflict detection: PID file present?
    if pid_path.exists():
        existing_pid = _read_pid_file(pid_path)
        if existing_pid is not None and _pid_alive(existing_pid):
            print(f"daemon already running (PID {existing_pid})", file=sys.stderr)
            return 1
        # Stale PID file — daemon crashed without cleanup.
        print(
            f"stale PID file detected (PID {existing_pid} dead); "
            "clearing and starting fresh",
            file=sys.stderr,
        )
        try:
            pid_path.unlink()
        except FileNotFoundError:
            pass

    bus.mkdir(parents=True, exist_ok=True)

    if foreground:
        # Hand off to the daemon binary directly. os.execv replaces this
        # process; nothing below runs on success.
        os.execv(str(daemon_bin), [str(daemon_bin)])
        # Unreachable.
        return 1

    # Background launch: redirect stdout/stderr into the daemon log.
    try:
        log_fh = log_path.open("a", encoding="utf-8")
    except OSError as exc:
        print(f"{PROG}: cannot open daemon log {log_path}: {exc}", file=sys.stderr)
        return 1
    try:
        proc = subprocess.Popen(
            [str(daemon_bin)],
            stdout=log_fh,
            stderr=log_fh,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except OSError as exc:
        log_fh.close()
        print(f"{PROG}: failed to launch daemon: {exc}", file=sys.stderr)
        return 1
    finally:
        # Parent does not need the log fd; the child inherits its own copy.
        log_fh.close()

    # Wait briefly for the daemon to write its PID file.
    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        if pid_path.exists():
            launched_pid = _read_pid_file(pid_path)
            if launched_pid is not None:
                print(f"daemon started (PID {launched_pid})")
                return 0
        # Detect early crash so we don't loop the full 2s for nothing.
        if proc.poll() is not None:
            print(
                f"{PROG}: daemon exited immediately with status {proc.returncode}; "
                f"see {log_path.relative_to(root)} for details",
                file=sys.stderr,
            )
            return 1
        time.sleep(0.05)

    # Timed out. The daemon may still be coming up — report the spawn PID
    # so the user has something to investigate.
    print(
        f"{PROG}: daemon launched (PID {proc.pid}) but did not write "
        f"{pid_path.relative_to(root)} within 2s",
        file=sys.stderr,
    )
    return 1


def cmd_daemon_stop(root: Path) -> int:
    bus = root / "fusion-workbench" / "bus"
    pid_path = bus / ".daemon.pid"

    if not pid_path.exists():
        print("daemon not running")
        return 0

    pid = _read_pid_file(pid_path)
    if pid is None:
        print(f"{PROG}: PID file present but unreadable; removing", file=sys.stderr)
        try:
            pid_path.unlink()
        except FileNotFoundError:
            pass
        return 1

    if not _pid_alive(pid):
        # Stale PID file — daemon already gone. Treat as success.
        try:
            pid_path.unlink()
        except FileNotFoundError:
            pass
        print(f"daemon stopped (PID {pid})")
        return 0

    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        try:
            pid_path.unlink()
        except FileNotFoundError:
            pass
        print(f"daemon stopped (PID {pid})")
        return 0
    except PermissionError as exc:
        print(f"{PROG}: cannot signal PID {pid}: {exc}", file=sys.stderr)
        return 1

    # Wait up to 5s for the PID to disappear.
    deadline = time.monotonic() + 5.0
    while time.monotonic() < deadline:
        if not _pid_alive(pid):
            # The daemon's shutdown path unlinks the PID file itself, but
            # guard against an orphaned file just in case.
            if pid_path.exists():
                try:
                    pid_path.unlink()
                except FileNotFoundError:
                    pass
            print(f"daemon stopped (PID {pid})")
            return 0
        time.sleep(0.2)

    # Escalate to SIGKILL.
    print(
        f"{PROG}: daemon (PID {pid}) did not exit after SIGTERM; sending SIGKILL",
        file=sys.stderr,
    )
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except PermissionError as exc:
        print(f"{PROG}: cannot SIGKILL PID {pid}: {exc}", file=sys.stderr)
        return 1

    # One more grace second after SIGKILL.
    deadline = time.monotonic() + 1.0
    while time.monotonic() < deadline:
        if not _pid_alive(pid):
            break
        time.sleep(0.1)

    if pid_path.exists():
        try:
            pid_path.unlink()
        except FileNotFoundError:
            pass
    print(f"daemon stopped (PID {pid})")
    return 0


def cmd_daemon_status(root: Path) -> int:
    bus = root / "fusion-workbench" / "bus"
    state_path = bus / ".daemon-state.json"
    pid_path = bus / ".daemon.pid"

    state_exists = state_path.exists()
    pid_exists = pid_path.exists()

    if not state_exists and not pid_exists:
        print("daemon not running (no state file, no PID file)")
        return 1
    if state_exists and not pid_exists:
        print(
            "daemon not running (state file present but no PID file — "
            "daemon was never started or shut down cleanly)"
        )
        return 1

    # PID file present. (state-missing-but-PID-present falls through too —
    # report what we can and note the missing state.)
    pid = _read_pid_file(pid_path)
    alive = _pid_alive(pid) if pid is not None else False

    state: dict = {}
    if state_exists:
        try:
            with state_path.open("r", encoding="utf-8") as fh:
                loaded = json.load(fh)
            if isinstance(loaded, dict):
                state = loaded
        except (OSError, json.JSONDecodeError):
            state = {}

    recent = state.get("recent_routes")
    recent_count = len(recent) if isinstance(recent, list) else 0

    print(f"PID:             {pid if pid is not None else 'unknown'}")
    print(f"running:         {'yes' if alive else 'no'}")
    print(f"mode:            {state.get('mode', 'unknown')}")
    print(f"started_at:      {state.get('started_at', 'unknown')}")
    print(f"pending_count:   {state.get('pending_count', 0)}")
    print(f"last_route_at:   {state.get('last_route_at') or 'never'}")
    print(f"recent_routes:   {recent_count}")

    # Exit 0 only when the daemon is actually running; otherwise 1 so
    # scripts can tell the difference.
    return 0 if alive else 1


# ---------------------------------------------------------------------------
# Control IPC (pending | approve | deny | pause | resume | mode)
# ---------------------------------------------------------------------------
#
# These subcommands speak to `bin/fusion-bus-daemon` through two files:
#   - `bus/.daemon-state.json`  — read-only sanity check (running?)
#   - `bus/.daemon-cmd.json`    — single-command queue we write into
#
# The schemas are defined in `rules/fusion-workbench-conventions.md`
# `## Bus protocol` → `### Path D — daemon and control IPC`. Per the plan,
# `pending` works regardless of daemon state because it just reads
# `.pending/*.json`. Every other control subcommand checks daemon state
# first and exits 1 with "daemon not running — start it with
# 'fusion-bus daemon start'" when absent or paused.


def _now_utc() -> str:
    """RFC-3339 UTC timestamp with `Z` suffix — matches the daemon's format."""
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _filed_by() -> str:
    return os.environ.get("USER", "unknown") or "unknown"


def _read_daemon_state(root: Path) -> dict | None:
    """Load `bus/.daemon-state.json`; return None on missing/unreadable/invalid."""
    state_path = root / "fusion-workbench" / "bus" / ".daemon-state.json"
    if not state_path.exists():
        return None
    try:
        with state_path.open("r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def _require_running_daemon(root: Path) -> bool:
    """Enforce the "control commands need a running daemon" rule.

    Returns True when the daemon is running per `.daemon-state.json`. Returns
    False after printing the canonical message to stderr — caller should
    `return 1`. Used by every control subcommand except `pending`.
    """
    state = _read_daemon_state(root)
    if state is None or not state.get("running"):
        print(
            f"{PROG}: daemon not running — start it with "
            "'fusion-bus daemon start'",
            file=sys.stderr,
        )
        return False
    return True


def _pending_dir(root: Path) -> Path:
    return root / "fusion-workbench" / "bus" / ".pending"


def _list_pending(root: Path) -> list[Path]:
    """Return all `.pending/*.json` paths (no sort imposed here)."""
    pending = _pending_dir(root)
    if not pending.is_dir():
        return []
    return [p for p in pending.iterdir() if p.is_file() and p.suffix == ".json"]


def _match_pending(root: Path, stem: str) -> list[Path]:
    """Case-insensitive basename substring match across `.pending/*.json`.

    Returns the list of matching paths (callers decide how to handle 0 / 1 /
    multiple). The stem is matched against the filename including the
    `.json` suffix, mirroring how `cmd_show` / `cmd_mark_read` match against
    inbox files — the user can use either the full msg-id or any unique
    fragment of it.
    """
    needle = stem.lower()
    return [p for p in _list_pending(root) if needle in p.name.lower()]


def _atomic_write_json(path: Path, payload: dict) -> None:
    """temp-write-and-rename, matching the daemon's atomic_write_json."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    with tmp.open("w", encoding="utf-8") as fh:
        json.dump(payload, fh, indent=2, sort_keys=False)
        fh.write("\n")
    os.rename(tmp, path)


def _write_cmd_file(root: Path, payload: dict) -> Path:
    """File a single command for the daemon.

    Writes `bus/.daemon-cmd.json` if available, otherwise retries with
    `.daemon-cmd.1.json`, `.daemon-cmd.2.json`, ... until a free name is
    found. The daemon globs `.daemon-cmd*.json` oldest-mtime-first each
    tick, so the suffix is purely a collision-avoidance device — execution
    order follows file-creation order. Uses `os.open` with `O_CREAT|O_EXCL`
    to atomically reserve the name, then rewrites via the standard
    temp-write-and-rename pattern so partial JSON is never visible.
    """
    bus = root / "fusion-workbench" / "bus"
    bus.mkdir(parents=True, exist_ok=True)
    seq = 0
    while True:
        if seq == 0:
            target = bus / ".daemon-cmd.json"
        else:
            target = bus / f".daemon-cmd.{seq}.json"
        try:
            # Atomically claim the filename; abort the open immediately.
            fd = os.open(str(target), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except FileExistsError:
            seq += 1
            continue
        os.close(fd)
        # Now atomically rewrite with the real payload (the daemon may not
        # tolerate an empty placeholder if it polls between the touch and
        # the rewrite, so we rename a fully-formed file over the top).
        _atomic_write_json(target, payload)
        return target


def _candidates_pending_to_stderr(matches: list[Path]) -> None:
    print(f"{PROG}: multiple matches:", file=sys.stderr)
    for path in matches:
        print(f"  {path.stem}", file=sys.stderr)


def cmd_pending(root: Path) -> int:
    """Print a table of `.pending/*.json` entries, sorted by `queued_at`.

    Reads each JSON record's `msg_id`, `target_agent`, `from`, `re`, and
    `queued_at` fields. Files that fail to parse are skipped silently —
    they're transient (the daemon's atomic_write_json briefly leaves a
    `.tmp.<pid>` sibling). Independent of daemon state.
    """
    rows = []
    for path in _list_pending(root):
        try:
            with path.open("r", encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
        if not isinstance(data, dict):
            continue
        rows.append((
            str(data.get("queued_at", "")),
            str(data.get("msg_id", path.stem)),
            str(data.get("target_agent", "")),
            str(data.get("from", "")),
            str(data.get("re", "")),
        ))
    if not rows:
        print("no pending bus messages")
        return 0
    # Sort by queued_at (string sort works for RFC-3339 UTC), then msg_id.
    rows.sort(key=lambda r: (r[0], r[1]))
    headers = ("msg_id", "target", "from", "re", "queued_at")
    # Trim long `re` for table width.
    table = []
    for queued, mid, tgt, frm, re_val in rows:
        if len(re_val) > 70:
            re_val = re_val[:67] + "..."
        table.append((mid, tgt, frm, re_val, queued))
    widths = [max(len(h), max(len(r[i]) for r in table)) for i, h in enumerate(headers)]
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    print(fmt.format(*headers))
    print(fmt.format(*("-" * w for w in widths)))
    for r in table:
        print(fmt.format(*r))
    return 0


def _resolve_pending_stem(root: Path, stem: str) -> str | None:
    """Substring-match into `.pending/` and return the full msg-id.

    Returns the canonical msg-id (file stem minus `.json`) when there is
    exactly one match. Returns None and prints to stderr in the no-match /
    ambiguous case — callers `return 1`.
    """
    matches = _match_pending(root, stem)
    if not matches:
        print(f"{PROG}: no pending message matching '{stem}'", file=sys.stderr)
        return None
    if len(matches) > 1:
        _candidates_pending_to_stderr(matches)
        return None
    return matches[0].stem


def cmd_approve(root: Path, stem: str) -> int:
    if not _require_running_daemon(root):
        return 1
    msg_id = _resolve_pending_stem(root, stem)
    if msg_id is None:
        return 1
    payload = {
        "cmd": "approve",
        "arg": msg_id,
        "filed_by": _filed_by(),
        "filed_at": _now_utc(),
    }
    _write_cmd_file(root, payload)
    print(f"filed approve command for {msg_id} (daemon will pick up on next tick)")
    return 0


def cmd_deny(root: Path, stem: str, reason: str | None) -> int:
    if not _require_running_daemon(root):
        return 1
    msg_id = _resolve_pending_stem(root, stem)
    if msg_id is None:
        return 1
    payload = {
        "cmd": "deny",
        "arg": msg_id,
        "reason": (reason or "no reason given").strip() or "no reason given",
        "filed_by": _filed_by(),
        "filed_at": _now_utc(),
    }
    _write_cmd_file(root, payload)
    print(f"filed deny command for {msg_id} (daemon will pick up on next tick)")
    return 0


def cmd_pause(root: Path) -> int:
    if not _require_running_daemon(root):
        return 1
    _write_cmd_file(root, {
        "cmd": "pause",
        "filed_by": _filed_by(),
        "filed_at": _now_utc(),
    })
    print("filed pause command (daemon will pick up on next tick)")
    return 0


def cmd_resume(root: Path) -> int:
    if not _require_running_daemon(root):
        return 1
    _write_cmd_file(root, {
        "cmd": "resume",
        "filed_by": _filed_by(),
        "filed_at": _now_utc(),
    })
    print("filed resume command (daemon will pick up on next tick)")
    return 0


def cmd_mode(root: Path, mode: str) -> int:
    if mode not in VALID_MODES:
        print(
            f"{PROG}: invalid mode '{mode}'; expected one of "
            f"{', '.join(VALID_MODES)}",
            file=sys.stderr,
        )
        return 2
    if not _require_running_daemon(root):
        return 1
    _write_cmd_file(root, {
        "cmd": "set-mode",
        "arg": mode,
        "filed_by": _filed_by(),
        "filed_at": _now_utc(),
    })
    print(f"filed set-mode command (mode={mode}; daemon will pick up on next tick)")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog=PROG, description="Inspect the fusion workbench bus.")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="List unread messages across all inboxes.")
    for name, helptext in (("show", "Print message contents."),
                           ("mark-read", "Move message into .processed/.")):
        sp = sub.add_parser(name, help=helptext)
        sp.add_argument("stem", help="Case-insensitive substring of the message filename.")

    daemon_parser = sub.add_parser(
        "daemon", help="Manage the bus router daemon (start | stop | status)."
    )
    daemon_sub = daemon_parser.add_subparsers(dest="daemon_cmd", required=True)
    daemon_start = daemon_sub.add_parser(
        "start", help="Launch fusion-bus-daemon (background by default)."
    )
    daemon_start.add_argument(
        "--foreground",
        action="store_true",
        help="Exec the daemon in place instead of forking to background.",
    )
    daemon_sub.add_parser("stop", help="Signal the daemon to exit cleanly.")
    daemon_sub.add_parser("status", help="Report PID, mode, and queue stats.")

    sub.add_parser("pending", help="Table of pending injections (.pending/*.json).")
    approve_p = sub.add_parser(
        "approve", help="File an approve command for a .pending/ entry."
    )
    approve_p.add_argument(
        "stem", help="Case-insensitive substring of the pending msg-id."
    )
    deny_p = sub.add_parser("deny", help="File a deny command for a .pending/ entry.")
    deny_p.add_argument(
        "stem", help="Case-insensitive substring of the pending msg-id."
    )
    deny_p.add_argument(
        "--reason", default=None,
        help="Denial reason recorded with the command (default: 'no reason given').",
    )
    sub.add_parser("pause", help="File a pause command.")
    sub.add_parser("resume", help="File a resume command.")
    mode_p = sub.add_parser(
        "mode", help="File a set-mode command (strict | observe | silent)."
    )
    mode_p.add_argument(
        "mode_value",
        metavar="mode",
        choices=VALID_MODES,
        help="Target mode (validated against the closed set).",
    )

    args = parser.parse_args(argv)
    root = resolve_root()
    if args.cmd == "list":
        return cmd_list(root)
    if args.cmd == "show":
        return cmd_show(root, args.stem)
    if args.cmd == "mark-read":
        return cmd_mark_read(root, args.stem)
    if args.cmd == "daemon":
        if args.daemon_cmd == "start":
            return cmd_daemon_start(root, foreground=args.foreground)
        if args.daemon_cmd == "stop":
            return cmd_daemon_stop(root)
        if args.daemon_cmd == "status":
            return cmd_daemon_status(root)
    if args.cmd == "pending":
        return cmd_pending(root)
    if args.cmd == "approve":
        return cmd_approve(root, args.stem)
    if args.cmd == "deny":
        return cmd_deny(root, args.stem, args.reason)
    if args.cmd == "pause":
        return cmd_pause(root)
    if args.cmd == "resume":
        return cmd_resume(root)
    if args.cmd == "mode":
        return cmd_mode(root, args.mode_value)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
