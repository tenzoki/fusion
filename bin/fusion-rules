#!/usr/bin/env bash
# fusion-rules — list rule files an agent must read during Setup
#
# Usage: fusion-rules <agent-name> [<topic>]
#
# Prints one path per line. Searches three locations in order:
#   1. The plugin's rules/        (via $FUSION_PLUGIN_ROOT, set by SessionStart)
#   2. The project's ./rules/     (fusion-agent-specific rules)
#   3. The project's .claude/rules/ (project-wide rules every Claude session
#                                    should respect — coding guidelines,
#                                    ontology rules, normative guides, etc.)
# Missing files or directories are skipped silently — the agent reads
# whatever is present.
#
# Convention for the project-side split:
#   - ./rules/        — rules only fusion agents care about (capture layouts,
#                       taskplanner priority overrides, ontology-review
#                       heuristics — anything that has no meaning outside a
#                       fusion-agent context).
#   - .claude/rules/  — binding project guidelines that any Claude instance
#                       should follow (the same rules a developer running
#                       plain Claude Code in this repo would respect).
#
# Convention for filename patterns:
#   - Every agent reads agent-setup.md FIRST (shipped by plugin) — the single
#     authoring home for the Setup contract: "read every emitted path", the
#     fusion-paths KEY=value / OUT_* vs SCAN_* semantics (incl. the two-
#     directories-per-SCAN_* nuance and the exit-3/exit-4 distinction), the
#     generalised pattern-kind clause, and the universal voice-profile-read
#     instruction. Emitted before fusion-workbench-conventions.md so an agent
#     reads "how Setup works" before the detailed conventions.
#   - Every agent reads fusion-workbench-conventions.md (shipped by plugin).
#   - Every agent also reads decision-record-examples.md (shipped by plugin) —
#     the worked examples of [o]→[a]→[i], [a]→[s], [o]→[d] transitions are
#     small and useful for any agent that touches decision records.
#   - Every agent also reads user-facing-output.md (shipped by plugin) —
#     mandates action-first ordering, plain-English option labels, no
#     undefined jargon, and trailing details/references blocks for any
#     output the user reads.
#   - Every agent also reads critical-stance.md (shipped by plugin) —
#     three epistemic norms governing reasoning substance (not formatting):
#     own your errors instead of praising the user, no premature/half-baked
#     solutions, and calibrated certainty (verified vs inference vs speculation).
#   - Every agent also reads git-branch-discipline.md (shipped by plugin) —
#     agents never switch git branches autonomously. The rule is enforced
#     deterministically by hooks/guard.ts (git is reachable only via Bash);
#     the doc explains why (branch-drift chaos) and what to do instead
#     (STOP → Human Gate → ask the user; the env overrides are user-only).
#   - Every agent also reads protected-path-discipline.md (shipped by plugin) —
#     the sibling Bash policy: a shell command that WRITES a path in
#     guard.protectedPaths (mv/rm/cp/sed -i/redirection, wrappers seen through,
#     ancestor directories, cd tracked, fail-closed on an unresolvable operand)
#     is denied by hooks/guard.ts the same way Edit/Write are. The doc states
#     what is denied, what stays allowed, what to do instead (STOP → Human
#     Gate; there is no override for this one), and the residuals honestly.
#   - Design-diagram agents additionally read design-diagrams.md (shipped by
#     plugin) — the doctrine for expressing technical design as formal,
#     parseable Mermaid (when / which type, validity, coherence self-check).
#     Recipients: planner, analyst, taskplanner, shaper, investigator (the
#     producers) plus conceptrev (the independent evaluator that judges
#     produced diagrams by the same shared rubric).
#   - Domain agents additionally match filename patterns:
#       coder, coderev, bugfixer  → *coding*.md
#       ontocoder, ontorev        → *ontology*.md, *normative*.md, *verb*.md
#       planner                   → *coding*.md, *ontology*.md
#       investigator              → *investigator*.md (project must supply
#                                   its capture-layout description, e.g.
#                                   ./rules/investigator-capture-layout.md;
#                                   see templates/investigator-capture-layout.md)
#   - All other agents get workbench-conventions only. The conventions-only
#     set currently includes: orchestrator, shaper, taskplanner, reconciler,
#     analyst, consultant, playmaker, conceptrev, editor.
#
# Optional topic-scoped loading (the context manifest):
#   A consuming project MAY add ./rules/context-manifest.yaml to load large
#   knowledge bodies per-agent AND per-topic instead of always-on. When that
#   file is ABSENT, this helper's output is BYTE-IDENTICAL to what it was before
#   the manifest convention existed — for every agent, with or without a topic
#   argument. The manifest read and the topic argument are both additive and
#   both no-op when the file is absent (HYG-NO-REGRESS). All manifest emission
#   below is gated on the file existing, so the no-manifest path is unchanged.
#
#   When the manifest is present, the helper additionally emits the units whose
#   agent set matches this agent AND whose topic set matches the resolved topic:
#     - a `path` unit emits its file path (an agent reads it, as today);
#     - a `skill` unit emits a `skill:<name>` pointer line (invoked on demand).
#   The topic is resolved (see resolve_topics below): an explicit CLI <topic>
#   argument wins; otherwise it is derived from the active Circle — an explicit
#   `Topic:`/`Tags:` line on the Circle record, else the Circle slug's keywords;
#   with no active Circle, only `[always]` units match. A malformed manifest
#   fails LOUDLY with exit 3 rather than silently emitting a partial set
#   (HYG-NO-SILENT-FAIL). The full schema, predicate, and resolution order are
#   authored once in rules/context-manifest.md.
#
# Exit codes: 0 success; 1 usage error; 2 unknown agent; 3 malformed manifest.
#   - Long-form-prose agents additionally receive the project's stylometric
#     voice profile path so they can apply it to narrative outputs (session
#     summary bodies, consultation replies, analysis reports, investigator
#     timelines, playmaker briefings, prose sections of specs and plans,
#     editor deliverables):
#       orchestrator, consultant, shaper, planner, analyst, investigator,
#       playmaker, conceptrev, editor
#     Language is resolved from CLAUDE.md's `**Language:** <lang>` line
#     (silently defaults to `en`). The emitted path is
#     ./fusion-workbench/stilwerk/default-voice-<lang>.yaml. If the declared
#     language's profile is missing and the language is not `en`, the helper
#     falls back to default-voice-en.yaml. If neither file exists, the helper
#     emits nothing — the agent's Setup logs the absence in its history file.

set -eu

AGENT="${1:-}"
TOPIC="${2:-}"
if [ -z "$AGENT" ]; then
  echo "Usage: $0 <agent-name> [<topic>]" >&2
  exit 1
fi

# Resolve the script's own directory so we can reach sibling helpers
# (fusion-workbench-root, used only when a manifest is present).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"

case "$AGENT" in
  coder|coderev|bugfixer)        PATTERNS="coding" ;;
  ontocoder|ontorev)              PATTERNS="ontology normative verb" ;;
  planner)                        PATTERNS="coding ontology" ;;
  investigator)                   PATTERNS="investigator" ;;
  orchestrator|shaper|taskplanner|reconciler|analyst|consultant|playmaker|conceptrev|editor)
                                  PATTERNS="" ;;
  *)
    echo "fusion-rules: unknown agent '$AGENT'" >&2
    exit 2
    ;;
esac

# Prose-agent flag — independent of PATTERNS. The nine agents below produce
# long-form narrative output that the stylometric profile governs.
case "$AGENT" in
  orchestrator|consultant|shaper|planner|analyst|investigator|playmaker|conceptrev|editor)
                                  IS_PROSE_AGENT=1 ;;
  *)                              IS_PROSE_AGENT=0 ;;
esac

# Design-diagram-agent flag — independent of PATTERNS. These agents produce
# technical-design documents whose structure is expressed as formal parseable
# Mermaid (planner, analyst, taskplanner, shaper, investigator), plus the
# conceptrev evaluator that judges those diagrams. All read the shared rubric
# in rules/design-diagrams.md so producer and evaluator use one definition of
# "coherent".
case "$AGENT" in
  planner|analyst|taskplanner|shaper|investigator|conceptrev)
                                  IS_DIAGRAM_AGENT=1 ;;
  *)                              IS_DIAGRAM_AGENT=0 ;;
esac

emit_if_exists() {
  [ -f "$1" ] && printf '%s\n' "$1"
}

emit_pattern_in_dir() {
  # $1 = directory, $2 = pattern
  local dir="$1" pat="$2" f
  [ -d "$dir" ] || return 0
  # Use a nullglob-safe loop: enable nullglob, restore after.
  local had_nullglob=0
  if shopt -q nullglob 2>/dev/null; then had_nullglob=1; fi
  shopt -s nullglob 2>/dev/null || true
  for f in "$dir"/*"$pat"*.md; do
    printf '%s\n' "$f"
  done
  [ "$had_nullglob" -eq 1 ] || shopt -u nullglob 2>/dev/null || true
}

resolve_lang_code() {
  # Resolve the project's prose language from CLAUDE.md's `**Language:**` line.
  #
  # Language source: the first line in ./CLAUDE.md matching
  #   ^\*\*Language:\*\* *([a-z]{2})
  # case-sensitive, two lowercase letters. Valid values: en, de. Anything else
  # (no CLAUDE.md, no match, invalid value) falls through to "en".
  # Prints the resolved two-letter code on stdout.
  local claude_md="./CLAUDE.md"
  local extracted=""
  if [ -f "$claude_md" ]; then
    extracted=$(grep -E '^\*\*Language:\*\* *[a-z]{2}' "$claude_md" 2>/dev/null \
                | head -n 1 \
                | sed -E 's/^\*\*Language:\*\* *([a-z]{2}).*/\1/')
  fi
  case "$extracted" in
    en|de) printf '%s\n' "$extracted" ;;
    *)     printf '%s\n' "en" ;;
  esac
}

emit_voice_profile() {
  # Emit the stylometric profile path for a given profile family, resolved to
  # the project's declared language.
  #
  #   $1 = profile stem, e.g. "default-voice" (long-form writing) or
  #        "chat-voice" (short-form chat).
  #
  # Resolution: ./fusion-workbench/stilwerk/${stem}-${lang}.yaml
  # If the file exists, emit it. If it does not and lang != en, fall back to
  # ${stem}-en.yaml and emit that if present. Otherwise emit nothing silently —
  # the agent's Setup notes the absence in its history file.
  local stem="$1"
  local stilwerk_dir="./fusion-workbench/stilwerk"
  local lang_code; lang_code=$(resolve_lang_code)
  local profile="$stilwerk_dir/${stem}-${lang_code}.yaml"
  if [ -f "$profile" ]; then
    printf '%s\n' "$profile"
    return 0
  fi
  if [ "$lang_code" != "en" ]; then
    local fallback="$stilwerk_dir/${stem}-en.yaml"
    [ -f "$fallback" ] && printf '%s\n' "$fallback"
  fi
  return 0
}

resolve_topics() {
  # Print the space-separated set of topics in effect for this call. May be
  # empty (only `[always]` units then match). Called ONLY when a manifest is
  # present, so it adds no subprocess cost to the no-manifest path.
  #
  # Resolution order (documented in rules/context-manifest.md):
  #   1. Explicit CLI <topic> argument (commas accepted) — overrides the Circle.
  #   2. An explicit `Topic:`/`Tags:` line on the active Circle's record.
  #   3. The active Circle's slug keywords (dir name minus the YYMMDD-HHMM- stamp).
  #   4. No active Circle → empty.
  if [ -n "$TOPIC" ]; then
    printf '%s' "$TOPIC" | tr ',' ' '
    return 0
  fi

  local proot wb pointer cname record tagline
  proot="$("$SCRIPT_DIR/fusion-workbench-root" 2>/dev/null)" || return 0
  wb="$proot/fusion-workbench"
  pointer="$wb/.active-circle"
  [ -f "$pointer" ] || return 0
  cname="$(head -n 1 "$pointer" | tr -d '\r' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  [ -n "$cname" ] || return 0
  case "$cname" in */*|.|..) return 0 ;; esac
  [ -d "$wb/circles/$cname" ] || return 0

  # 2. Explicit tag on the Circle record. The record is _<marker>_circle.md;
  #    find it without a no-match-fatal glob (zsh nomatch discipline).
  record="$(find "$wb/circles/$cname" -mindepth 1 -maxdepth 1 -name '_*_circle.md' -type f 2>/dev/null | head -n 1)"
  if [ -n "$record" ]; then
    tagline="$(grep -iE '^[[:space:]]*(\*\*)?(topic|tags)(\*\*)?[[:space:]]*:' "$record" 2>/dev/null | head -n 1 || true)"
    if [ -n "$tagline" ]; then
      printf '%s' "$tagline" \
        | sed -E 's/^[^:]*:[[:space:]]*//; s/#.*$//; s/\*\*//g; s/[][]//g; s/,/ /g' \
        | tr -s '[:space:]' ' ' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
      return 0
    fi
  fi

  # 3. Slug keywords.
  printf '%s' "$cname" | sed -E 's/^[0-9]{6}-[0-9]{4}-//' | tr '-' ' '
}

PLUGIN_RULES_DIR="${FUSION_PLUGIN_ROOT:-}/rules"
PROJECT_RULES_DIR="./rules"
PROJECT_CLAUDE_RULES_DIR=".claude/rules"

# 1. Always emit the framework ground-truth rules. agent-setup.md goes first so
#    an agent reads "how Setup works" before the detailed conventions.
emit_if_exists "$PLUGIN_RULES_DIR/agent-setup.md"
emit_if_exists "$PLUGIN_RULES_DIR/fusion-workbench-conventions.md"
emit_if_exists "$PLUGIN_RULES_DIR/decision-record-examples.md"
emit_if_exists "$PLUGIN_RULES_DIR/user-facing-output.md"
emit_if_exists "$PLUGIN_RULES_DIR/critical-stance.md"
emit_if_exists "$PLUGIN_RULES_DIR/git-branch-discipline.md"
emit_if_exists "$PLUGIN_RULES_DIR/protected-path-discipline.md"

# 1a. Every agent receives the project's chat voice profile (short-form output
#     style: gate prompts, AskUserQuestion text, status reports, chat replies).
#     Resolved from CLAUDE.md's `**Language:**` line. Not gated on prose — every
#     agent produces some user-facing chat. The semantics ("apply its blacklist
#     to short-form output") live in rules/user-facing-output.md, which every
#     agent already reads.
emit_voice_profile "chat-voice"

# 1b. Long-form-prose agents additionally receive the writing voice profile
#     (long-form narrative outputs), resolved from the same `**Language:**` line.
if [ "$IS_PROSE_AGENT" -eq 1 ]; then
  emit_voice_profile "default-voice"
fi

# 1c. Design-diagram agents (the five producers + the conceptrev evaluator)
#     receive the diagram doctrine: when / which Mermaid type, the
#     parseable-form requirement, and the coherence self-check heuristics.
#     Shared rubric so producer and evaluator judge by one definition.
if [ "$IS_DIAGRAM_AGENT" -eq 1 ]; then
  emit_if_exists "$PLUGIN_RULES_DIR/design-diagrams.md"
fi

# 2. Domain patterns — plugin first, then fusion-agent-specific project rules,
#    then project-wide rules in .claude/rules/. Order is read-order, not
#    precedence: agents read every emitted path. Layered intentionally so a
#    consuming project can extend the plugin's defaults without overriding.
for pat in $PATTERNS; do
  emit_pattern_in_dir "$PLUGIN_RULES_DIR" "$pat"
  emit_pattern_in_dir "$PROJECT_RULES_DIR" "$pat"
  emit_pattern_in_dir "$PROJECT_CLAUDE_RULES_DIR" "$pat"
done

# 3. Optional topic-scoped manifest. Everything below is gated on the manifest
#    file existing, so the no-manifest path emitted exactly today's set above
#    and stops here — BYTE-IDENTICAL (HYG-NO-REGRESS). The parser is awk (no
#    YAML runtime dependency), matching the "minimal and greppable" schema.
MANIFEST="$PROJECT_RULES_DIR/context-manifest.yaml"
if [ -f "$MANIFEST" ]; then
  RESOLVED_TOPICS="$(resolve_topics)"

  # Parse and filter the manifest. awk prints matching units on stdout and, on a
  # malformed manifest, a reason on stderr with a non-zero exit. Output is
  # all-or-nothing: units are collected and printed only in END, so a malformed
  # file yields no partial set. `if !` keeps `set -e` from aborting here.
  if ! MANIFEST_UNITS="$(awk -v agent="$AGENT" -v topics="$RESOLVED_TOPICS" '
    function fail(msg) {
      print "fusion-rules: malformed context-manifest.yaml: " msg > "/dev/stderr"
      malformed = 1
      exit 1
    }
    function reset_unit() {
      cur_kind = ""; cur_val = ""; nAG = 0; nTP = 0
      cur_has_agents = 0; cur_has_topics = 0
    }
    function parse_array(s,   inner, parts, k, tok, n) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      if (s !~ /^\[.*\]$/) return -1
      inner = substr(s, 2, length(s) - 2)
      PN = 0
      n = split(inner, parts, ",")
      for (k = 1; k <= n; k++) {
        tok = parts[k]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", tok)
        gsub(/^["'"'"']|["'"'"']$/, "", tok)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", tok)
        if (tok == "") continue
        PA[++PN] = tok
      }
      return PN
    }
    function finalize(   i, amatch, tmatch) {
      if (cur_kind == "") return
      if (!cur_has_agents) fail("unit \x27" cur_val "\x27 is missing \x27agents:\x27")
      if (!cur_has_topics) fail("unit \x27" cur_val "\x27 is missing \x27topics:\x27")
      amatch = 0
      for (i = 1; i <= nAG; i++) if (AG[i] == "*" || AG[i] == agent) { amatch = 1; break }
      if (!amatch) return
      tmatch = 0
      for (i = 1; i <= nTP; i++) {
        if (TP[i] == "always") { tmatch = 1; break }
        if (TP[i] in TOPIC) { tmatch = 1; break }
      }
      if (!tmatch) return
      if (cur_kind == "path") OUT[++nOUT] = cur_val
      else OUT[++nOUT] = "skill:" cur_val
    }
    BEGIN {
      n = split(topics, TT, " ")
      for (i = 1; i <= n; i++) if (TT[i] != "") TOPIC[TT[i]] = 1
      nOUT = 0; saw_content = 0; saw_units = 0; malformed = 0
      reset_unit()
    }
    {
      if ($0 ~ /^[[:space:]]*#/) next
      if ($0 ~ /^[[:space:]]*$/) next
      line = $0
      sub(/[[:space:]]+#.*$/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line ~ /^[[:space:]]*$/) next
      saw_content = 1

      if (line ~ /^[[:space:]]*units[[:space:]]*:/) {
        saw_units = 1
        rest = line
        sub(/^[[:space:]]*units[[:space:]]*:[[:space:]]*/, "", rest)
        if (rest != "" && rest != "[]")
          fail("\x27units:\x27 must head a block list, not an inline value: " rest)
        next
      }

      if (line ~ /^[[:space:]]*-[[:space:]]+/) {
        finalize()
        reset_unit()
        item = line
        sub(/^[[:space:]]*-[[:space:]]+/, "", item)
        ci = index(item, ":")
        if (ci == 0) fail("list item is not a key: value pair: " line)
        key = substr(item, 1, ci - 1); val = substr(item, ci + 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
        gsub(/^["'"'"']|["'"'"']$/, "", val)
        if (key == "path" || key == "skill") {
          cur_kind = key; cur_val = val
          if (cur_val == "") fail("unit \x27" key "\x27 has an empty value")
        } else {
          fail("a unit must begin with \x27path:\x27 or \x27skill:\x27, found \x27- " key ":\x27")
        }
        next
      }

      if (cur_kind == "") fail("indented key outside any unit: " line)
      ci = index(line, ":")
      if (ci == 0) fail("expected \x27key: value\x27, got: " line)
      key = substr(line, 1, ci - 1); val = substr(line, ci + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      if (key == "agents") {
        if (parse_array(val) < 0) fail("agents: is not a [ ... ] array: " val)
        nAG = PN; for (i = 1; i <= PN; i++) AG[i] = PA[i]; cur_has_agents = 1
      } else if (key == "topics") {
        if (parse_array(val) < 0) fail("topics: is not a [ ... ] array: " val)
        nTP = PN; for (i = 1; i <= PN; i++) TP[i] = PA[i]; cur_has_topics = 1
      } else if (key == "path" || key == "skill") {
        fail("\x27" key ":\x27 must be the list item (\x27- " key ": ...\x27), not an indented key")
      }
      next
    }
    END {
      if (malformed) exit 1
      finalize()
      if (malformed) exit 1
      if (saw_content && !saw_units) {
        print "fusion-rules: malformed context-manifest.yaml: no top-level \x27units:\x27 key" > "/dev/stderr"
        exit 1
      }
      for (i = 1; i <= nOUT; i++) print OUT[i]
    }
  ' "$MANIFEST")"; then
    # awk already explained the fault on stderr. Exit 3 = malformed manifest.
    exit 3
  fi

  # An `if` (not `&&`): when the unit set is empty this must still exit 0. A
  # trailing `[ -n "" ] && …` would leave a false status as the script's last
  # command and exit 1 on a valid but empty/no-match manifest.
  if [ -n "$MANIFEST_UNITS" ]; then
    printf '%s\n' "$MANIFEST_UNITS"
  fi
fi
