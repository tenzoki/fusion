#!/usr/bin/env bash
# fusion-rules — list rule files an agent must read during Setup
#
# Usage: fusion-rules <agent-name> [<topic>] [--audience=user]
#
# Prints one path per line. Searches three locations in order:
#   1. The plugin's rules/        (via $FUSION_PLUGIN_ROOT, set by SessionStart;
#                                  in the fusion plugin's OWN source repo the
#                                  work tree's ./rules is read instead — see
#                                  the repo-context block below)
#   2. The project's ./rules/     (fusion-agent-specific rules)
#   3. The project's .claude/rules/ (project-wide rules every Claude session
#                                    should respect — coding guidelines,
#                                    ontology rules, normative guides, etc.)
# Missing files or directories are skipped silently — the agent reads
# whatever is present.
#
# Convention for the project-side split:
#   - ./rules/        — rules only fusion agents care about (capture layouts,
#                       review priority overrides, ontology-review
#                       heuristics — anything that has no meaning outside a
#                       fusion-agent context).
#   - .claude/rules/  — binding project guidelines that any Claude instance
#                       should follow (the same rules a developer running
#                       plain Claude Code in this repo would respect).
#
# Convention for filename patterns:
#   - Every agent reads agent-setup.md FIRST (shipped by plugin) — the single
#     authoring home for the Setup contract: "read every emitted path", the
#     fusion-paths KEY=value / OUT_* vs SCAN_* semantics (incl. the two-
#     directories-per-SCAN_* nuance and the exit-3/exit-4 distinction), the
#     generalised pattern-kind clause, and the universal voice-profile-read
#     instruction. Emitted before fusion-workbench-conventions.md so an agent
#     reads "how Setup works" before the detailed conventions.
#   - Every agent reads fusion-workbench-conventions.md (shipped by plugin).
#   - The decision-transition agents (orchestrator, shaper, planner,
#     reconciler) additionally read decision-record-examples.md —
#     the worked marker transitions; audience decided at 260827-0830_*_do-the-decision-record-worked-examples-stay-on-the-always-on-floor.md, when
#     the always-on floor could no longer carry the tutorial.
#   - The user-read agents (orchestrator, consultant, shaper, editor,
#     curator) additionally read user-facing-output.md — the full
#     user-facing style contract (gate 260827-0910_*_does-every-dispatch-carry-the-full-user-facing-style-contract.md); everyone else carries
#     the chat profile's anti-patterns via agent-setup.md. This is the ONE
#     emission a dispatch can also ask for by hand, with `--audience=user`; the
#     name list above is the fallback and nothing else here reads the flag.
#   - Every agent also reads critical-stance.md (shipped by plugin) —
#     the epistemic norms governing reasoning substance (not formatting):
#     own your errors, no premature solutions, calibrated certainty, case
#     splits disjoint-and-complete, cardinalities enumerated or derived.
#   - Two files from the conventions partition are emitted to no agent at all:
#     workbench-path-resolution.md and rule-file-provenance.md, the authoring
#     homes for prompt/resolver authoring and for rule-file writing, reached by
#     pointer from fusion-workbench-conventions.md. A third, circle-records.md,
#     went with the Circle container itself.
#   - The review-writing agent (reviewer) additionally reads
#     review-contract.md (shipped by plugin) — the single authoring home of the
#     review file's two mandated header fields, the per-topic working files and
#     the final consolidated review. The audience is the one agent that writes
#     review files; every other agent would be carrying a contract it can never
#     apply.
#   - Design-diagram agents additionally read design-diagrams.md (shipped by
#     plugin) — the doctrine for expressing technical design as formal,
#     parseable Mermaid (when / which type, validity, coherence self-check).
#     Recipients: planner, analyst, shaper — the agents that
#     produce the diagrams.
#   - Domain agents additionally match filename patterns:
#       coder                     → *coding*.md
#       ontocoder                 → *ontology*.md, *normative*.md, *verb*.md
#       reviewer                  → both sets, because one agent covers both
#                                   review domains
#       planner                   → *coding*.md, *ontology*.md
#   - The editor additionally reads project-language.md (decision 260827-1056_*_which-parts-of-the-language-and-backlog-rules-does-every-dispatch-still-carry.md);
#     agents matching none of the conditions above get the always-on core alone.
#
# Optional topic-scoped loading (the context manifest):
#   A consuming project MAY add ./rules/context-manifest.yaml to load large
#   knowledge bodies per-agent AND per-topic instead of always-on. When that
#   file is ABSENT, this helper's output is BYTE-IDENTICAL to what it was before
#   the manifest convention existed — for every agent, with or without a topic
#   argument. The manifest read and the topic argument are both additive and
#   both no-op when the file is absent (HYG-NO-REGRESS). All manifest emission
#   below is gated on the file existing, so the no-manifest path is unchanged.
#
#   When the manifest is present, the helper additionally emits the units whose
#   agent set matches this agent AND whose topic set matches the resolved topic:
#     - a `path` unit emits its file path (an agent reads it, as today);
#     - a `skill` unit emits a `skill:<name>` pointer line (invoked on demand).
#   The topic is resolved (see resolve_topics below): an explicit CLI <topic>
#   argument wins; otherwise it is derived from the work item this checkout has
#   claimed — an explicit `Topic:`/`Tags:` line in the item, else the item
#   filename's slug keywords; with nothing claimed here, only `[always]` units
#   match. A malformed manifest fails LOUDLY with exit 3 rather than silently
#   emitting a partial set (HYG-NO-SILENT-FAIL). The full schema, predicate, and
#   resolution order are authored once in rules/context-manifest.md.
#
# Exit codes: 0 success; 1 usage error (no agent, an unknown option, an
#   unrecognised --audience value, or a third positional); 2 unknown agent;
#   3 malformed manifest.
#   - Two stylometric profile families, each resolved from its OWN declaration
#     in CLAUDE.md:
#       chat-voice-<lang>.yaml     — emitted for EVERY agent, for short-form
#                                    chat output. Language: the `**Language:**`
#                                    line.
#       default-voice-<lang>.yaml  — emitted for the long-form-prose agents only
#                                    (orchestrator, consultant, shaper, planner,
#                                    analyst, editor, curator), for
#                                    narrative outputs:
#                                    session summary bodies, consultation
#                                    replies, analysis reports including
#                                    failure timelines,
#                                    prose sections of specs and plans, editor
#                                    deliverables. Language: the
#                                    `**Artifact language:**` line.
#     What the two declarations name is a boundary by SURFACE, not by length:
#     output the user reads in the terminal is the chat language, output that
#     persists as a file is the artifact language. Authored once in
#     rules/fusion-workbench-conventions.md `## Project language`; the routing
#     here is a consequence of that boundary, not a second definition of it.
#
#     The fallback chain is one rule with no special cases. `**Artifact
#     language:**` absent, unparseable, or carrying anything other than `en` or
#     `de` all mean the same thing — not declared — and then `**Language:**`
#     governs both families. `**Language:**` not declared, by the same test,
#     means `en`. Both fallbacks are silent.
#
#     A project that declares only `**Language:**` therefore emits exactly what
#     this helper emitted before the second declaration existed: ARTIFACT_LANG
#     resolves to CHAT_LANG, so both families receive the very code the old
#     single resolution produced, and the only added work is a second grep of
#     CLAUDE.md, which prints nothing. BYTE-IDENTICAL (HYG-NO-REGRESS) — the
#     same promise the manifest block above makes for its own addition, and
#     locked the same way: hooks/lib/__tests__/rules-voice-profile.test.ts was
#     written and run green against the pre-split script.
#
#     The missing-variant fallback is PER FAMILY and unchanged: if the resolved
#     language's file is missing and that language is not `en`, the helper falls
#     back to <stem>-en.yaml. If neither file of a family exists, the helper
#     emits nothing for it — the agent's Setup logs the absence in its history
#     file.

set -eu

# Argument parsing. Two positionals — the agent name and an optional topic — plus
# one optional flag, `--audience=user`, which may stand anywhere after the agent.
# The flag is scanned out first so that `fusion-rules planner --audience=user`
# and `fusion-rules planner "" --audience=user` are the same call; the plan's
# verification uses the second form and a reader should not have to know which
# one the parser wants.
#
# WHY AN AUDIENCE ARGUMENT AT ALL. Every other conditional emission in this file
# is keyed on the agent NAME, which answers "what is this role always". It cannot
# answer "who reads this particular run's output", and a role that is user-facing
# on some dispatches and not on others inherits the whole user-facing style
# contract on every one of them. `--audience=user` is that second question, asked
# of the dispatch instead of the roster. Decision
# 260909-1843_*_what-are-the-conditional-rule-emissions-keyed-on-once-they-are-not-keyed-on-the-agent-name.md,
# option 1, scoped deliberately to `user-facing-output.md` and to nothing else:
# the other conditionals stay keyed on the name.
#
# ONLY `user` IS A VALUE. An unrecognised value and an unrecognised flag are both
# exit 1 rather than a silent ignore: a misspelt `--audience=users` that quietly
# emitted nothing would look exactly like a correct call whose rule file is
# missing, and the agent would never learn which it had (HYG-NO-SILENT-FAIL).
AUDIENCE_USER=0
AGENT=""
TOPIC=""
POSITIONAL=0
for arg in "$@"; do
  case "$arg" in
    --audience=*)
      case "${arg#--audience=}" in
        user) AUDIENCE_USER=1 ;;
        *)
          echo "fusion-rules: unknown audience '${arg#--audience=}' (only 'user' is defined)" >&2
          exit 1
          ;;
      esac
      ;;
    --*)
      echo "fusion-rules: unknown option '$arg'" >&2
      exit 1
      ;;
    *)
      POSITIONAL=$((POSITIONAL + 1))
      case "$POSITIONAL" in
        1) AGENT="$arg" ;;
        2) TOPIC="$arg" ;;
        *)
          echo "fusion-rules: too many arguments" >&2
          exit 1
          ;;
      esac
      ;;
  esac
done

if [ -z "$AGENT" ]; then
  echo "Usage: $0 <agent-name> [<topic>] [--audience=user]" >&2
  exit 1
fi

# Resolve the script's own directory so we can reach sibling helpers
# (fusion-plugin-cwd always; fusion-workbench-root only when a manifest is
# present).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"

# Repo-context criterion: is cwd the fusion plugin's own source repo? Decided
# by the sibling helper bin/fusion-plugin-cwd, which is the only cwd-anchored
# implementation of that criterion (hooks/lib/self-detect.ts keeps the
# root-anchored form, `isFusionPluginRoot(dir)`, and no cwd entry point; the
# helper's own header documents the split). One consequence
# below, and it does not touch a consuming project: the plugin rule set is read
# from the WORK TREE's ./rules instead of $FUSION_PLUGIN_ROOT/rules (see
# PLUGIN_RULES_DIR). In the plugin's own repo the source is the meant state,
# while $FUSION_PLUGIN_ROOT pins to the installed copy for the whole session and
# can be days stale against the rules being edited. Decision
# 260806-0015_*_veraltete-regeln-im-eigenen-repo-melden-oder-umgehen, option c.
if "$SCRIPT_DIR/fusion-plugin-cwd"; then
  IN_PLUGIN_REPO=1
else
  IN_PLUGIN_REPO=0
fi

case "$AGENT" in
  coder)                          PATTERNS="coding" ;;
  ontocoder)                      PATTERNS="ontology normative verb" ;;
  # The reviewer covers both domains in one agent, so it takes both pattern
  # sets: a code pass needs the project's coding rules and an ontology pass its
  # ontology, normative and verb rules. The plugin ships none of these, so in
  # this repository the union costs 0 bytes; in a consuming project it is what
  # keeps an ontology review from running without the heuristics that bind it.
  reviewer)                       PATTERNS="coding ontology normative verb" ;;
  planner)                        PATTERNS="coding ontology" ;;
  # `analyst` carries its own pattern so a SMALL project-local rule reaches it by
  # filename, the way ./rules/investigator-*.md reached the investigator before
  # step 8 of Circle 260815-0007-remove-eight-mechanisms-and-cap-growth folded that agent in here. Deliberately the one
  # bare token `analyst` and not also `analysis`: `*analysis*.md` would sweep up a
  # project's own gap-analysis or impact-analysis documents, which are subject
  # matter rather than agent configuration. The context manifest stays the
  # documented route for anything larger or topic-scoped, so the two routes split
  # by SIZE and the manifest is not duplicated here. An orphaned
  # ./rules/investigator-capture-layout.md does NOT match this pattern and is not
  # meant to: docs/upgrading-to-v9.md §4 tells such a project to rename it or
  # register it in the manifest. Decision
  # 260815-1845_*_does-analyst-get-a-project-local-rule-pattern-now-that-the-investigator-fold-orphaned-one.md,
  # option 3 (both), answered by the user 2026-08-20.
  analyst)                        PATTERNS="analyst" ;;
  orchestrator|shaper|reconciler|consultant|editor|curator)
                                  PATTERNS="" ;;
  *)
    echo "fusion-rules: unknown agent '$AGENT'" >&2
    exit 2
    ;;
esac

# Prose-agent flag — independent of PATTERNS. The agents below produce
# long-form narrative output that the stylometric profile governs.
case "$AGENT" in
  orchestrator|consultant|shaper|planner|analyst|editor|curator)
                                  IS_PROSE_AGENT=1 ;;
  *)                              IS_PROSE_AGENT=0 ;;
esac

# Design-diagram-agent flag — independent of PATTERNS. These agents produce
# technical-design documents whose structure is expressed as formal parseable
# Mermaid. They read the shared rubric in rules/design-diagrams.md so that one
# definition of "coherent" governs every diagram the plugin's agents draw.
case "$AGENT" in
  planner|analyst|shaper)         IS_DIAGRAM_AGENT=1 ;;
  *)                              IS_DIAGRAM_AGENT=0 ;;
esac

# Review-writing-agent flag — independent of PATTERNS. The one agent that writes
# review files reads rules/review-contract.md: the two mandated header fields,
# the per-topic working files and the final consolidated review. The audience is
# bounded by a mechanism rather than a guess — a review file is what
# bin/fusion-review-coverage tiles, and the REVIEW_SENDERS constant in
# hooks/lib/review-coverage.ts names the same sender. The two review kinds were
# two agents until v11, and the constant still recognises their old segments so
# that review files already on disk keep parsing. Every other agent would carry
# a contract it can never apply.
case "$AGENT" in
  reviewer)                       IS_REVIEWER_AGENT=1 ;;
  *)                              IS_REVIEWER_AGENT=0 ;;
esac

# Decision-transition-agent flag — the agents that perform or plan decision
# marker transitions and therefore read the worked examples (audience decided
# at the 260827-0830_*_do-the-decision-record-worked-examples-stay-on-the-always-on-floor.md user gate; the vocabulary itself stays always-on).
case "$AGENT" in
  orchestrator|shaper|planner|reconciler) IS_DECISION_TRANSITION_AGENT=1 ;;
  *)                                                IS_DECISION_TRANSITION_AGENT=0 ;;
esac

# User-facing-agent flag — the agents whose output the user reads DIRECTLY:
# the orchestrator (gates, status, chat), consultant (replies), shaper
# (clarification rounds), editor (deliverable chat) and curator (the gate ledger
# reports). They carry the full user-facing style contract.
#
# **Five names, where the decision that keyed this block named three.** Its
# recommendation and the commit that landed it each said "orchestrator, editor
# and curator". The list carried six before that commit and five after
# `playmaker` was deleted; the commit never touched it, so three was never the
# code. The list is right and the two records under-counted
# (260910-2020_*_the-user-facing-fallback-list-is-five-where-the-answered-decision-says-three.md):
# `consultant` is user-initiated and answers the user with no orchestrator
# between them, and `shaper` runs user-direct with its rounds relayed verbatim.
# Narrowing to three would put both behind a `--audience=user` line nobody
# passes there — a behaviour change, not a text repair. The rest, which
# report to the orchestrator, do not — and reach the file on the dispatches where
# they do hold a gate through `--audience=user`, which is the second key below: measured before
# the 260827-0910_*_does-every-dispatch-carry-the-full-user-facing-style-contract.md user gate, they took ~95 % of all dispatches and carried
# 20 KB of gate-prompt and chat-format doctrine per dispatch without ever
# holding a gate or a chat. Their replacement is two sentences in
# agent-setup.md: the chat profile's anti-patterns still bind every line a
# human may read, and a report's audience is the dispatcher.
case "$AGENT" in
  orchestrator|consultant|shaper|editor|curator) IS_USER_FACING_AGENT=1 ;;
  *)                                                       IS_USER_FACING_AGENT=0 ;;
esac

emit_if_exists() {
  # Explicit return 0 on a missing file: the documented contract is "missing
  # files are skipped silently" (rules/agent-setup.md), and under `set -eu` a
  # bare `[ -f ] && printf` returns 1 on a miss and kills the emission
  # mid-stream with partial output.
  [ -f "$1" ] || return 0
  printf '%s\n' "$1"
}

emit_pattern_in_dir() {
  # $1 = directory, $2 = pattern
  local dir="$1" pat="$2" f
  [ -d "$dir" ] || return 0
  # Use a nullglob-safe loop: enable nullglob, restore after.
  local had_nullglob=0
  if shopt -q nullglob 2>/dev/null; then had_nullglob=1; fi
  shopt -s nullglob 2>/dev/null || true
  for f in "$dir"/*"$pat"*.md; do
    printf '%s\n' "$f"
  done
  [ "$had_nullglob" -eq 1 ] || shopt -u nullglob 2>/dev/null || true
}

declared_lang() {
  # Print the two-letter language code one CLAUDE.md declaration carries, or
  # print nothing when it declares none.
  #
  #   $1 = declaration label, e.g. "Language" or "Artifact language".
  #        Interpolated unescaped into an ERE and into a `sed` address, so the
  #        label must be a metacharacter-free literal. Both call sites are.
  #
  # Source: the first line in ./CLAUDE.md whose start is `**<label>:**`,
  # case-sensitive, with the label interpolated. The rest of that line, minus
  # the separating spaces and any trailing whitespace, is the declared VALUE,
  # and the value is matched WHOLE against the supported set below. Valid
  # values: en, de. No CLAUDE.md, no matching line, and an unsupported value all
  # print nothing — one branch, so a caller's single default covers every "not
  # declared" case at once and neither declaration needs an error path.
  #
  # Whole-value matching is the point, and the extraction is deliberately
  # ignorant of what the supported values are. An earlier version captured
  # `([a-z]{2})` and let `.*` eat the remainder, which made the test a PREFIX
  # test: `deutsch`, `denmark` and `de-DE` each resolved to `de`, so a value
  # naming no language fusion supports silently selected the German writing
  # profile for every artifact. The supported set lives in exactly one place —
  # the `case` below — and the extractor hands it a candidate rather than
  # pre-truncating one into shape. Adding a third language means editing that
  # `case` and nothing else.
  #
  # The default deliberately does NOT live here. The two call sites default
  # differently (chat -> `en`, artifact -> whatever the chat language resolved
  # to), and standing side by side there the difference between them is legible.
  # One function, one job: this one extracts, it does not decide.
  local label="$1"
  local claude_md="./CLAUDE.md"
  local extracted=""
  if [ -f "$claude_md" ]; then
    # The pipeline's exit status is sed's, which succeeds on empty input, so a
    # CLAUDE.md carrying no matching line does not trip `set -e`.
    #
    # The trailing `[[:space:]]*$` strip is not cosmetic: it is what keeps
    # `**Language:** de ` and a CRLF file's `de\r` resolving to `de`, as they
    # did while `.*` was swallowing them.
    extracted=$(grep -E "^\*\*$label:\*\*" "$claude_md" 2>/dev/null \
                | head -n 1 \
                | sed -E "s/^\*\*$label:\*\* *//; s/[[:space:]]*\$//")
  fi
  case "$extracted" in
    en|de) printf '%s\n' "$extracted" ;;
    *)     ;;
  esac
}

emit_voice_profile() {
  # Emit the stylometric profile path for one profile family in one language.
  #
  #   $1 = profile stem, e.g. "default-voice" (long-form writing) or
  #        "chat-voice" (short-form chat).
  #   $2 = the two-letter language code, already resolved by the caller.
  #
  # Resolution: ./fusion-workbench/stilwerk/${stem}-${lang}.yaml
  # If the file exists, emit it. If it does not and lang != en, fall back to
  # ${stem}-en.yaml and emit that if present. Otherwise emit nothing silently —
  # the agent's Setup notes the absence in its history file. The fallback is per
  # family: each family falls back within itself, never onto the other's file.
  #
  # This function resolves no language of its own. Which declaration governs a
  # family is the call site's decision, and it is visible there.
  #
  # THE FALLBACK ANNOUNCES ITSELF ON STANDARD ERROR, and only that branch does.
  # Stdout is one path per line, so a fallback and a project that declared `en`
  # arrive there identically: an agent instructed to record the fallback could
  # not detect the event it was told to record. The notice makes it DETECTABLE,
  # which is what a mechanism change owes. It does not make the recording
  # happen: whether the agent then writes the history line stays an
  # instruction-following obligation, and this project has documented such
  # obligations as overridable under load (`rules/critical-stance.md`, the
  # closing note of §4). Do not read this notice as compliance.
  #
  # Stdout is untouched in every case, and the gate that holds that is
  # `hooks/lib/__tests__/rules-voice-profile.test.ts`, its two cases that drive
  # this script in a fixture project: one with `de` declared and the chat
  # profile removed, asserting stdout is exactly the fallback path plus the
  # writing profile and stderr exactly the one notice line, and one with `en`
  # resolved directly, asserting stderr is empty. The emission golden
  # (`rules-emission-golden.test.ts`) cannot observe this function at all: it
  # runs from an empty working directory, where both `[ -f ]` guards fail and
  # nothing is emitted on either stream (issue 260821-0142_*_the-voice-profile-fallback-commit-cites-a-golden-that-cannot-observe-the-code-it-changed.md). That contract is
  # why the signal goes to the other stream rather than into a new line format.
  # English, per `rules/fusion-workbench-conventions.md` `## Project language`:
  # CLI operator strings are an exempt surface.
  local stem="$1"
  local lang_code="$2"
  local stilwerk_dir="./fusion-workbench/stilwerk"
  local profile="$stilwerk_dir/${stem}-${lang_code}.yaml"
  if [ -f "$profile" ]; then
    printf '%s\n' "$profile"
    return 0
  fi
  if [ "$lang_code" != "en" ]; then
    local fallback="$stilwerk_dir/${stem}-en.yaml"
    if [ -f "$fallback" ]; then
      printf '%s\n' "$fallback"
      printf 'fusion-rules: voice profile %s: requested variant %s is absent, resolved to en\n' \
        "$stem" "$lang_code" >&2
    fi
  fi
  return 0
}

resolve_topics() {
  # Print the space-separated set of topics in effect for this call. May be
  # empty (only `[always]` units then match). Called ONLY when a manifest is
  # present, so it adds no subprocess cost to the no-manifest path.
  #
  # Resolution order (documented in rules/context-manifest.md):
  #   1. Explicit CLI <topic> argument (commas accepted) — overrides the item.
  #   2. An explicit `Topic:`/`Tags:` line in the work item this checkout has
  #      claimed.
  #   3. That item's slug keywords (basename minus the YYMMDD-HHMM- stamp and
  #      the .md suffix).
  #   4. Nothing claimed by this checkout → empty.
  #
  # The source moved from the active Circle to the claimed item when the Circle
  # container was cut, and the shape of the answer moved with it. A Circle was a
  # pointer file: one read, and every session in the checkout saw the same
  # topic. A claim is a field on an item and it names a CHECKOUT, so what is
  # resolved here is "what is this checkout working on", compared by equality on
  # the eight hex characters bin/fusion-identity prints. An item another
  # checkout claimed is not this checkout's topic, and an unclaimed store is a
  # real answer of "no topic" rather than a failure.
  if [ -n "$TOPIC" ]; then
    printf '%s' "$TOPIC" | tr ',' ' '
    return 0
  fi

  local proot wb store checkout item tagline base
  proot="$("$SCRIPT_DIR/fusion-workbench-root" 2>/dev/null)" || return 0
  wb="$proot/fusion-workbench"

  # The one store a work item lives in. Named here rather than resolved through
  # bin/fusion-paths because that resolver derives a key set from a CONSUMER
  # PROMPT, and this helper is not a consumer — it has no prompt of its own to
  # derive from, and asking under somebody else's name would make one agent's
  # key set decide another agent's topic.
  store="$wb/shared/backlog"
  [ -d "$store" ] || return 0

  # This checkout's identifier. bin/fusion-identity is the one place a run
  # obtains it; an install that predates the helper, or a workbench where the
  # identifier cannot be read at all, resolves no topic rather than guessing
  # one. Guarded with [ -x ] per decision 260810-0921_*_how-should-a-prompt-call-a-bin-helper-that-the-installed-copy-may-not-have.md.
  [ -x "$SCRIPT_DIR/fusion-identity" ] || return 0
  checkout="$("$SCRIPT_DIR/fusion-identity" 2>/dev/null | sed -n 's/^CHECKOUT=//p' | head -n 1)"
  [ -n "$checkout" ] || return 0

  # The claimed item: **Status:** claimed AND a **Claim:** whose first field is
  # this checkout. Both are tested, because a Status that says claimed with no
  # Claim beside it names no holder and a Claim left on a `done` item names a
  # holder who has finished. `find` drives the loop so an empty store yields no
  # input rather than an unexpanded glob.
  item=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    grep -qE '^\*\*Status:\*\*[[:space:]]*claimed[[:space:]]*$' "$f" 2>/dev/null || continue
    grep -qE "^\*\*Claim:\*\*[[:space:]]*$checkout([[:space:]]|$)" "$f" 2>/dev/null || continue
    item="$f"
    break
  done <<EOF
$(find "$store" -mindepth 1 -maxdepth 1 -name '*.md' -type f 2>/dev/null | sort)
EOF
  [ -n "$item" ] || return 0

  # 2. Explicit tag in the item.
  tagline="$(grep -iE '^[[:space:]]*(\*\*)?(topic|tags)(\*\*)?[[:space:]]*:' "$item" 2>/dev/null | head -n 1 || true)"
  if [ -n "$tagline" ]; then
    printf '%s' "$tagline" \
      | sed -E 's/^[^:]*:[[:space:]]*//; s/#.*$//; s/\*\*//g; s/[][]//g; s/,/ /g' \
      | tr -s '[:space:]' ' ' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
    return 0
  fi

  # 3. Slug keywords.
  base="$(basename "$item" .md)"
  printf '%s' "$base" | sed -E 's/^[0-9]{6}-[0-9]{4}-//' | tr '-' ' '
}

if [ "$IN_PLUGIN_REPO" -eq 1 ]; then
  # In the plugin's own repo, prefer the work tree's rule set over the
  # installed copy (see the repo-context block above). $PWD rather than ".":
  # the emitted paths are read later by agents whose shell cwd resets between
  # calls, so they must survive a cwd change.
  PLUGIN_RULES_DIR="$PWD/rules"
else
  PLUGIN_RULES_DIR="${FUSION_PLUGIN_ROOT:-}/rules"
fi
PROJECT_RULES_DIR="./rules"
PROJECT_CLAUDE_RULES_DIR=".claude/rules"

# The project's two language declarations, resolved once, before anything is
# emitted. The defaults sit here rather than inside declared_lang so the one
# difference that matters is readable in two adjacent lines: the chat language
# falls back to English, the artifact language falls back to whatever the chat
# language resolved to. That second default is the whole backwards-compatibility
# story — a project declaring only `**Language:**` drives both profile families
# from it, exactly as the single pre-split resolution did.
CHAT_LANG="$(declared_lang 'Language')"
[ -n "$CHAT_LANG" ] || CHAT_LANG="en"
ARTIFACT_LANG="$(declared_lang 'Artifact language')"
[ -n "$ARTIFACT_LANG" ] || ARTIFACT_LANG="$CHAT_LANG"

# 1. Always emit the framework ground-truth rules. agent-setup.md goes first so
#    an agent reads "how Setup works" before the detailed conventions.
emit_if_exists "$PLUGIN_RULES_DIR/agent-setup.md"
emit_if_exists "$PLUGIN_RULES_DIR/fusion-workbench-conventions.md"
emit_if_exists "$PLUGIN_RULES_DIR/critical-stance.md"

# 1b3. The full user-facing style contract goes to the agents the user reads
#      directly (the IS_USER_FACING_AGENT case above; gate 260827-0910_*_does-every-dispatch-carry-the-full-user-facing-style-contract.md). For
#      everyone else, agent-setup.md `## Voice profiles` carries the two
#      sentences that still bind them.
#      Two keys, and the name is only the first of them. `--audience=user` is
#      the second: it asks the DISPATCH who reads this run's output, which the
#      roster cannot answer for a role that holds a gate on some dispatches and
#      reports to the orchestrator on others. Either key alone emits the file, so
#      a role that is user-facing by nature never loses it and only a role that
#      is not gains the ability to ask. Decision
#      260909-1843_*_what-are-the-conditional-rule-emissions-keyed-on-once-they-are-not-keyed-on-the-agent-name.md.
if [ "$IS_USER_FACING_AGENT" -eq 1 ] || [ "$AUDIENCE_USER" -eq 1 ]; then
  emit_if_exists "$PLUGIN_RULES_DIR/user-facing-output.md"
fi

# 1b2. The decision-marker WORKED EXAMPLES go to the agents that transition or
#      plan decision transitions: orchestrator, shaper, planner,
#      reconciler (worked transition 1, the _o_ -> _a_ rename, is its act).
#      Every agent still files records and still carries the marker VOCABULARY
#      (fusion-workbench-conventions.md, always-on); what leaves the always-on
#      floor is the tutorial. Audience change decided at the user gate,
#      `260827-0830_*_do-the-decision-record-worked-examples-stay-on-the-always-on-floor.md`,
#      when critical-stance §5 (decision 260826-1252_*_how-does-this-project-keep-a-cardinality-stated-in-prose-true-when-seven-passes-could-not.md) had to land on a floor
#      872 bytes past its hard budget. The pointer at the template site in
#      fusion-workbench-conventions.md is how every other agent reaches it.
if [ "$IS_DECISION_TRANSITION_AGENT" -eq 1 ]; then
  emit_if_exists "$PLUGIN_RULES_DIR/decision-record-examples.md"
fi

# 1a. Every agent receives the project's chat voice profile (short-form output
#     style: gate prompts, AskUserQuestion text, status reports, chat replies).
#     Resolved from the CHAT language, because every one of those surfaces is
#     read in the terminal and never persists. Not gated on prose — every agent
#     produces some user-facing chat. The semantics ("apply its blacklist to
#     short-form output") live in rules/user-facing-output.md, which every agent
#     already reads.
emit_voice_profile "chat-voice" "$CHAT_LANG"

# 1b. Long-form-prose agents additionally receive the writing voice profile
#     (long-form narrative outputs), resolved from the ARTIFACT language,
#     because every surface it governs is a file that persists. The two paths
#     may therefore name different languages; for a project whose chat and
#     artifacts differ that is the intended configuration, and rules/
#     agent-setup.md `## Voice profiles` tells the agent so.
if [ "$IS_PROSE_AGENT" -eq 1 ]; then
  emit_voice_profile "default-voice" "$ARTIFACT_LANG"
fi

# 1c. Design-diagram agents (the IS_DIAGRAM_AGENT case above) receive the diagram doctrine:
#     when / which Mermaid type, the parseable-form requirement, and the
#     coherence self-check heuristics. One shared rubric, so every producer
#     judges its own graph by the same definition.
if [ "$IS_DIAGRAM_AGENT" -eq 1 ]; then
  emit_if_exists "$PLUGIN_RULES_DIR/design-diagrams.md"
fi

# 1d. Two files from the conventions partition are emitted to NOBODY and so
#     appear nowhere below: rules/workbench-path-resolution.md (the resolver's
#     name namespace, key table and key-set derivation — read when authoring a
#     prompt or changing bin/fusion-paths) and rules/rule-file-provenance.md
#     (read when creating or editing a rule file). Neither is instruction for a
#     dispatched agent's routine work, and both are reached by the pointers left
#     at their sites in fusion-workbench-conventions.md. They live in rules/
#     rather than outside it because they remain the authoring home of their
#     topic — the emission decision is about audience, not about status.
#
# 1e. The orchestrator additionally receives the commit-lock protocol, whose
#     audience a mechanism bounds rather than a guess: the lock is taken by
#     whoever is about to commit, and among the agents that is the orchestrator.
#     The other agents keep the pointer line at `## Commit lock` in
#     fusion-workbench-conventions.md; the three that may commit directly carry
#     the lock instruction inline in their own prompts, and the two committing
#     skills carry it in their own bodies — skills reach rule text by direct
#     citation and this helper never serves them at all (it exits 2 on any
#     non-agent name).
#
#     A literal name test, not a flag: the audience is one agent, so a `case`
#     block would state the same thing in five lines instead of one.
if [ "$AGENT" = "orchestrator" ]; then
  emit_if_exists "$PLUGIN_RULES_DIR/commit-lock.md"
fi

# 1e2. One partitioned conventions topic goes to the one agent whose act it
#      governs (decision 260827-1056_*_which-parts-of-the-language-and-backlog-rules-does-every-dispatch-still-carry.md): the language cascade's full text to
#      the editor, whose deliverable-language halt lives in it. Its sibling from
#      that partition, the backlog maintenance mandate, was folded back into the
#      conventions when the work item replaced the Circle: the mandate is now
#      three sentences rather than a file, and the item grammar it sits beside is
#      always-on. The operative core stays always-on in
#      fusion-workbench-conventions.md.
if [ "$AGENT" = "editor" ]; then
  emit_if_exists "$PLUGIN_RULES_DIR/project-language.md"
fi

# 1f. The review-writing agent additionally receives the review contract.
#     It left the two review prompts of the day at v10.6.0, where the same
#     text stood twice with no pointer between the copies; those two prompts
#     themselves merged into agents/reviewer.md at v11, and one authoring home is
#     what keeps the two review kinds readable by one parser. See the
#     IS_REVIEWER_AGENT block above for the audience.
if [ "$IS_REVIEWER_AGENT" -eq 1 ]; then
  emit_if_exists "$PLUGIN_RULES_DIR/review-contract.md"
fi

# 2. Domain patterns — plugin first, then fusion-agent-specific project rules,
#    then project-wide rules in .claude/rules/. Order is read-order, not
#    precedence: agents read every emitted path. Layered intentionally so a
#    consuming project can extend the plugin's defaults without overriding.
for pat in $PATTERNS; do
  emit_pattern_in_dir "$PLUGIN_RULES_DIR" "$pat"
  # In the plugin's own repo, PLUGIN_RULES_DIR and PROJECT_RULES_DIR are the
  # same directory by construction ($PWD/rules vs ./rules) — skip the second
  # pass so a matching file is never emitted twice.
  if [ "$IN_PLUGIN_REPO" -eq 0 ]; then
    emit_pattern_in_dir "$PROJECT_RULES_DIR" "$pat"
  fi
  emit_pattern_in_dir "$PROJECT_CLAUDE_RULES_DIR" "$pat"
done

# 3. Optional topic-scoped manifest. Everything below is gated on the manifest
#    file existing, so the no-manifest path emitted exactly today's set above
#    and stops here — BYTE-IDENTICAL (HYG-NO-REGRESS). The parser is awk (no
#    YAML runtime dependency), matching the "minimal and greppable" schema.
MANIFEST="$PROJECT_RULES_DIR/context-manifest.yaml"
if [ -f "$MANIFEST" ]; then
  RESOLVED_TOPICS="$(resolve_topics)"

  # Parse and filter the manifest. awk prints matching units on stdout and, on a
  # malformed manifest, a reason on stderr with a non-zero exit. Output is
  # all-or-nothing: units are collected and printed only in END, so a malformed
  # file yields no partial set. `if !` keeps `set -e` from aborting here.
  if ! MANIFEST_UNITS="$(awk -v agent="$AGENT" -v topics="$RESOLVED_TOPICS" '
    function fail(msg) {
      print "fusion-rules: malformed context-manifest.yaml: " msg > "/dev/stderr"
      malformed = 1
      exit 1
    }
    function reset_unit() {
      cur_kind = ""; cur_val = ""; nAG = 0; nTP = 0
      cur_has_agents = 0; cur_has_topics = 0
    }
    function parse_array(s,   inner, parts, k, tok, n) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
      if (s !~ /^\[.*\]$/) return -1
      inner = substr(s, 2, length(s) - 2)
      PN = 0
      n = split(inner, parts, ",")
      for (k = 1; k <= n; k++) {
        tok = parts[k]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", tok)
        gsub(/^["'"'"']|["'"'"']$/, "", tok)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", tok)
        if (tok == "") continue
        PA[++PN] = tok
      }
      return PN
    }
    function finalize(   i, amatch, tmatch) {
      if (cur_kind == "") return
      if (!cur_has_agents) fail("unit \047" cur_val "\047 is missing \047agents:\047")
      if (!cur_has_topics) fail("unit \047" cur_val "\047 is missing \047topics:\047")
      amatch = 0
      for (i = 1; i <= nAG; i++) if (AG[i] == "*" || AG[i] == agent) { amatch = 1; break }
      if (!amatch) return
      tmatch = 0
      for (i = 1; i <= nTP; i++) {
        if (TP[i] == "always") { tmatch = 1; break }
        if (TP[i] in TOPIC) { tmatch = 1; break }
      }
      if (!tmatch) return
      if (cur_kind == "path") OUT[++nOUT] = cur_val
      else OUT[++nOUT] = "skill:" cur_val
    }
    BEGIN {
      n = split(topics, TT, " ")
      for (i = 1; i <= n; i++) if (TT[i] != "") TOPIC[TT[i]] = 1
      nOUT = 0; saw_content = 0; saw_units = 0; malformed = 0
      reset_unit()
    }
    {
      if ($0 ~ /^[[:space:]]*#/) next
      if ($0 ~ /^[[:space:]]*$/) next
      line = $0
      sub(/[[:space:]]+#.*$/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line ~ /^[[:space:]]*$/) next
      saw_content = 1

      if (line ~ /^[[:space:]]*units[[:space:]]*:/) {
        saw_units = 1
        rest = line
        sub(/^[[:space:]]*units[[:space:]]*:[[:space:]]*/, "", rest)
        if (rest != "" && rest != "[]")
          fail("\047units:\047 must head a block list, not an inline value: " rest)
        next
      }

      if (line ~ /^[[:space:]]*-[[:space:]]+/) {
        finalize()
        reset_unit()
        item = line
        sub(/^[[:space:]]*-[[:space:]]+/, "", item)
        ci = index(item, ":")
        if (ci == 0) fail("list item is not a key: value pair: " line)
        key = substr(item, 1, ci - 1); val = substr(item, ci + 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
        gsub(/^["'"'"']|["'"'"']$/, "", val)
        if (key == "path" || key == "skill") {
          cur_kind = key; cur_val = val
          if (cur_val == "") fail("unit \047" key "\047 has an empty value")
        } else {
          fail("a unit must begin with \047path:\047 or \047skill:\047, found \047- " key ":\047")
        }
        next
      }

      if (cur_kind == "") fail("indented key outside any unit: " line)
      ci = index(line, ":")
      if (ci == 0) fail("expected \047key: value\047, got: " line)
      key = substr(line, 1, ci - 1); val = substr(line, ci + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
      if (key == "agents") {
        if (parse_array(val) < 0) fail("agents: is not a [ ... ] array: " val)
        nAG = PN; for (i = 1; i <= PN; i++) AG[i] = PA[i]; cur_has_agents = 1
      } else if (key == "topics") {
        if (parse_array(val) < 0) fail("topics: is not a [ ... ] array: " val)
        nTP = PN; for (i = 1; i <= PN; i++) TP[i] = PA[i]; cur_has_topics = 1
      } else if (key == "path" || key == "skill") {
        fail("\047" key ":\047 must be the list item (\047- " key ": ...\047), not an indented key")
      }
      next
    }
    END {
      if (malformed) exit 1
      finalize()
      if (malformed) exit 1
      if (saw_content && !saw_units) {
        print "fusion-rules: malformed context-manifest.yaml: no top-level \047units:\047 key" > "/dev/stderr"
        exit 1
      }
      for (i = 1; i <= nOUT; i++) print OUT[i]
    }
  ' "$MANIFEST")"; then
    # awk already explained the fault on stderr. Exit 3 = malformed manifest.
    exit 3
  fi

  # An `if` (not `&&`): when the unit set is empty this must still exit 0. A
  # trailing `[ -n "" ] && …` would leave a false status as the script's last
  # command and exit 1 on a valid but empty/no-match manifest.
  if [ -n "$MANIFEST_UNITS" ]; then
    printf '%s\n' "$MANIFEST_UNITS"
  fi
fi
