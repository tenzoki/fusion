#!/usr/bin/env bash
# fusion-plugin-cwd — is the current working directory the fusion plugin's
# own source repo?
#
# Usage: fusion-plugin-cwd
#
# Exit 0 when ./.claude-plugin/plugin.json exists at cwd and its TOP-LEVEL
# "name" field is "fusion"; exit 1 otherwise. Prints nothing.
#
# This is the shell half of hooks/lib/self-detect.ts `isFusionPluginCwd()` —
# ONE criterion, TWO implementations (TS for the hooks, bash for the bin/
# helpers; there is no runtime the two could share). Keep them consistent:
# the TS parses the manifest and checks top-level `name === "fusion"`; the
# awk filter below reduces the manifest to its depth-1 tokens (string-aware,
# so braces inside quoted values don't shift the depth) before grepping, so
# a nested `"name": "fusion"` (an author object, a dependency entry) does
# NOT match — same answer as the TS. Residual imprecision vs JSON.parse:
# invalid JSON is scanned leniently rather than rejected, and a duplicate
# top-level "name" key matches if ANY occurrence is "fusion" (JSON.parse
# keeps the last). Both need a malformed manifest to differ.
# Change one, change the other.
#
# Consumers: bin/fusion-rules (work-tree rules preference + the guard-internals
# emission gate), bin/fusion-paths (work-tree prompt preference), and
# bin/fusion-source-root (which root a skill body's citation of a shipped FILE
# resolves against), per decision
# 260806-0015_*_veraltete-regeln-im-eigenen-repo-melden-oder-umgehen (option c)
# in the textschicht Circle. A new consumer adds itself here.
set -eu
manifest=".claude-plugin/plugin.json"
[ -f "$manifest" ] || exit 1
# Emit only the manifest's depth-1 characters: top-level keys and scalar
# values survive; nested objects/arrays (and their braces) are dropped.
awk '
{
  line = $0
  n = length(line)
  for (i = 1; i <= n; i++) {
    c = substr(line, i, 1)
    if (instr) {
      if (esc)            esc = 0
      else if (c == "\\") esc = 1
      else if (c == "\"") instr = 0
      if (depth == 1) out = out c
      continue
    }
    if (c == "\"") { instr = 1; if (depth == 1) out = out c; continue }
    if (c == "{" || c == "[") { depth++; continue }
    if (c == "}" || c == "]") { depth--; continue }
    if (depth == 1) out = out c
  }
  if (depth == 1) out = out " "
}
END { printf "%s\n", out }
' "$manifest" | grep -q '"name"[[:space:]]*:[[:space:]]*"fusion"'
