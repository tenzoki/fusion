#!/usr/bin/env bash
# fusion-plane — push-only, idempotent mirror of the fusion work queue into a
# Plane project, plus a bounded one-shot seeding read. Bash + curl + jq,
# reusing Martin's verified self-hosted Plane primitives (see MARTIN.md).
#
# THE MODEL (see the bounded-bridge plan): the mirror is one idempotent
# reconcile function plus trigger surfaces. reconcile(circle) reads the
# Circle's files (record, issues, decisions), computes the *desired* Plane
# state, diffs it against a persisted natural-key → Plane-UUID map, and issues
# the minimal create/update calls. Because desired state is a pure function of
# the files, running reconcile more or fewer times changes nothing — that one
# property delivers idempotency, offline rebuild-from-files, and never-silent
# deferral at once.
#
# Subcommands:
#   push [--circle <dir>|--all] [--plan] [--rebuild-map [--fixture <json>]]
#        [--closure]
#                     Reconcile one Circle (or all) into Plane. --plan is the
#                     dry-run seam (JSON op list, no curl). --rebuild-map
#                     reconstructs .plane-map.json from Plane before reconcile —
#                     the same rebuild `map --rebuild` performs, followed by the
#                     reconcile it does not do. The rebuild and --plan are mutually
#                     exclusive: a rebuild replaces the map and a dry run writes
#                     nothing, so the pair is a usage error (EXIT_USAGE) rather
#                     than a run that honours one of them. To plan against a
#                     rebuilt map, run `map --rebuild` and then `plan`.
#   plan  --circle <dir>|--all
#                     Alias for `push --plan ...` (dry-run; emits JSON, no curl).
#   seed  <seq>       Bounded one-shot read: resolve a Plane sequence_id, GET the
#                     issue's title+description once, emit them as JSON for the
#                     seeding skill. `--record-origin <circle-dir> <uuid>` writes
#                     the origin UUID under the new Circle's key (Phase B, no net).
#                     `--plan --fixture <json>` is the dry-run test seam.
#   map   [<key>]     Dump .plane-map.json, or inspect one natural key. Reads
#                     only: it never writes the file, and never creates one.
#                     `--forget <key>` drops one entry (reports whether it was
#                     there — never a silent no-op). `--prune` drops every entry
#                     whose Plane issue is definitively gone (HTTP 404); an
#                     unreachable Plane deletes NOTHING (C4). `--migrate` folds a
#                     legacy marker-bearing map onto the stable keys on disk — the
#                     one command whose whole job is that fold. `--rebuild`
#                     reconstructs the whole map from Plane and STOPS: the rebuild
#                     without the reconcile, so a plan can be computed against a
#                     rebuilt map without first mutating the board.
#   states            Resolve and print canonical → instance → UUID state map.
#   doctor            Report key presence, config validity, states/ reachability.
#
# ── KEY HANDLING (verbatim reuse of Martin's verified wrapper) ───────────────
#   Every Plane HTTP call runs through:
#       zsh -ic "curl -s -H \"X-API-Key: \$PLANE_API_KEY\" ... \"<url>\""
#   because the non-interactive Bash-tool shell does NOT inherit $PLANE_API_KEY
#   (it lives in ~/.zshrc). The key is NEVER read from a file and NEVER written
#   anywhere by this script — plane_key_present() reads it via zsh only to test
#   non-emptiness; its value is never echoed, logged, or persisted.
#
# ── NO HARDCODED STATE UUID ──────────────────────────────────────────────────
#   State UUIDs are resolved name → UUID at runtime via GET states/ (Martin's
#   doctrine), cached once per run. No Plane state UUID literal appears in this
#   source (a lint test enforces this).
#
# ── KIND LABELS (same doctrine, never blocking) ──────────────────────────────
#   Every artifact fusion CREATES in Plane carries one label naming its kind:
#   circle / fusion-issue / decision. The names come from the config's `labels:`
#   rename map (so a localised board changes only the values); the UUIDs are
#   resolved name → UUID at runtime via GET labels/, cached once per run exactly
#   like states/. No label UUID literal appears here either.
#
#   Create-if-missing: a configured label name absent from the board is created
#   once via POST labels/ and the returned UUID is used (and folded into the
#   per-run cache, so the rest of the run needs no further call).
#
#   NEVER BLOCKING (C4 spirit): if the labels/ endpoint is unreachable, returns
#   an error, or refuses the create, the push proceeds WITHOUT labels and prints
#   a note (and counts it in the final STATUS line). A label is metadata; losing
#   it must never cost the state transition, so this path does NOT defer, does
#   NOT touch the outbox, and does NOT change the exit code.
#
#   SEED-ORIGIN ISSUES GET NO LABEL. A seed-origin issue is a human's own Plane
#   story that fusion merely bound to a Circle; decision 260719-2313 settled that
#   such an issue receives STATE writes only. Labels are not an exception — the
#   same write_scope="state-only" branch that withholds name/description also
#   withholds the label.
#
# ── C4 OFFLINE DOCTRINE (never silent) ───────────────────────────────────────
#   No-network / DNS / connection-refused, HTTP 5xx/4xx, 429 rate-limit, and an
#   absent key each append a human-readable line to .plane-outbox.jsonl AND
#   yield a distinct "deferred" status (exit EXIT_DEFERRED, never a crash). The
#   outbox is a human record of what was pending, NOT a correctness queue —
#   correctness is restored by the next reconcile (a pure function of files).
#   The outbox is drained (cleared) for a Circle once its reconcile succeeds.
#
# ── THE NATURAL KEY CARRIES NO STATE ─────────────────────────────────────────
#   A record's natural key is its IDENTITY, and identity must survive every state
#   transition — a transition is precisely the event this mirror exists to push.
#   So the key is built from the parts of a filename that never change:
#
#       <circle-dir | "shared">::issues|decisions/YYMMDD-HHMM_<slug>.md
#
#   with the single-char underscore state marker REMOVED. The marker is state and
#   lives in the map's `last_state`, where it already did. fusion made this call
#   correctly once before, for Circle directories (the marker sits on
#   `_t_circle.md`, never on the directory name), which is why a Circle's own key
#   is just its directory name and needs no stripping.
#
#   Built in exactly ONE place — `natural_key()`. It used to be built at six call
#   sites straight off `basename`, each of them embedding the marker, so every
#   transition presented a key the map had never seen, `map_get_id` (an exact
#   string match) missed, and the push CREATED A SECOND PLANE ISSUE while the
#   first stayed at its old state forever (issue 260807-1939). A test lints for a
#   seventh site.
#
#   LEGACY MAPS: an entry written under the old marker-bearing form is FOLDED onto
#   the stable form. The fold is computed for every lookup and WRITTEN by nothing
#   that only reads: `map_view` produces it in memory, and only a command that was
#   asked to write the map (`map --migrate`, `map --forget`, `map --prune`,
#   `map --rebuild`, a live push) puts it on disk. So `map`, `push --plan` and `plan` resolve through the
#   folded keys and leave .plane-map.json byte-identical — in EVERY spelling of
#   them, `--rebuild-map` included, because that combination is refused as a usage
#   error before anything runs (see cmd_push). That split is the fix for
#   issue 260810-0456, where the fold sat on the read path and a dry run destroyed
#   a Plane UUID. Where the old scheme already produced two entries for one record,
#   the fold keeps the one pushed most recently and every dropped entry is named,
#   by key and UUID, on stderr.
#
#   `rebuild_map` normalises the same way, because the `fusion-key:` embedded in an
#   already-created Plane issue is whatever key was current when that issue was
#   POSTed — and it now handles a collision the same way too (issue 260810-0457):
#   two Plane issues carrying one key are ordered by (the UUID the current map
#   holds, then `updated_at`, then the UUID string), the last wins, and the losers
#   are named. The ordering is total, so the winner never depends on the order the
#   API returned the issues in. What a rebuild does NOT do is merge: it replaces
#   the map, so an entry whose Plane issue carries no `fusion-key:` — a seed-origin
#   binding, always — is dropped. Those are named too, with the
#   `seed --record-origin` line that restores each.
#
# Runtime state (workbench-root, gitignored with the rest of fusion-workbench/):
#   plane.config.yaml   consumer-filled config (base_url, slugs, state names)
#   .plane-map.json     natural key → { plane_id, kind, last_state, last_pushed,
#                       origin } where origin is "fusion" (fusion POSTed the
#                       issue and owns its body → full mirror on push) or "seed"
#                       (the issue is a human's pre-existing Plane story, bound
#                       via `seed --record-origin` → push writes STATE ONLY, never
#                       the title/description). Absent origin == "fusion" (legacy
#                       maps keep their existing behaviour).
#   .plane-outbox.jsonl deferred-transition notes { ts, natural_key, ... }
#
# Test seam: FUSION_PLANE_WORKBENCH=<dir> overrides workbench resolution so the
# vitest suite can point at a fixture workbench (its own plane.config.yaml +
# circles/…). FUSION_PLANE_DRYRUN=1 forces --plan for any push or seed — EXCEPT
# beside `--rebuild-map`, where the forced dry run and the rebuild contradict each
# other and the pair is refused (EXIT_USAGE, see cmd_push). So that env var and a
# rebuild are mutually exclusive on `push`, and the env var means nothing to
# `map --rebuild`, which is not a push.
#
# THE REBUILD FIXTURE SEAM, in the two spellings that read it — and they are NOT
# the same shape, which is what this paragraph got wrong until 260810:
#   `map --rebuild --fixture <captured issues JSON>` runs the rebuild extraction
#   against a captured `GET issues/` response instead of the wire, needs no key,
#   makes no call, and exits 0. It is offline like `seed --plan --fixture` but it
#   is NOT a dry run: replacing .plane-map.json is the command's whole job.
#   `push --rebuild-map --fixture <same>` performs that same rebuild and then falls
#   into the live branch — config, key, fetch_states, reconcile — so with no key it
#   ends at EXIT_DEFERRED (10) after the map has already been replaced.
# FUSION_PLANE_ISSUES_FIXTURE is the env twin of `--fixture` for both.
#
# Dependencies: bash, zsh (login profile exports the key), curl, jq, awk, sed,
# date, mktemp, sort. jq is required (JSON map/plan); config YAML is parsed by a
# targeted awk reader (no yq dependency).

set -eu

# ── Exit codes ───────────────────────────────────────────────────────────────
EXIT_OK=0
EXIT_CONFIG=1        # missing/invalid config, bad usage of a live command
EXIT_USAGE=2         # wrong subcommand / arguments
EXIT_DEFERRED=10     # C4: work deferred to the outbox — non-error, non-crash

SELF="$(basename "$0")"

err()  { printf '%s: %s\n' "$SELF" "$*" >&2; }
info() { printf '%s: %s\n' "$SELF" "$*" >&2; }

# ── Workbench + config paths ─────────────────────────────────────────────────
WORKBENCH=""
CONFIG_FILE=""
MAP=""
OUTBOX=""

resolve_workbench() {
  if [ -n "${FUSION_PLANE_WORKBENCH:-}" ]; then
    WORKBENCH="$FUSION_PLANE_WORKBENCH"
  else
    local root
    if ! root="$("$(dirname "$0")/fusion-workbench-root" 2>/dev/null)"; then
      err "no fusion workbench found above $(pwd). Run /fusion:setup at the project root first."
      return 1
    fi
    WORKBENCH="$root/fusion-workbench"
  fi
  CONFIG_FILE="$WORKBENCH/plane.config.yaml"
  MAP="$WORKBENCH/.plane-map.json"
  OUTBOX="$WORKBENCH/.plane-outbox.jsonl"
}

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ── Config: targeted YAML reader (fixed, fusion-authored shape) ───────────────
# Normalises plane.config.yaml into TAB-separated key<TAB>value lines. Two
# levels only: top-level scalars, and one nested block (states, labels,
# state_fallback).
# Nested keys are emitted as "<section>.<key>". Values are unquoted; inline
# comments stripped; arrays kept raw for the fallback getter.
AWK_CFG='
function trim(s){ sub(/^[ \t]+/,"",s); sub(/[ \t]+$/,"",s); return s }
function unquote(s){ if (substr(s,1,1)=="\"" && substr(s,length(s),1)=="\"") s=substr(s,2,length(s)-2); return s }
function clean_val(v,   t){
  t=trim(v)
  if (substr(t,1,1)=="\"") { sub(/^"/,"",t); sub(/".*$/,"",t); return t }
  if (substr(t,1,1)=="[") return t
  sub(/[ \t]+#.*$/,"",t); return trim(t)
}
{
  line=$0
  m=match(line,/[^ ]/)
  if (m==0) next
  content=substr(line,m)
  if (substr(content,1,1)=="#") next
  indent=m-1
  ci=index(content,":")
  if (ci==0) next
  key=unquote(trim(substr(content,1,ci-1)))
  rest=substr(content,ci+1)
  val=clean_val(rest)
  if (indent==0) {
    if (trim(rest)=="") { section=key; next }
    printf "%s\t%s\n", key, val
    section=""
  } else {
    printf "%s.%s\t%s\n", section, key, val
  }
}'

CONFIG_KV=""
cfg_load() {
  if [ ! -f "$CONFIG_FILE" ]; then
    err "config not found: $CONFIG_FILE (copy templates/plane.config.yaml into the workbench and fill it in)"
    return 1
  fi
  CONFIG_KV="$(awk "$AWK_CFG" "$CONFIG_FILE")"
}

cfg_get()      { printf '%s\n' "$CONFIG_KV" | awk -F'\t' -v k="$1" '$1==k{sub(/^[^\t]*\t/,""); print; exit}'; }
cfg_state()    { cfg_get "states.$1"; }
cfg_label()    { cfg_get "labels.$1"; }
cfg_fallback() { cfg_get "state_fallback.$1" | tr -d '[]"' | tr ',' ' '; }

# Base REST path assembled the way Martin does:
#   <base_url>/api/v1/workspaces/<workspace_slug>/projects/<project_id>
BASE=""
BASE_URL=""
WORKSPACE_SLUG=""
PROJECT_ID=""
build_base() {
  BASE_URL="$(cfg_get base_url)"
  WORKSPACE_SLUG="$(cfg_get workspace_slug)"
  PROJECT_ID="$(cfg_get project_id)"
  BASE="${BASE_URL%/}/api/v1/workspaces/${WORKSPACE_SLUG}/projects/${PROJECT_ID}"
}

# The exact values templates/plane.config.yaml ships its three scalars with. A
# field still carrying its shipped value was never filled in: `plane.example.com`
# is a reserved example domain, and the all-zero UUID resolves to no project on
# any instance. This is an equality test against three known strings, not a
# guess at what "looks like a placeholder" — a real config may well be short and
# plain (`http://localhost:9999`, a four-letter slug), and mistaking such a value
# for a placeholder is the error this file already cost a real story once.
# Keep in step with templates/plane.config.yaml; the lint test in
# hooks/lib/__tests__/fusion-plane.test.ts fails if the two drift apart.
TEMPLATE_BASE_URL="https://plane.example.com"
TEMPLATE_WORKSPACE_SLUG="your-workspace-slug"
TEMPLATE_PROJECT_ID="00000000-0000-0000-0000-000000000000"

config_valid() {
  # Returns 0 if the required scalars are present AND are not still the values
  # the template ships with. An unfilled template that reports "valid" sends the
  # caller on to a request that cannot succeed, and the failure it then reports
  # ("unreachable", "HTTP 404") names the wrong cause.
  local ok=0
  [ -n "$BASE_URL" ]        || { err "config: base_url is empty"; ok=1; }
  [ -n "$WORKSPACE_SLUG" ]  || { err "config: workspace_slug is empty"; ok=1; }
  [ -n "$PROJECT_ID" ]      || { err "config: project_id is empty"; ok=1; }
  [ "$BASE_URL" != "$TEMPLATE_BASE_URL" ] || {
    err "config: base_url is still the template value '$TEMPLATE_BASE_URL' — set it to your Plane instance root"; ok=1; }
  [ "$WORKSPACE_SLUG" != "$TEMPLATE_WORKSPACE_SLUG" ] || {
    err "config: workspace_slug is still the template value '$TEMPLATE_WORKSPACE_SLUG' — set it to your workspace slug"; ok=1; }
  [ "$PROJECT_ID" != "$TEMPLATE_PROJECT_ID" ] || {
    err "config: project_id is still the template's all-zero UUID — set it to the target project's UUID"; ok=1; }
  return $ok
}

# ── HTTP wrapper — Martin's `zsh -ic` key wrapper, verbatim pattern ──────────
# plane_curl METHOD URL [JSON_BODY]
#   Runs curl inside `zsh -ic` so $PLANE_API_KEY (from ~/.zshrc) is in scope.
#   $PLANE_API_KEY stays literal (\$) for zsh; $BASE/URL expand in outer bash.
#   JSON bodies go through a temp file (--data-binary @file) to avoid quoting
#   hell inside the zsh -ic string; the temp file holds no secret and is removed.
# Sets globals: PLANE_HTTP_CODE, PLANE_BODY, PLANE_CURL_RC (curl transport rc).
# Returns 0 when curl ran (an HTTP response arrived), non-zero on transport
# failure (no network / DNS / connection refused / timeout).
PLANE_HTTP_CODE=""
PLANE_BODY=""
PLANE_CURL_RC=0
plane_curl() {
  local method="$1" url="$2" body="${3:-}"
  local tmpbody="" cmd out rc
  local common="-s -w '\\n%{http_code}' -X ${method} -H \"X-API-Key: \$PLANE_API_KEY\""
  if [ -n "$body" ]; then
    tmpbody="$(mktemp "${TMPDIR:-/tmp}/fusion-plane.XXXXXX")"
    printf '%s' "$body" > "$tmpbody"
    common="$common -H 'Content-Type: application/json' --data-binary @${tmpbody}"
  fi
  cmd="curl ${common} \"${url}\""
  out="$(zsh -ic "$cmd" 2>/dev/null)" && rc=0 || rc=$?
  [ -n "$tmpbody" ] && rm -f "$tmpbody"
  PLANE_CURL_RC=$rc
  if [ "$rc" -ne 0 ]; then
    PLANE_HTTP_CODE=""
    PLANE_BODY=""
    return "$rc"
  fi
  PLANE_HTTP_CODE="$(printf '%s' "$out" | tail -n1)"
  PLANE_BODY="$(printf '%s' "$out" | sed '$d')"
  return 0
}

# Key presence check — tests $PLANE_API_KEY non-emptiness via zsh's exit code
# ONLY. The value is never captured, printed, logged, or written anywhere.
plane_key_present() {
  zsh -ic 'test -n "${PLANE_API_KEY:-}"' >/dev/null 2>&1
}

# ── States: name → UUID resolution at runtime (Martin: never hardcode) ───────
STATES_JSON=""
fetch_states() {
  # Cached per run.
  [ -n "$STATES_JSON" ] && return 0
  if ! plane_curl GET "$BASE/states/"; then
    return 1   # transport failure
  fi
  case "$PLANE_HTTP_CODE" in
    2*) STATES_JSON="$PLANE_BODY"; return 0 ;;
    *)  return 2 ;;   # HTTP error
  esac
}

# state_uuid <instance-state-name> — look the instance name up in the cached
# states list. Handles both a bare array and a {results:[...]} envelope.
state_uuid() {
  [ -n "$STATES_JSON" ] || return 1
  printf '%s' "$STATES_JSON" \
    | jq -r --arg n "$1" '(.results? // .) | map(select(.name==$n)) | (.[0].id // empty)'
}

# resolve_canonical_state <canonical> — canonical fusion state name → instance
# name (via config) → UUID (via states/), applying the configured fallback
# order of canonical names when the primary name does not resolve.
resolve_canonical_state() {
  local canon="$1" inst uuid fb fbinst
  inst="$(cfg_state "$canon")"; [ -n "$inst" ] || inst="$canon"
  uuid="$(state_uuid "$inst" || true)"
  if [ -z "$uuid" ]; then
    for fb in $(cfg_fallback "$canon"); do
      fbinst="$(cfg_state "$fb")"; [ -n "$fbinst" ] || fbinst="$fb"
      uuid="$(state_uuid "$fbinst" || true)"
      [ -n "$uuid" ] && break
    done
  fi
  printf '%s' "$uuid"
}

# ── Labels: kind name → UUID resolution at runtime (mirrors states/) ─────────
# Same three-step shape as states/: fetch once per run into a cache, look the
# configured name up in that cache, never hardcode a UUID. The one addition is
# create-if-missing — a state must already exist on the board, but a label fusion
# needs may legitimately not, and creating it is cheap and non-destructive.
LABELS_JSON=""
LABELS_FETCH_FAILED=0
LABELS_SKIPPED=0
# Per-run memo of kind → resolved UUID, as "<kind><TAB><uuid|->" lines ("-" means
# "already tried and failed this run"). Bash 3.2 has no associative arrays, and
# with three fixed kinds a memo line is simpler than any alternative.
LABEL_MEMO=""

fetch_labels() {
  # Cached per run (identical contract to fetch_states).
  [ -n "$LABELS_JSON" ] && return 0
  [ "$LABELS_FETCH_FAILED" -eq 1 ] && return 1
  if ! plane_curl GET "$BASE/labels/"; then
    LABELS_FETCH_FAILED=1
    return 1   # transport failure
  fi
  case "$PLANE_HTTP_CODE" in
    2*) LABELS_JSON="$PLANE_BODY"; return 0 ;;
    *)  LABELS_FETCH_FAILED=1; return 2 ;;   # HTTP error
  esac
}

# label_uuid <instance-label-name> — look the name up in the cached labels list.
# Handles both a bare array and a {results:[...]} envelope, like state_uuid.
label_uuid() {
  [ -n "$LABELS_JSON" ] || return 1
  printf '%s' "$LABELS_JSON" \
    | jq -r --arg n "$1" '(.results? // .) | map(select(.name==$n)) | (.[0].id // empty)'
}

label_memo_get() { printf '%s\n' "$LABEL_MEMO" | awk -F'\t' -v k="$1" '$1==k{print $2; exit}'; }
label_memo_put() { LABEL_MEMO="$(printf '%s\n%s\t%s' "$LABEL_MEMO" "$1" "$2")"; }

# label_skip <kind> <reason> — remember the failure, say it out loud once per
# kind, and let the caller carry on WITHOUT a label. Never defers, never counts
# as a deferral, never changes the exit code (a label is metadata).
label_skip() {
  label_memo_put "$1" '-'
  LABELS_SKIPPED=$((LABELS_SKIPPED + 1))
  info "label '$1' unavailable ($2) — pushing without the kind label."
  return 1
}

# resolve_kind_label <kind> — canonical kind → instance label name (via config)
# → UUID (via labels/, creating the label if the board lacks it). Prints the UUID
# on success; prints nothing and returns non-zero when no label can be had.
resolve_kind_label() {
  local kind="$1" name uuid memo body new_id
  memo="$(label_memo_get "$kind")"
  if [ -n "$memo" ]; then
    [ "$memo" = "-" ] && return 1
    printf '%s' "$memo"; return 0
  fi
  name="$(cfg_label "$kind")"; [ -n "$name" ] || name="$kind"

  if ! fetch_labels; then
    label_skip "$kind" "labels/ unreachable (curl rc $PLANE_CURL_RC / HTTP ${PLANE_HTTP_CODE:-none})"
    return 1
  fi
  uuid="$(label_uuid "$name" || true)"
  if [ -n "$uuid" ]; then
    label_memo_put "$kind" "$uuid"
    printf '%s' "$uuid"; return 0
  fi

  # Create-if-missing: the board has no label by this name yet.
  body="$(jq -cn --arg n "$name" '{name:$n}')"
  if ! plane_curl POST "$BASE/labels/" "$body"; then
    label_skip "$kind" "create failed, Plane unreachable (curl rc $PLANE_CURL_RC)"
    return 1
  fi
  case "$PLANE_HTTP_CODE" in
    2*) : ;;
    *)  label_skip "$kind" "create returned HTTP $PLANE_HTTP_CODE"; return 1 ;;
  esac
  new_id="$(printf '%s' "$PLANE_BODY" | jq -r '.id // empty' 2>/dev/null || true)"
  if [ -z "$new_id" ]; then
    label_skip "$kind" "create returned no id"
    return 1
  fi
  # Fold the new label into the per-run cache so nothing re-fetches or re-creates.
  LABELS_JSON="$(printf '%s' "$LABELS_JSON" | jq -c --argjson new "$PLANE_BODY" '((.results? // .) + [$new])')"
  label_memo_put "$kind" "$new_id"
  info "created Plane label '$name' for kind '$kind'."
  printf '%s' "$new_id"
}

# ── Spec-comment: the full Circle record body as one idempotent Plane comment ─
# OPT-IN (config `spec_comment: true`, default off). When enabled, a Circle push
# attaches — or refreshes — the record body as a SINGLE comment on the mirrored
# issue, keyed on an HTML-comment marker so re-pushes update it in place rather
# than piling up duplicates. NON-BLOCKING exactly like the kind-label path: a
# failed comment op prints a note, never defers, never touches the outbox, and
# never changes the exit code (the state transition has already completed before
# the comment is attempted). These are the pure primitives; process_artifact
# wires them (plan Step 2). No comment UUID literal appears here (lint invariant).
COMMENTS_SKIPPED=0

# spec_comment_enabled — the opt-in gate. Absent OR `false` ⇒ disabled (default
# off); read through the same cfg_get as base_url / states / labels.
spec_comment_enabled() { [ "$(cfg_get spec_comment)" = "true" ]; }

# build_comment_body <file> <key> — the exact Plane comment body:
#   {"comment_html": "<!-- fusion-spec-comment:<key> -->\n<pre><escaped body></pre>"}
# jq @html escapes & < > in a single ampersand-first pass, so a record body with
# angle brackets or ampersands (a Mermaid `A --> B`, an HTML tag, `a && b`) can
# break neither the HTML nor the JSON. The marker is fusion-authored and carries
# only the key, so it is emitted LITERALLY, outside the escaped <pre> body.
build_comment_body() {
  local file="$1" key="$2"
  jq -Rs --arg key "$key" \
    '{comment_html: ("<!-- fusion-spec-comment:\($key) -->\n<pre>" + (.|@html) + "</pre>")}' \
    "$file"
}

# comment_skip <reason> — mirrors label_skip: say it out loud once, count it, and
# let the caller carry on WITHOUT the comment. Never defers, never counts as a
# deferral, never touches the outbox, never changes the exit code (a comment is
# auxiliary — losing it must never cost the state transition).
comment_skip() {
  COMMENTS_SKIPPED=$((COMMENTS_SKIPPED + 1))
  info "spec-comment unavailable ($1) — the state transition is unaffected; next push retries."
  return 1
}

# comment_id_for_marker <comments_json> <key> — find fusion's existing spec-comment
# for this Circle. Matches by this Circle's exact marker ONLY, so a comment bearing
# a different key's marker is never matched. Handles both a bare array and a
# {results:[...]} envelope, exactly like state_uuid / label_uuid. Prints the
# comment id on a match; prints nothing when none carries the marker.
comment_id_for_marker() {
  local comments_json="$1" key="$2" marker
  marker="<!-- fusion-spec-comment:$key -->"
  printf '%s' "$comments_json" \
    | jq -r --arg marker "$marker" \
        '(.results? // .) | map(select((.comment_html // "") | contains($marker))) | (.[0].id // empty)'
}

# upsert_spec_comment <file> <nk> <issue_id> — attach or refresh the Circle
# record body as ONE idempotent comment on the mirrored issue. Idempotency: GET
# the issue's comments, match THIS Circle's marker; a match PATCHes that comment
# in place, no match POSTs a new one — so a re-push updates rather than duplicates.
# NON-BLOCKING (C4 spirit, exactly like the kind-label path): a transport failure
# or ANY non-2xx at either step calls comment_skip and returns 0 — it NEVER defers,
# NEVER touches the outbox, and NEVER changes the exit code (the state transition
# has already completed before this is reached). Every call runs through plane_curl;
# no comment UUID literal appears here. Callers invoke it as `… || true` so the
# internal comment_skip (which returns 1) cannot trip set -e — the same guard
# resolve_kind_label uses around label_skip.
upsert_spec_comment() {
  local file="$1" nk="$2" issue_id="$3" body cid
  # Read the body builder's status: `jq -Rs … "$file"` fails on an unreadable
  # record, and an empty $body would be PATCHed or POSTed in place of the record —
  # the outcome comment_skip exists for (issue 260810-0750, the live half).
  if ! body="$(build_comment_body "$file" "$nk")"; then
    comment_skip "record unreadable: $file"
    return 0
  fi
  if ! plane_curl GET "$BASE/issues/${issue_id}/comments/?per_page=100"; then
    comment_skip "comments/ unreachable (curl rc $PLANE_CURL_RC)"
    return 0
  fi
  case "$PLANE_HTTP_CODE" in
    2*) : ;;
    *)  comment_skip "comments/ list returned HTTP $PLANE_HTTP_CODE"; return 0 ;;
  esac
  cid="$(comment_id_for_marker "$PLANE_BODY" "$nk" || true)"
  if [ -n "$cid" ]; then
    if ! plane_curl PATCH "$BASE/issues/${issue_id}/comments/${cid}/" "$body"; then
      comment_skip "comment PATCH failed, Plane unreachable (curl rc $PLANE_CURL_RC)"
      return 0
    fi
  else
    if ! plane_curl POST "$BASE/issues/${issue_id}/comments/" "$body"; then
      comment_skip "comment POST failed, Plane unreachable (curl rc $PLANE_CURL_RC)"
      return 0
    fi
  fi
  case "$PLANE_HTTP_CODE" in
    2*) return 0 ;;
    *)  comment_skip "comment write returned HTTP $PLANE_HTTP_CODE"; return 0 ;;
  esac
}

# ── Marker → canonical Plane state (the plan's mapping table) ────────────────
canonical_state_for() {
  local kind="$1" marker="$2"
  case "$kind" in
    circle)
      case "$marker" in
        a) echo "Backlog" ;;
        t) echo "In Progress" ;;
        c|b) echo "Done" ;;
        s|d) echo "Cancelled" ;;
        *) echo "" ;;
      esac ;;
    fusion-issue)
      case "$marker" in
        o) echo "Todo" ;;
        p) echo "In Progress" ;;
        c) echo "Done" ;;
        d) echo "Cancelled" ;;
        *) echo "" ;;
      esac ;;
    decision)
      case "$marker" in
        o) echo "Todo" ;;
        a) echo "In Progress" ;;
        i) echo "Done" ;;
        s|d) echo "Cancelled" ;;
        *) echo "" ;;
      esac ;;
    *) echo "" ;;
  esac
}

# marker_from_filename — extract the single-char underscore state marker.
# Circle record: _<m>_circle.md. Issue/decision: <stamp>_<m>_<slug>.md.
marker_from_filename() {
  local base="$1" m
  m="$(printf '%s' "$base" | sed -nE 's/^_([a-z])_circle\.md$/\1/p')"
  if [ -z "$m" ]; then
    m="$(printf '%s' "$base" | sed -nE 's/^[0-9]{6}-[0-9]{4}_([a-z])_.*/\1/p')"
  fi
  printf '%s' "$m"
}

# stable_basename — the IDENTITY half of the same filename: the basename with the
# state marker segment removed, so `YYMMDD-HHMM_<m>_<slug>.md` becomes
# `YYMMDD-HHMM_<slug>.md`. Exactly the inverse concern of
# marker_from_filename above, and the two are deliberately adjacent: what that one
# extracts is what this one drops. A name that carries no marker is returned
# unchanged, so the transform is idempotent and safe to apply to an already-stable
# name.
stable_basename() {
  printf '%s' "$1" | sed -E 's/^([0-9]{6}-[0-9]{4})_[a-z]_/\1_/'
}

# natural_key <scope> <subdir> <file> — THE one place a record's natural key is
# built. <scope> is a Circle directory name or the literal "shared"; <subdir> is
# `issues` or `decisions`. Never construct a key from a raw basename anywhere
# else: that is how the marker got into the key (see the header), and a test
# fails if a second construction site appears.
natural_key() {
  printf '%s::%s/%s' "$1" "$2" "$(stable_basename "$(basename "$3")")"
}

# artifact_title — first markdown H1, falling back to the natural key. Truncated
# to keep Plane titles sane and deterministic.
artifact_title() {
  local file="$1" fallback="$2" h1
  h1="$(grep -m1 '^# ' "$file" 2>/dev/null | sed 's/^# //' || true)"
  [ -n "$h1" ] || h1="$fallback"
  printf '%s' "$h1" | cut -c1-200
}

# ── Natural-key → Plane map (jq-backed; helper-owned) ────────────────────────
#
# READING AND WRITING ARE SEPARATE, AND THAT SEPARATION IS THE DESIGN.
#
# A map on disk may still carry the old marker-bearing keys, so every lookup has
# to resolve against the folded (marker-free) form. Folding used to happen by
# REWRITING the file, from `map_ensure`, which sat on the READ path — so `map`,
# `push --plan` and `plan`, each documented as changing nothing, rewrote
# .plane-map.json, and on a map carrying the very duplicates the fold exists to
# repair they destroyed a Plane UUID. A destroyed UUID names a Plane issue that
# goes on existing, unreferenced, for a human to find and close: cost outside this
# repository, paid by a command the user ran to LOOK at something. Issues
# 260810-0456 and 260810-0457.
#
# The four functions below are the answer, and it is structural rather than a
# guard at each call site:
#
#   map_view   folds in memory and sets $MAP_VIEW to a path holding the folded
#              form. It NEVER writes $MAP. EVERY read resolves through it.
#   map_write  applies a jq program to that folded form and replaces $MAP. Every
#              caller of it is a command that was asked to write.
#   map_put    the ONE place $MAP is replaced (map_write and rebuild_map both end
#              here), so refreshing the view can never be forgotten, and the ONE
#              place a failed replacement is turned into a non-zero status.
#   map_view_required  the read side of the same split: it asserts the view was
#              built and never builds one, because every getter runs in a subshell.
#
# BUILDING THE VIEW AND READING IT ARE ALSO SEPARATE, FOR A MECHANICAL REASON.
# Each getter below (map_json, map_get_id, map_get_state, map_get_origin) is
# invoked as `$(…)`, and a command substitution is a subshell: every variable the
# fold sets there dies with it, and bash resets an inherited EXIT trap in a
# subshell, so the temp file the fold created is never removed. When the getters
# built the view themselves, one `push --plan --all` against a legacy map
# recomputed the fold 24 times, left 24 temp files behind, and printed the
# once-per-run report 24 times (issue 260810-0744). So the BUILD is the parent's
# job — each subcommand calls `map_view` once, before any lookup — and a getter
# only READS $MAP_VIEW, refusing loudly if nobody built it.
#
# A read path added tomorrow gets `map_view` and has no way to write; that is the
# property bought here, rather than two guarded call sites waiting for a third.
#
# JQ_STABLE_KEY — the key normalisation, as a jq definition, shared by the fold
# and the rebuild. It is the jq twin of `stable_basename` above: drop the `_<m>_`
# marker segment from the filename part of a natural key. It matches only inside
# `::issues/` and `::decisions/` after a YYMMDD-HHMM stamp, so a Circle key (a
# bare directory name, no `::`) passes through untouched.
JQ_STABLE_KEY='def stable_key: sub("(?<p>::(issues|decisions)/[0-9]{6}-[0-9]{4})_[a-z]_"; .p + "_");'

# JQ_MIGRATE_MAP — re-key a whole map to the stable form.
#
# COLLISION RULE: the old marker-bearing scheme could record ONE record twice —
# once per state it was pushed in — which is the duplicate-issue defect itself. On
# a collision the entry pushed most recently wins, because that is the Plane issue
# the board has been tracking; the loser is reported by `map_report_fold`, by key
# and by UUID, never dropped silently, since it means a stray duplicate exists in
# Plane for a human to close.
JQ_MIGRATE_MAP="$JQ_STABLE_KEY"'
  reduce (to_entries[]) as $e ({};
    ($e.key | stable_key) as $k
    | if (has($k) and ((.[$k].last_pushed // "") >= ($e.value.last_pushed // "")))
      then . else .[$k] = $e.value end)'

# JQ_FOLD_LOSERS — the entries the fold drops, as `<old key> → <plane_id>` lines.
# An original entry is a loser when the folded map does not carry its plane_id
# under its own stable key. $v is the folded map (--slurpfile).
JQ_FOLD_LOSERS="$JQ_STABLE_KEY"'
  . as $orig | $v[0] as $folded
  | [ $orig | to_entries[]
      | select($folded[(.key | stable_key)].plane_id != .value.plane_id)
      | "\(.key) → \(.value.plane_id)" ]
  | .[]'

MAP_VIEW=""          # path to read the map from: $MAP itself when it is already
                     # stable (or unparseable), else a temp file holding the fold
MAP_VIEW_TMP=""      # that temp file, when one was materialised
MAP_VIEW_READY=0
MAP_FOLD_REPORTED=0

map_view_cleanup() { [ -z "$MAP_VIEW_TMP" ] || rm -f "$MAP_VIEW_TMP"; return 0; }
trap map_view_cleanup EXIT

# map_view — sets $MAP_VIEW to a path holding the map in the stable key form.
# READ-ONLY with respect to $MAP: it never writes, creates or replaces it. Call it
# and then read "$MAP_VIEW"; it does not print the path, because a command
# substitution would run it in a subshell and lose the cached fold, the temp-file
# handle and the once-per-run report with it.
#
# THAT SAME SUBSHELL RULE BINDS THE CALLER: this must be invoked from the shell
# that will do the reading, never from inside `$(…)` — which is why no getter
# calls it and every subcommand calls it once, up front (see the section header).
#
# $MAP_VIEW may name a file that does not exist (no map yet). Callers check.
map_view() {
  [ "$MAP_VIEW_READY" -eq 0 ] || return 0
  MAP_VIEW_READY=1
  MAP_VIEW="$MAP"
  [ -f "$MAP" ] || return 0
  local tmp before after
  tmp="$(mktemp "${TMPDIR:-/tmp}/fusion-plane-view.XXXXXX")"
  if ! jq -S "$JQ_MIGRATE_MAP" "$MAP" > "$tmp" 2>/dev/null; then
    err "map: could not parse $MAP — keys read as they are"
    rm -f "$tmp"
    return 0
  fi
  before="$(jq -S '.' "$MAP" 2>/dev/null || printf '')"
  after="$(cat "$tmp")"
  if [ "$before" = "$after" ]; then
    rm -f "$tmp"          # already stable: the file IS the view
    return 0
  fi
  MAP_VIEW="$tmp"
  MAP_VIEW_TMP="$tmp"
  map_report_fold
}

# map_report_fold — say, once per run, that the file is still in the old form,
# what folding it costs, and that nothing has been folded on disk yet. Naming each
# losing UUID (not just counting them) is the point: that string is the only
# handle a human has on the stray Plane issue the fold orphans.
map_report_fold() {
  [ "$MAP_FOLD_REPORTED" -eq 0 ] || return 0
  MAP_FOLD_REPORTED=1
  local n_before n_after losers
  n_before="$(jq 'length' "$MAP")"
  n_after="$(jq 'length' "$MAP_VIEW")"
  info "map: $MAP still carries the old marker-bearing keys — $n_before entries fold onto $n_after stable keys."
  info "map: nothing has been folded on disk. Commands that WRITE the map fold it (map --migrate, map --forget, map --prune, map --rebuild, a live push); reads do not (map, push --plan, plan)."
  [ "$n_after" -lt "$n_before" ] || return 0
  info "map: folding drops $((n_before - n_after)) mapping(s). Each names a Plane issue that stays on the board unreferenced — close it by hand:"
  # The list is the whole point of the line above, so a failure to produce it is
  # said out loud rather than flattened into "no losers to name".
  if ! losers="$(jq -r --slurpfile v "$MAP_VIEW" "$JQ_FOLD_LOSERS" "$MAP" 2>/dev/null)"; then
    info "map:   could not list them (jq failed on $MAP) — the count above stands, the UUIDs are in the file."
    return 0
  fi
  printf '%s\n' "$losers" | while IFS= read -r line; do
    [ -z "$line" ] || info "map:   $line"
  done
  return 0
}

# map_put <file> — THE ONE place $MAP is replaced. Every writer ends here, so the
# read view is refreshed in exactly one place and cannot go stale behind a write.
#
# THE REPLACEMENT'S STATUS IS READ, and that is what this function is for as much
# as the refresh is. `mv` fails on an unwritable workbench, a full disk, a
# read-only mount; when its status was discarded, map_write returned 0, `map_set`
# returned 0, and every caller's `|| return "$EXIT_CONFIG"` guard was dead code —
# `map --migrate` printed "STATUS: migrated (1 entries)" and exited 0 over an
# unchanged file (issue 260810-0743). On the live push path the same lost write
# means a created issue's UUID never reaches the map and the next push POSTs a
# SECOND Plane issue, which is the defect this whole mirror exists to close.
#
# On success the view is set to $MAP rather than cleared: what was just written is
# by construction already in the stable key form (map_write derives it from the
# folded view, rebuild_map normalises through stable_key), so the new file IS a
# valid view and the next lookup needs no second fold.
map_put() {
  if ! mv "$1" "$MAP"; then
    err "map: could not replace $MAP — file left unchanged"
    rm -f "$1"
    return 1
  fi
  [ -z "$MAP_VIEW_TMP" ] || rm -f "$MAP_VIEW_TMP"
  MAP_VIEW_TMP=""
  MAP_VIEW="$MAP"
  MAP_VIEW_READY=1
}

# map_write <jq-program> [<jq-arg>…] — apply a jq program to the FOLDED map and
# replace $MAP with the result. Called only from commands that were asked to
# write, which is why folding on disk happens here and nowhere on a read path.
map_write() {
  local prog="$1" tmp rc=0
  shift
  map_view
  tmp="$(mktemp "${TMPDIR:-/tmp}/fusion-plane-map.XXXXXX")"
  if [ -f "$MAP_VIEW" ]; then
    jq -S "$@" "$prog" "$MAP_VIEW" > "$tmp" || rc=$?
  else
    printf '{}\n' | jq -S "$@" "$prog" > "$tmp" || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    err "map: could not write $MAP (jq exit $rc) — file left unchanged"
    rm -f "$tmp"
    return 1
  fi
  # jq exits 0 on EMPTY input and produces nothing, so rc=0 does not mean the
  # program ran: an empty (truncated, half-written) $MAP_VIEW yields an empty $tmp
  # and would replace the map with a zero-byte file — every entry lost, reported as
  # a successful write. No legitimate program here produces empty output; `.` and
  # `del(…)` and `.[$k] = …` all emit at least `{}`.
  if [ ! -s "$tmp" ]; then
    err "map: refusing to replace $MAP with an empty file (jq read no input from $MAP_VIEW) — file left unchanged"
    rm -f "$tmp"
    return 1
  fi
  map_put "$tmp"
}

# map_view_required — the read side of the build/read split. The getters below
# NEVER build the view: every one of them is invoked as `$(…)`, and a fold built in
# that subshell dies with it (issue 260810-0744). Building is the caller's job,
# once, in the parent. A lookup that arrives before that build is a bug in this
# file, not a user error, so it is loud and fails closed — an empty answer here
# would read as "not mapped yet" and make the next push create a duplicate issue.
map_view_required() {
  [ "$MAP_VIEW_READY" -eq 1 ] && return 0
  err "internal: map lookup before map_view — the subcommand must build the view in the parent shell first"
  return 1
}

# map_json — the map's content in the stable key form on stdout, `{}` when there
# is no map yet. The display half of map_view.
map_json() { map_view_required || return 1; if [ -f "$MAP_VIEW" ]; then cat "$MAP_VIEW"; else printf '{}\n'; fi; }

map_get_id()    { map_view_required || return 1; [ -f "$MAP_VIEW" ] || { printf ''; return; }; jq -r --arg k "$1" '.[$k].plane_id  // empty' "$MAP_VIEW"; }
map_get_state() { map_view_required || return 1; [ -f "$MAP_VIEW" ] || { printf ''; return; }; jq -r --arg k "$1" '.[$k].last_state // empty' "$MAP_VIEW"; }

# map_get_origin <natural-key> — WHO AUTHORED the Plane issue behind this key:
#   "seed"   the issue pre-existed in Plane (a human's story); fusion bound it to
#            a Circle via `seed --record-origin`. fusion must NEVER overwrite its
#            title/description — pushes write state only.
#   "fusion" fusion POSTed the issue itself and owns its body — full mirroring.
# BACKWARD COMPATIBILITY: an entry written before this field existed (and any
# entry from `push --rebuild-map`) has no `origin` and defaults to "fusion" —
# exactly the behaviour those maps already had.
map_get_origin() {
  map_view_required || return 1
  [ -f "$MAP_VIEW" ] || { printf 'fusion'; return; }
  jq -r --arg k "$1" '.[$k].origin // "fusion"' "$MAP_VIEW"
}

map_set() {
  # map_set <natural-key> <plane_id> <kind> <last_state> [<origin>]
  # <origin> omitted => PRESERVE the entry's existing origin (defaulting to
  # "fusion" for a new/legacy entry). A push must never silently relabel a
  # seed-origin entry as fusion-owned — that would re-enable the destructive
  # full-body write on the next run.
  local nk="$1" pid="$2" kind="$3" st="$4" origin="${5:-}"
  # Read the lookup's status: an origin silently defaulted to empty would relabel a
  # seed-origin entry, which is the destructive full-body write decision 260719-2313
  # exists to prevent.
  if [ -z "$origin" ]; then
    origin="$(map_get_origin "$nk")" || return 1
  fi
  map_write '.[$k] = {plane_id:$id, kind:$kind, last_state:$st, last_pushed:$t, origin:$o}' \
    --arg k "$nk" --arg id "$pid" --arg kind "$kind" --arg st "$st" \
    --arg o "$origin" --arg t "$(now_utc)"
}

# ── Outbox (C4 never-silent) ─────────────────────────────────────────────────
outbox_append() {
  # outbox_append <natural-key> <intended-state> <reason> <manual-hint>
  #
  # A failed append is REPORTED and not fatal. `>>` fails on an unwritable
  # workbench — which is precisely the condition several of the deferrals reaching
  # this function describe — and letting that status out would abort the run under
  # `set -e`, contradicting the C4 doctrine at the top of this file ("never a
  # crash"). Nothing is swallowed: the deferral is still counted by `defer`, still
  # named on stderr, and still moves the exit code to EXIT_DEFERRED; only the
  # persistent note is lost, and that loss says so.
  if ! jq -cn --arg ts "$(now_utc)" --arg nk "$1" --arg st "$2" --arg r "$3" --arg mh "$4" \
       '{ts:$ts, natural_key:$nk, intended_state:$st, reason:$r, manual_hint:$mh}' >> "$OUTBOX"; then
    err "outbox: could not append to $OUTBOX — this deferral is on stderr and in the exit status only, not in the file."
  fi
  return 0
}

# outbox_drain_circle <circle-dir-name> — remove outbox lines whose natural_key
# is this Circle or a sub-artifact of it (called once its reconcile succeeds).
# The filter's status is read before the result replaces the file. With `|| true`
# there, a jq failure (a half-written line, a hand-edited outbox) left an empty
# $tmp that was moved over the outbox and then deleted for being empty — a
# READ-AND-REPAIR path destroying the human record it was walking, which is the
# same shape as issue 260810-0456. Neither failure is fatal: the outbox is a human
# record, not a correctness queue (the file header says so), so a drain that could
# not run leaves stale notes behind and says which.
outbox_drain_circle() {
  local name="$1" tmp
  [ -f "$OUTBOX" ] || return 0
  tmp="$(mktemp "${TMPDIR:-/tmp}/fusion-plane-outbox.XXXXXX")"
  if ! jq -c --arg d "$name" \
       'select((.natural_key==$d or (.natural_key|startswith($d+"::")))|not)' \
       "$OUTBOX" > "$tmp" 2>/dev/null; then
    err "outbox: could not read $OUTBOX — left unchanged, so its notes for $name remain."
    rm -f "$tmp"
    return 0
  fi
  if ! mv "$tmp" "$OUTBOX"; then
    err "outbox: could not replace $OUTBOX — left unchanged, so its notes for $name remain."
    rm -f "$tmp"
    return 0
  fi
  [ -s "$OUTBOX" ] || rm -f "$OUTBOX" 2>/dev/null || true
  return 0
}

# Web URL for a Plane issue (best-effort; used as the DR-1 links fallback body).
issue_web_url() {
  printf '%s/%s/projects/%s/issues/%s' \
    "${BASE_URL%/}" "$WORKSPACE_SLUG" "$PROJECT_ID" "$1"
}

# ── Reconcile core ───────────────────────────────────────────────────────────
# Mode flags / run state.
DRYRUN=0
CLOSURE=0
COMMENTS_FIXTURE=""   # test seam: captured `GET issues/<id>/comments/` JSON that
                      # drives the dry-run PATCH-vs-POST branch offline (Step 2).
                      # Distinct from the rebuild `--fixture`, which is a captured
                      # `GET issues/` response — see cmd_push.
declare -a OPS=()     # dry-run: accumulated create/update op objects (JSON)
PUSHED=0
DEFERRED=0
RATE_LIMITED=0

# op_json — build one plan op object (deterministic: no timestamps, state by
# NAME not UUID, so --plan needs no network).
op_json() {
  # op_json <op> <kind> <nk> <title> <marker> <canonical> <instance> <plane_id> <parent_key> <relpath> <write_scope> <label>
  # write_scope makes the seed-origin protection VISIBLE in the dry run:
  #   "full"       fusion owns the issue → name + description_html + state.
  #   "state-only" seed-origin issue (a human's story) → state ONLY; the `writes`
  #                list is the exact set of body fields the PATCH will carry.
  # <label> is the configured kind-label NAME (never a UUID — the dry run makes
  # no network call, so no UUID exists yet). It is null for a state-only write,
  # where a human's story must not gain a fusion label either. It is reported
  # SEPARATELY from `writes` on purpose: `writes` lists the body fields fusion
  # always sends, whereas the label is best-effort and is dropped (with a printed
  # note) if the live labels/ call cannot resolve or create it.
  jq -cn \
    --arg op "$1" --arg kind "$2" --arg nk "$3" --arg title "$4" --arg marker "$5" \
    --arg state "$6" --arg state_instance "$7" --arg pid "$8" --arg pk "$9" --arg src "${10}" \
    --arg scope "${11}" --arg label "${12}" \
    '{op:$op, kind:$kind, natural_key:$nk, title:$title, marker:$marker,
      state:$state, state_instance:$state_instance,
      plane_id:(if $pid=="" then null else $pid end),
      parent_key:(if $pk=="" then null else $pk end),
      attach:(if $pk=="" then null else "sub-issue" end),
      write_scope:$scope,
      writes:(if $scope=="state-only" then ["state"]
              else ["name","description_html","state"] end),
      label:(if $label=="" then null else $label end),
      embed_key:$nk, source:$src}'
}

# defer — C4: record an outbox note and count the deferral (never silent).
defer() {
  # defer <nk> <intended-state> <reason> <manual-hint>
  outbox_append "$1" "$2" "$3" "$4"
  DEFERRED=$((DEFERRED + 1))
  info "deferred: $1 → \"$2\" ($3)"
}

# attach_child — DR-1 attach as a SINGLE swappable function, ONE call site.
# Default: the child was created/updated with its `parent` field set to the
# Circle's Plane UUID (folded into the write body — no extra call). We verify
# from that same response (Martin's "verify the field with one call"); if the
# self-hosted instance rejected/ignored `parent`, fall back to the verified
# issues/{id}/links/ endpoint (a link on the parent pointing at the child).
attach_child() {
  # attach_child <child_id> <parent_id> <title> <response_json>
  local child_id="$1" parent_id="$2" title="$3" resp="$4" got
  got="$(printf '%s' "$resp" | jq -r '.parent // empty' 2>/dev/null || true)"
  if [ "$got" = "$parent_id" ]; then
    return 0   # sub-issue parent accepted — done, no extra call
  fi
  # Fallback: verified links endpoint.
  local body
  body="$(jq -cn --arg u "$(issue_web_url "$child_id")" --arg t "$title" '{url:$u, title:$t}')"
  if plane_curl POST "$BASE/issues/${parent_id}/links/" "$body"; then
    case "$PLANE_HTTP_CODE" in
      2*) return 0 ;;
    esac
  fi
  info "attach fallback (links) did not confirm for child $child_id → parent $parent_id"
  return 1
}

# process_artifact — the per-artifact core, shared by dry-run and live modes.
process_artifact() {
  # process_artifact <kind> <file> <natural-key> <parent-key>
  local kind="$1" file="$2" nk="$3" parent_key="$4"
  local base marker canonical inst title relpath existing_id existing_state op
  local origin write_scope
  base="$(basename "$file")"
  marker="$(marker_from_filename "$base")"
  if [ -z "$marker" ]; then
    info "skip (no marker parsed): $file"
    return 0
  fi
  canonical="$(canonical_state_for "$kind" "$marker")"
  if [ -z "$canonical" ]; then
    info "skip (marker '$marker' has no $kind state): $file"
    return 0
  fi
  inst="$(cfg_state "$canonical")"; [ -n "$inst" ] || inst="$canonical"
  title="$(artifact_title "$file" "$nk")"
  relpath="${file#"$WORKBENCH"/}"

  existing_id="$(map_get_id "$nk")"
  existing_state="$(map_get_state "$nk")"
  if [ -z "$existing_id" ]; then
    op="create"
  elif [ "$existing_state" != "$canonical" ]; then
    op="update"
  else
    op="noop"
  fi

  # ── THE seed-origin branch — one decision, one place ────────────────────────
  # A seed-origin issue is a HUMAN's Plane story that fusion merely bound to a
  # Circle. Mirroring fusion's body onto it would destroy the story text, so the
  # push writes state and nothing else. Everything fusion authored itself keeps
  # the full-body mirror. Decided in
  # circles/260719-1536-plane-mirror-integration/decisions/
  # 260719-2313_*_round-trip-write-overwrites-origin-story-description.md (Option 1).
  origin="$(map_get_origin "$nk")"
  if [ "$origin" = "seed" ]; then write_scope="state-only"; else write_scope="full"; fi

  # The kind label rides on the SAME branch: fusion-owned artifacts get one, a
  # human's seeded story does not (decision 260719-2313 — state writes only).
  local label_name=""
  if [ "$write_scope" = "full" ]; then
    label_name="$(cfg_label "$kind")"
    [ -n "$label_name" ] || label_name="$kind"
  fi

  if [ "$DRYRUN" -eq 1 ]; then
    # Dry-run: emit only actionable ops (create/update); a fully reconciled
    # Circle yields an empty ops list — the idempotency property, observable.
    if [ "$op" != "noop" ]; then
      OPS+=("$(op_json "$op" "$kind" "$nk" "$title" "$marker" "$canonical" "$inst" "$existing_id" "$parent_key" "$relpath" "$write_scope" "$label_name")")
    fi
    # Spec-comment (opt-in): a SEPARATE op — never a field on op_json, because a
    # noop Circle emits no op_json yet still refreshes its comment (fork 1). So
    # this is emitted for a Circle whenever the gate is on, independent of
    # create/update/noop. The PATCH-vs-POST branch is resolved offline from the
    # comments fixture (a captured GET issues/<id>/comments/): a marker match →
    # PATCH + that comment_id, otherwise POST; with no fixture the method is POST.
    if [ "$kind" = circle ] && spec_comment_enabled; then
      local comment_html cmethod="POST" cid="" cbody
      # The build is a SEPARATE statement from the `.comment_html` extraction. As
      # one pipe, only the second jq's status survived, and that one succeeds on
      # what an unreadable record leaves behind — measured at c923935, the op
      # carried `<!-- fusion-spec-comment:… -->\n<pre></pre>`, the marker with the
      # record body gone, and the live path would have pushed it over the brief
      # (issue 260810-0750). There is no `pipefail` in this file to catch that.
      if ! cbody="$(build_comment_body "$file" "$nk")"; then
        comment_skip "record unreadable: $file" || true
      else
        comment_html="$(printf '%s' "$cbody" | jq -r '.comment_html')"
        if [ -n "$COMMENTS_FIXTURE" ] && [ -f "$COMMENTS_FIXTURE" ]; then
          cid="$(comment_id_for_marker "$(cat "$COMMENTS_FIXTURE")" "$nk" || true)"
          [ -n "$cid" ] && cmethod="PATCH"
        fi
        OPS+=("$(jq -cn --arg op "spec-comment" --arg nk "$nk" --arg marker "$marker" \
          --arg html "$comment_html" --arg method "$cmethod" --arg cid "$cid" \
          '{op:$op, natural_key:$nk, kind:"circle", marker:$marker,
            comment_html:$html, method:$method}
           + (if $cid=="" then {} else {comment_id:$cid} end)')")
      fi
    fi
    return 0
  fi

  # ── Live mode ──────────────────────────────────────────────────────────────
  # state_ok tracks whether Plane now carries the correct state for this artifact
  # — set ONLY on a 2xx state write OR on a noop (already correct), NEVER on a
  # defer path. It is a local, so it is re-initialised to 0 on every
  # process_artifact call and can never leak across artifacts in the --all loop.
  # It is the sole gate on the spec-comment tail: a deferred state write leaves it
  # 0, so the comment is never attempted after a deferral (C4 invariant).
  local state_ok=0

  if [ "$op" != "noop" ]; then
    # If we already hit a rate limit this run, defer the remainder (C4).
    if [ "$RATE_LIMITED" -eq 1 ]; then
      defer "$nk" "$canonical" "rate limit (429) earlier this run" "$(manual_hint "$op" "$nk" "$canonical" "$existing_id")"
      return 0
    fi

    local uuid parent_id="" body resp new_id label_id=""
    uuid="$(resolve_canonical_state "$canonical" || true)"
    if [ -z "$uuid" ]; then
      defer "$nk" "$canonical" "state name unresolved on instance" \
        "Set the Plane issue to a state matching \"$canonical\" (name not found in states/)."
      return 0
    fi
    if [ -n "$parent_key" ]; then
      parent_id="$(map_get_id "$parent_key")"
    fi

    # Resolve the kind label (name → UUID, creating it if the board lacks it). A
    # failure here is metadata-only: label_id stays empty, the body carries no
    # labels, and the state transition proceeds unaffected.
    if [ -n "$label_name" ]; then
      label_id="$(resolve_kind_label "$kind" || true)"
    fi

    # Build write body. Embed the natural key in the description so a lost map can
    # be rebuilt (push --rebuild-map). Fold in `parent` (DR-1 default) when a
    # parent exists, and the kind label when one resolved.
    body="$(build_write_body "$kind" "$title" "$nk" "$relpath" "$uuid" "$parent_id" "$write_scope" "$label_id")"

    if [ "$op" = "create" ]; then
      if ! plane_curl POST "$BASE/issues/" "$body"; then
        defer "$nk" "$canonical" "no network (curl rc $PLANE_CURL_RC)" \
          "POST a new Plane issue for $nk and set state \"$canonical\"."
        return 0
      fi
    else
      if ! plane_curl PATCH "$BASE/issues/${existing_id}/" "$body"; then
        defer "$nk" "$canonical" "no network (curl rc $PLANE_CURL_RC)" \
          "$(manual_hint update "$nk" "$canonical" "$existing_id")"
        return 0
      fi
    fi

    case "$PLANE_HTTP_CODE" in
      2*)
        resp="$PLANE_BODY"
        if [ "$op" = "create" ]; then
          new_id="$(printf '%s' "$resp" | jq -r '.id // empty' 2>/dev/null || true)"
          if [ -z "$new_id" ]; then
            defer "$nk" "$canonical" "create returned no id (HTTP $PLANE_HTTP_CODE)" \
              "Create the Plane issue for $nk manually and set state \"$canonical\"."
            return 0
          fi
          # fusion POSTed this issue, so fusion owns its body — record that.
          #
          # THE MAP WRITE IS PART OF THE PUSH, not bookkeeping after it. The issue
          # now exists in Plane; if its UUID does not reach the map, the next push
          # finds no mapping and POSTs a SECOND issue for the same record — issue
          # 260807-1939, which this mirror exists to close, re-entered from the
          # write side. So a failed write is deferred like any other incomplete
          # transition, with the UUID in the note so the operator holds the handle.
          if ! map_set "$nk" "$new_id" "$kind" "$canonical" fusion; then
            defer "$nk" "$canonical" "Plane issue $new_id was created but the map write failed" \
              "The issue EXISTS at $(issue_web_url "$new_id") — do not create another. Restore write access to $MAP and re-run the push; until its UUID is recorded, the next push creates a duplicate for $nk."
            return 0
          fi
          existing_id="$new_id"
        else
          # Update: origin omitted => preserved (a seed entry stays seed). A failed
          # write here costs no duplicate (the mapping survives), only a stale
          # last_state that makes the next push repeat this PATCH — but the run
          # still did not record what it did, so it defers rather than reports ok.
          if ! map_set "$nk" "$existing_id" "$kind" "$canonical"; then
            defer "$nk" "$canonical" "the state was written in Plane but the map write failed" \
              "$(manual_hint update "$nk" "$canonical" "$existing_id")"
            return 0
          fi
        fi
        # DR-1 attach — single call site.
        if [ -n "$parent_id" ]; then
          attach_child "$existing_id" "$parent_id" "$title" "$resp" || true
        fi
        PUSHED=$((PUSHED + 1))
        state_ok=1
        sleep 0.2   # pace calls under 60/min
        ;;
      429)
        RATE_LIMITED=1
        defer "$nk" "$canonical" "rate limit (HTTP 429)" \
          "$(manual_hint "$op" "$nk" "$canonical" "$existing_id")"
        ;;
      *)
        defer "$nk" "$canonical" "HTTP $PLANE_HTTP_CODE: $(printf '%s' "$PLANE_BODY" | head -c 200)" \
          "$(manual_hint "$op" "$nk" "$canonical" "$existing_id")"
        ;;
    esac
  else
    # State noop: Plane already carries the correct state for this artifact. No
    # write is needed or made — but the state IS correct, so a Circle's opt-in
    # spec-comment should still refresh (fork 1: fire on every non-deferred push,
    # including a Backlog→Backlog re-push of an edited anticipated-Circle brief).
    state_ok=1
  fi

  # ── Spec-comment tail (opt-in, auxiliary, non-blocking) ─────────────────────
  # Single call site, gated ONLY on kind=circle + the opt-in + state_ok — NOT on
  # write_scope, so a seed-origin (state-only) Circle still gets its brief as a
  # comment while its description stays untouched (decision 260719-2313). Because
  # state_ok is set only on a 2xx write or a noop and every defer path returned or
  # left it 0, a deferred state write never reaches upsert_spec_comment. The
  # `|| true` keeps the internal comment_skip (return 1) from tripping set -e,
  # exactly as the resolve_kind_label call guards label_skip. existing_id holds
  # the new id after a create, the mapped id on update/noop.
  if [ "$state_ok" -eq 1 ] && [ "$kind" = circle ] && spec_comment_enabled; then
    upsert_spec_comment "$file" "$nk" "$existing_id" || true
  fi
}

# build_write_body — the create/PATCH JSON. state UUID is resolved (live only).
# Two shapes, selected by <write_scope> (computed once in process_artifact):
#   state-only  seed-origin issue — PATCH the state and NOTHING else. No name, no
#               description_html, no parent, NO LABEL: the human's story is
#               untouched beyond its state (decision 260719-2313).
#   full        fusion-owned issue — the mirror body (title + fusion-key-bearing
#               description + state, plus `parent` when it has one and the kind
#               label when one resolved).
# An empty <label_uuid> simply omits `labels` — the push never blocks on a label.
build_write_body() {
  # build_write_body <kind> <title> <nk> <relpath> <state_uuid> <parent_id> <write_scope> <label_uuid>
  local kind="$1" title="$2" nk="$3" relpath="$4" uuid="$5" parent_id="$6" scope="${7:-full}" label="${8:-}"
  local desc

  if [ "$scope" = "state-only" ]; then
    jq -cn --arg state "$uuid" '{state:$state}'
    return 0
  fi

  desc="$(printf 'Mirrored fusion %s.\n\nfusion-key: %s\nsource: %s' "$kind" "$nk" "$relpath")"
  jq -cn --arg name "$title" --arg desc "$desc" --arg state "$uuid" --arg parent "$parent_id" \
    --arg label "$label" \
    '{name:$name, description_html:("<p>"+$desc+"</p>"), state:$state}
     + (if $parent=="" then {} else {parent:$parent} end)
     + (if $label=="" then {} else {labels:[$label]} end)'
}

# manual_hint — the exact transition a human would make in the Plane UI, printed
# on the absent-key / deferred path (Martin's fallback doctrine).
manual_hint() {
  # manual_hint <op> <nk> <canonical> <plane_id>
  local op="$1" nk="$2" canonical="$3" pid="$4"
  if [ "$op" = "create" ] || [ -z "$pid" ]; then
    printf 'In Plane, create an issue for "%s" and set its state to "%s".' "$nk" "$canonical"
  else
    printf 'In Plane, open %s and set its state to "%s".' "$(issue_web_url "$pid")" "$canonical"
  fi
}

# ── Reconcile one Circle / shared / all ──────────────────────────────────────
resolve_circle_dir() {
  local arg="$1"
  if [ -d "$arg" ]; then
    CIRCLE_DIR="$arg"
  elif [ -d "$WORKBENCH/circles/$arg" ]; then
    CIRCLE_DIR="$WORKBENCH/circles/$arg"
  else
    err "circle not found: $arg (looked at '$arg' and '$WORKBENCH/circles/$arg')"
    return 1
  fi
}

reconcile_circle() {
  local dir="$1" name record f
  name="$(basename "$dir")"
  record="$(ls "$dir"/*_circle.md 2>/dev/null | head -n1 || true)"
  if [ -z "$record" ]; then
    info "no *_circle.md in $dir — skipping"
    return 0
  fi
  process_artifact circle "$record" "$name" ""
  if [ -d "$dir/issues" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] && process_artifact fusion-issue "$f" "$(natural_key "$name" issues "$f")" "$name"
    done < <(ls "$dir"/issues/*.md 2>/dev/null | LC_ALL=C sort)
  fi
  if [ -d "$dir/decisions" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] && process_artifact decision "$f" "$(natural_key "$name" decisions "$f")" "$name"
    done < <(ls "$dir"/decisions/*.md 2>/dev/null | LC_ALL=C sort)
  fi
  # Drain the outbox for this Circle only when its reconcile fully succeeded
  # (live mode, nothing deferred). Correctness is restored by the next reconcile.
  if [ "$DRYRUN" -eq 0 ] && [ "$DEFERRED" -eq 0 ]; then
    outbox_drain_circle "$name"
  fi
}

# Shared artifacts have no Circle record → top-level Plane issues (no parent).
reconcile_shared() {
  local f
  if [ -d "$WORKBENCH/shared/issues" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] && process_artifact fusion-issue "$f" "$(natural_key shared issues "$f")" ""
    done < <(ls "$WORKBENCH"/shared/issues/*.md 2>/dev/null | LC_ALL=C sort)
  fi
  if [ -d "$WORKBENCH/shared/decisions" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] && process_artifact decision "$f" "$(natural_key shared decisions "$f")" ""
    done < <(ls "$WORKBENCH"/shared/decisions/*.md 2>/dev/null | LC_ALL=C sort)
  fi
}

reconcile_all() {
  local d
  if [ -d "$WORKBENCH/circles" ]; then
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      reconcile_circle "${d%/}"
    done < <(ls -d "$WORKBENCH"/circles/*/ 2>/dev/null | LC_ALL=C sort)
  fi
  reconcile_shared
}

emit_plan() {
  if [ "${#OPS[@]}" -eq 0 ]; then
    printf '{"ops":[]}\n'
  else
    printf '%s\n' "${OPS[@]}" | jq -s '{ops: .}'
  fi
}

# JQ_REBUILD_MAP — reconstruct the natural-key → Plane-UUID map from a
# `GET issues/` response by reading the embedded `fusion-key:` line back out.
#
# FIELD FALLBACK (must stay consistent with the seed path's
# `.description_stripped // .description_html`): different Plane builds populate
# different body fields, and `build_write_body` writes the key into
# `description_html`. Reading only ONE field made the whole map-loss recovery
# path fail silently on any instance that does not derive one field from the
# other — the board looked correct while rebuild found nothing. So try all three,
# in the seed path's order, and take the first that yields a key.
#
# `select(type=="string")` is load-bearing: Plane's `description` is a
# ProseMirror document (an object) on some builds, and `capture` errors on a
# non-string input — which the caller's `2>/dev/null` would have turned into a
# bare "could not parse issues".
#
# `stable_key` is load-bearing too, and for a reason the rest of this file cannot
# reach: what sits in an already-created Plane issue's description is the key that
# was current when fusion POSTed it, and before issue 260807-1939 that key carried
# the state marker. Read back verbatim, a rebuild would restore exactly the
# marker-bearing mapping the next transition invalidates — which is why
# `--rebuild-map` was no recovery path for that defect. Normalising on the way in
# makes it one.
#
# COLLISION RULE — the same rule as JQ_MIGRATE_MAP's, expressed in the data a
# rebuild actually has (issue 260810-0457). Two Plane issues can carry the same
# `fusion-key:`, which is precisely the duplicate pair the marker-in-the-key defect
# produced, and the board being rebuilt from is by construction a board carrying
# them. This used to assign without a guard, so the winner was whichever the API
# returned last and the loser vanished unreported. Now every group of candidates
# for one key is ORDERED, and the ordering is a single total one rather than a
# ladder of special cases — later beats earlier on:
#
#   1. the UUID the current map already records under that key. That entry is the
#      issue fusion has been PATCHing, which is the migration's "most recently
#      pushed wins" answered from better evidence than the rebuild has of its own.
#   2. `updated_at` — the most recently touched issue, the migration's rule read
#      off Plane, since a rebuilt entry has no `last_pushed` to compare.
#   3. the UUID string, so a tie never resolves by API result order.
#
# A GROUP IS RANKED OVER ENTRIES, A COLLISION IS OVER DISTINCT ISSUES (issue
# 260810-0748). One Plane issue can appear twice in the SAME `GET issues/`
# response — pagination overlap, a retried page, a fixture assembled from two
# captures — and then it lands in both `win` and `lost`, and the report tells the
# operator to close by hand the very issue the rebuild just bound. So the winner's
# id is SUBTRACTED from the losers, the remainder is deduplicated, and the group is
# reported only if something is left: a repeated issue is a no-op, not a collision
# resolved. Subtracted after the ranking rather than deduplicated before it, on
# purpose — `unique_by(.id)` would keep whichever copy the input happened to sort
# first and rank the issue by that copy's `updated_at`, so a stale copy arriving
# first could hand the key to a distinct issue that merely looks newer, which is
# the API-result-order dependence rule 3 exists to remove. Ranking all entries and
# subtracting afterwards represents a repeated issue by its freshest copy.
#
# AN ENTRY WITHOUT A USABLE `id` IS DROPPED AT EXTRACTION, exactly the way an
# entry without an embedded key is (issue 260810-0939). `id: .id` used to bind
# unguarded while the sibling field one line up was guarded, and the two costs of
# that were: an entry reached the rebuilt map as `plane_id: null`, which
# `map_get_id`'s `// empty` reads as "no mapping" anyway, so the next push CREATES
# rather than PATCHing; and two DISTINCT id-less entries both ranked as `null`,
# where `[null] - [null]` is empty and the collision above went silent. Guarding at
# extraction removes both, and leaves the subtraction operating only on real UUIDs,
# where it is provably correct.
#
# Dropped is not silent, because nothing here is: the keys it costs come back in
# `.skipped`, with a count per key, and the caller reports them beside the
# collisions and the orphans. Plane's `GET issues/` always returns `id`, so the
# live path cannot reach this — the reachable route is the `--fixture` seam, and a
# fixture that says nothing about what it dropped is a fixture that debugs nothing.
#
# The losers are returned in `.collisions` and reported by the caller; `.orphans`
# carries the entries the CURRENT map has that this rebuild did not find, because
# a rebuild replaces the map wholesale (see rebuild_map).
JQ_REBUILD_MAP="$JQ_STABLE_KEY"'
  ($cur // {}) as $current
  | (.results? // .) as $issues
  | [ $issues[]
      | ( [.description_stripped, .description_html, .description]
          | map(select(type == "string"))
          | map(capture("fusion-key: (?<k>[^\n<]+)").k)
          | (.[0] // "") ) as $key
      | select($key != "")
      | { key: ($key|ltrimstr(" ")|rtrimstr(" ")|stable_key),
          id: .id,
          updated: (.updated_at // "") } ] as $found
  | ( $found | map(select((.id | type) == "string" and .id != "")) ) as $usable
  | ( $found | map(select(((.id | type) != "string") or .id == ""))
             | group_by(.key)
             | map({ key: .[0].key, count: length }) ) as $skipped
  | $usable
  | group_by(.key)
  | map( .[0].key as $k
       | ( sort_by([ (if .id == ($current[$k].plane_id // "") then 1 else 0 end),
                     .updated, .id ]) ) as $ranked
       | ( $ranked | last ) as $win
       | { key: $k, win: $win,
           lost: ( ( [ $ranked[:-1][].id ] - [ $win.id ] ) | unique ) } )
  | { map: ( ( map({ (.key): {plane_id: .win.id, kind:"unknown", last_state:"", last_pushed:""} })
               | add ) // {} ),
      collisions: ( map(select((.lost|length) > 0)
                        | {key: .key, kept: .win.id, dropped: .lost}) ),
      skipped: $skipped,
      orphans: ( ( ($current|keys) - map(.key) )
                 | map({ key: ., plane_id: $current[.].plane_id,
                         origin: ($current[.].origin // "fusion") }) ) }'

# JQ_REBUILD_REPORT — one human line per UUID the rebuild does not carry forward,
# read off the structure JQ_REBUILD_MAP returns. Kept beside it so the two cannot
# drift: a field renamed in one is a missing line in the other.
JQ_REBUILD_REPORT='
  ( .collisions[]
    | "two or more Plane issues carry the key \(.key) — kept \(.kept), DROPPED \(.dropped|join(", ")). Each dropped UUID is a duplicate issue still on the board; close it by hand." ),
  ( .skipped[]
    | "\(.count) issue(s) carrying the key \(.key) came back with no id — SKIPPED: an issue the response does not identify cannot be mapped. Nothing was lost from Plane, and nothing in the rebuilt map points at those issue(s)." ),
  ( .orphans[]
    | "the map entry \(.key) -> \(.plane_id) (origin=\(.origin)) carries no fusion-key in Plane and is gone from the rebuilt map"
      + (if .origin == "seed"
         then " — it was a seed binding, so re-bind it with: seed --record-origin \(.key) \(.plane_id)   (otherwise the next push may overwrite that human'"'"'s story)"
         else "." end) )'

# rebuild_map [<fixture>] — reconstruct .plane-map.json from Plane by reading the
# embedded fusion-key out of each issue's body (live; best-effort). With a fixture
# path, read the captured issues JSON from that file instead of the wire (test
# seam; no curl, no key needed).
#
# TWO commands end here and share this body exactly: `map --rebuild`, which stops
# when this returns, and `push --rebuild-map`, which continues into the reconcile.
# One rebuild, two things done with it — there is no second implementation to keep
# in step (issue 260810-0939).
#
# A rebuild REPLACES the map; it does not merge into it. What Plane's issue bodies
# carry is the whole of what a rebuild can know, and an entry the rebuild cannot
# see is therefore dropped — most importantly a seed-origin binding, whose Plane
# issue is a human's own story and carries no `fusion-key:` line at all
# (`build_write_body` writes `{state:…}` only for scope "state-only"). Dropping it
# loses `origin:"seed"`, after which a push may overwrite that human's title. The
# entries this costs are listed by key and UUID before the write, so the operator
# can re-bind them with `seed --record-origin`; they are not merged back silently,
# because a rebuild that quietly kept unverifiable entries would stop being the
# rebuild-from-Plane the recovery path is documented as.
rebuild_map() {
  local fixture="${1:-}" issues_json tmp
  if [ -n "$fixture" ]; then
    [ -f "$fixture" ] || { err "rebuild-map: fixture not found: $fixture"; return "$EXIT_CONFIG"; }
    info "rebuilding .plane-map.json from fixture $fixture (embedded fusion-key)…"
    issues_json="$(cat "$fixture")"
  else
    info "rebuilding .plane-map.json from Plane (embedded fusion-key)…"
    if ! plane_curl GET "$BASE/issues/?per_page=100"; then
      err "rebuild-map: Plane unreachable (curl rc $PLANE_CURL_RC) — map not changed"
      return "$EXIT_DEFERRED"
    fi
    case "$PLANE_HTTP_CODE" in
      2*) issues_json="$PLANE_BODY" ;;
      *)  err "rebuild-map: HTTP $PLANE_HTTP_CODE — map not changed"; return "$EXIT_DEFERRED" ;;
    esac
  fi
  local current="{}"
  map_view
  [ -f "$MAP_VIEW" ] && current="$(cat "$MAP_VIEW")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/fusion-plane-rebuild.XXXXXX")"
  printf '%s' "$issues_json" | jq --argjson cur "$current" "$JQ_REBUILD_MAP" > "$tmp" 2>/dev/null \
    || { err "rebuild-map: could not parse issues"; rm -f "$tmp"; return "$EXIT_CONFIG"; }
  # jq exits 0 on EMPTY input and writes nothing, so the status above does not say
  # the response arrived. An empty $issues_json (an empty 2xx body, an unreadable
  # fixture) would walk this whole function reporting nothing and end by replacing
  # the map with a zero-byte file — every mapping lost, exit 0.
  if [ ! -s "$tmp" ]; then
    err "rebuild-map: the issues response was empty — map not changed"
    rm -f "$tmp"
    return "$EXIT_CONFIG"
  fi

  # Never silent, and named rather than counted: a UUID this rebuild does not
  # carry into the new map is a Plane issue that stays on the board with nothing
  # pointing at it, and that string is the only handle a human has on it. A report
  # that could not be produced says so rather than reading as "nothing was lost".
  local line report
  if ! report="$(jq -r "$JQ_REBUILD_REPORT" "$tmp" 2>/dev/null)"; then
    err "rebuild-map: could not list the mappings this rebuild drops — proceeding, but no UUID below names them"
    report=""
  fi
  printf '%s\n' "$report" \
    | while IFS= read -r line; do
        [ -z "$line" ] || err "rebuild-map: $line"
      done

  local out
  out="$(mktemp "${TMPDIR:-/tmp}/fusion-plane-rebuild.XXXXXX")"
  jq -S '.map' "$tmp" > "$out" 2>/dev/null \
    || { err "rebuild-map: could not parse issues"; rm -f "$tmp" "$out"; return "$EXIT_CONFIG"; }
  rm -f "$tmp"
  map_put "$out" || return "$EXIT_CONFIG"
  info "rebuild-map: wrote $(jq 'length' "$MAP") entries"
}

# ── Subcommands ──────────────────────────────────────────────────────────────
cmd_push() {
  local target="" want_all=0 rebuild=0 rebuild_fixture=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --plan)        DRYRUN=1 ;;
      --all)         want_all=1 ;;
      # --closure is accepted as a no-op for forward-compat with the orchestrator
      # wiring. The Done transition it implies is ALREADY handled by the
      # marker→state mapping (a _c_/_b_ Circle maps to Done), so the flag itself
      # changes nothing. The full-spec comment hook it once gated is now
      # IMPLEMENTED as the `spec_comment` opt-in (config, default off) and fires on
      # EVERY Circle push — not closure-gated — so it needs no flag of its own.
      --closure)     CLOSURE=1 ;;
      --rebuild-map) rebuild=1 ;;
      # Test seam: rebuild the map from a captured `GET issues/` response.
      --fixture)     shift; rebuild_fixture="${1:-}"; [ -n "$rebuild_fixture" ] || { err "push: --fixture needs a path"; return "$EXIT_USAGE"; } ;;
      --fixture=*)   rebuild_fixture="${1#--fixture=}" ;;
      # Test seam: drive the spec-comment PATCH-vs-POST branch offline from a
      # captured `GET issues/<id>/comments/` response. DISTINCT from the rebuild
      # --fixture above (that one is a captured `GET issues/`).
      --comments-fixture)   shift; COMMENTS_FIXTURE="${1:-}"; [ -n "$COMMENTS_FIXTURE" ] || { err "push: --comments-fixture needs a path"; return "$EXIT_USAGE"; } ;;
      --comments-fixture=*) COMMENTS_FIXTURE="${1#--comments-fixture=}" ;;
      --circle)      shift; target="${1:-}"; [ -n "$target" ] || { err "--circle needs a directory"; return "$EXIT_USAGE"; } ;;
      --circle=*)    target="${1#--circle=}" ;;
      *)             err "push: unknown flag '$1'"; return "$EXIT_USAGE" ;;
    esac
    shift
  done
  [ "${FUSION_PLANE_DRYRUN:-0}" = "1" ] && DRYRUN=1
  [ -z "$rebuild_fixture" ] && [ -n "${FUSION_PLANE_ISSUES_FIXTURE:-}" ] && rebuild_fixture="$FUSION_PLANE_ISSUES_FIXTURE"
  [ -z "$COMMENTS_FIXTURE" ] && [ -n "${FUSION_PLANE_COMMENTS_FIXTURE:-}" ] && COMMENTS_FIXTURE="$FUSION_PLANE_COMMENTS_FIXTURE"

  # ── --rebuild-map + a dry run is a CONTRADICTION, and it is refused here ─────
  # A rebuild REPLACES .plane-map.json; `--plan` is documented, in four places, as
  # writing nothing. The pair asks for both at once, and every way of resolving it
  # in favour of one side was a defect: the fixture spelling performed the rebuild
  # under `--plan` (issue 260810-0746), the flagless spelling dropped the flag
  # without a word (issue 260810-0747, against this file's own `map_forget`
  # doctrine that an absent mutation is reported, never silent).
  #
  # It is refused rather than downgraded to "planned", for a reason the op list
  # makes concrete: `--plan`'s whole output is the ops computed FROM the map, so a
  # run that reported a planned rebuild would then emit ops computed against the
  # map the rebuild would have replaced — a plan for a board that will not exist by
  # the time it is executed. Producing a truthful one means performing the
  # rebuild's effect on the view, i.e. doing the mutation the flag was refused for.
  # One check, before any work, covering both spellings and both dry-run sources.
  if [ "$rebuild" -eq 1 ] && [ "$DRYRUN" -eq 1 ]; then
    local dry_src="--plan"
    if [ "${FUSION_PLANE_DRYRUN:-0}" = "1" ]; then dry_src="FUSION_PLANE_DRYRUN=1"; fi
    err "push: --rebuild-map replaces .plane-map.json and $dry_src says this run writes nothing — refusing the pair rather than honouring one of them."
    err "push:   the rebuild is a command of its own. Run it, read what it reports, then plan against the rebuilt map:"
    err "push:     $SELF map --rebuild"
    err "push:     $SELF plan --circle <dir>"
    err "push:   Two commands, deliberately not chained into one: a rebuild that cannot reach Plane exits $EXIT_DEFERRED having changed nothing, and a chain would then drop the plan without a word. Run the first, read what it reports, then run the second."
    return "$EXIT_USAGE"
  fi

  resolve_workbench || return "$EXIT_CONFIG"
  cfg_load          || return "$EXIT_CONFIG"
  build_base

  # NO map_ensure here. This point is reached by `push --plan` and by `plan`, both
  # documented as changing nothing, and the fold that used to sit behind
  # `map_ensure` rewrote the file — destroying a Plane UUID on exactly the legacy
  # map it existed to repair (issue 260810-0456). Lookups fold through `map_view`
  # instead; the file is written only where this function actually writes it.
  #
  # map_view IS called here, though, and this is the only place in a push that
  # calls it: the read view is built ONCE, in this shell, because every lookup that
  # follows runs inside a command substitution and a fold built there dies with the
  # subshell (issue 260810-0744). It reads $MAP and writes nothing, so the dry-run
  # property above is untouched.
  map_view

  # A fixture-driven rebuild needs neither key nor network, so it runs ahead of the
  # live gate's config+key checks below (and clears the flag, leaving that branch
  # untouched). It is a WRITE nonetheless, and this placement used to be how it
  # reached the file under `--plan` (issue 260810-0746); it cannot now, because a
  # dry run carrying `--rebuild-map` never gets past the refusal above.
  if [ "$rebuild" -eq 1 ] && [ -n "$rebuild_fixture" ]; then
    rebuild_map "$rebuild_fixture" || return "$?"
    rebuild=0
  fi

  # Live commands need config + key; dry-run needs neither network nor key.
  if [ "$DRYRUN" -eq 0 ]; then
    config_valid || return "$EXIT_CONFIG"
    if ! plane_key_present; then
      # Absent key: attempt NO call. Emit the manual transitions to the outbox
      # and to the operator, return the deferred status (Martin's doctrine).
      info "PLANE_API_KEY absent — no calls made; recording manual transitions."
      emit_manual_only "$want_all" "$target" "PLANE_API_KEY absent"
      return "$EXIT_DEFERRED"
    fi
    if [ "$rebuild" -eq 1 ]; then
      rebuild_map || true
    fi
    if ! fetch_states; then
      err "states/ unreachable — deferring this push (C4)."
      emit_manual_only "$want_all" "$target" "Plane unreachable (states/ — curl rc $PLANE_CURL_RC / HTTP ${PLANE_HTTP_CODE:-none})"
      return "$EXIT_DEFERRED"
    fi
  fi

  if [ "$want_all" -eq 1 ]; then
    reconcile_all
  elif [ -n "$target" ]; then
    resolve_circle_dir "$target" || return "$EXIT_CONFIG"
    reconcile_circle "$CIRCLE_DIR"
  else
    err "push: specify --circle <dir> or --all"
    return "$EXIT_USAGE"
  fi

  if [ "$DRYRUN" -eq 1 ]; then
    # The op list IS the dry run's whole output, and its consumers parse it: an
    # unemitted plan must not leave exit 0 behind for them to read as "no ops".
    emit_plan || { err "push --plan: could not emit the op list"; return "$EXIT_CONFIG"; }
    return "$EXIT_OK"
  fi

  # Live summary — never silent. An unresolvable kind label is reported here too,
  # but it is metadata: it never turns an ok push into a deferred one.
  local label_note=""
  if [ "$LABELS_SKIPPED" -gt 0 ]; then
    label_note="$(printf ' — %d kind label(s) unavailable, pushed without them' "$LABELS_SKIPPED")"
  fi
  # A skipped spec-comment is metadata too (never a deferral); fold it into the
  # same note, same shape as the label clause.
  if [ "$COMMENTS_SKIPPED" -gt 0 ]; then
    label_note="$(printf '%s — %d spec-comment(s) skipped' "$label_note" "$COMMENTS_SKIPPED")"
  fi
  if [ "$DEFERRED" -gt 0 ]; then
    printf 'STATUS: deferred (%d pushed, %d deferred)%s — see %s\n' "$PUSHED" "$DEFERRED" "$label_note" "$OUTBOX"
    return "$EXIT_DEFERRED"
  fi
  printf 'STATUS: ok (%d pushed)%s\n' "$PUSHED" "$label_note"
  return "$EXIT_OK"
}

# emit_manual_only — absent-key / states-unreachable path: walk the target's
# artifacts and record a manual-transition outbox note for each (no calls). The
# reason is passed in so the note is accurate (key-absent vs Plane-down).
emit_manual_only() {
  local want_all="$1" target="$2" reason="$3"
  # Record one deferral note per artifact. The manual hint is map-aware: an
  # already-mirrored artifact points at its Plane issue URL; a new one asks for
  # a create.
  _manual_defer() {
    local kind="$1" nk="$2" file="$3" marker canonical op pid
    marker="$(marker_from_filename "$(basename "$file")")"
    canonical="$(canonical_state_for "$kind" "$marker")"
    [ -n "$canonical" ] || return 0
    pid="$(map_get_id "$nk")"
    if [ -n "$pid" ]; then op="update"; else op="create"; fi
    defer "$nk" "$canonical" "$reason" "$(manual_hint "$op" "$nk" "$canonical" "$pid")"
  }
  _manual_walk_circle() {
    local dir="$1" name record f
    name="$(basename "$dir")"
    record="$(ls "$dir"/*_circle.md 2>/dev/null | head -n1 || true)"
    if [ -n "$record" ]; then _manual_defer circle "$name" "$record"; fi
    for f in "$dir"/issues/*.md; do
      if [ -e "$f" ]; then _manual_defer fusion-issue "$(natural_key "$name" issues "$f")" "$f"; fi
    done
    for f in "$dir"/decisions/*.md; do
      if [ -e "$f" ]; then _manual_defer decision "$(natural_key "$name" decisions "$f")" "$f"; fi
    done
  }
  if [ "$want_all" -eq 1 ]; then
    local d
    for d in "$WORKBENCH"/circles/*/; do if [ -d "$d" ]; then _manual_walk_circle "$d"; fi; done
  elif [ -n "$target" ]; then
    resolve_circle_dir "$target" && _manual_walk_circle "$CIRCLE_DIR"
  fi
  printf 'STATUS: deferred (0 pushed, %d deferred) — see %s\n' "$DEFERRED" "$OUTBOX"
}

cmd_plan() {
  # Alias for `push --plan <same args>`.
  DRYRUN=1
  cmd_push --plan "$@"
}

cmd_states() {
  resolve_workbench || return "$EXIT_CONFIG"
  cfg_load          || return "$EXIT_CONFIG"
  build_base
  config_valid      || return "$EXIT_CONFIG"
  if ! plane_key_present; then
    err "PLANE_API_KEY absent — cannot resolve states/. Export it in ~/.zshrc."
    return "$EXIT_CONFIG"
  fi
  if ! fetch_states; then
    err "states/ unreachable (curl rc $PLANE_CURL_RC / HTTP ${PLANE_HTTP_CODE:-none})."
    return "$EXIT_CONFIG"
  fi
  local canon inst uuid
  printf '%-14s %-20s %s\n' "canonical" "instance-name" "uuid"
  for canon in "Backlog" "Todo" "In Progress" "Done" "Cancelled"; do
    inst="$(cfg_state "$canon")"; [ -n "$inst" ] || inst="$canon"
    uuid="$(resolve_canonical_state "$canon" || true)"
    printf '%-14s %-20s %s\n' "$canon" "$inst" "${uuid:-<unresolved>}"
  done
}

# map_forget <natural-key> — drop ONE entry. Reports whether it was there; an
# absent key is a reported failure (EXIT_CONFIG), never a silent no-op, because
# the caller asked for a mutation that did not happen.
map_forget() {
  local nk="$1"
  if [ "$(map_json | jq -r --arg k "$nk" 'has($k)')" != "true" ]; then
    err "map --forget: no such key '$nk' — map not changed"
    printf 'STATUS: not found (%s)\n' "$nk"
    return "$EXIT_CONFIG"
  fi
  map_write 'del(.[$k])' --arg k "$nk" || return "$EXIT_CONFIG"
  printf 'STATUS: forgotten (%s) — %s entries remain\n' "$nk" "$(jq 'length' "$MAP")"
}

# map_migrate — fold the file onto the marker-free keys DELIBERATELY. The fold is
# reachable this way, and only this way, from a command that does nothing else, so
# an operator repairing a legacy board performs the collapse (and reads the dropped
# UUIDs) as the act they asked for. It used to happen as a side effect of any
# lookup, including `map` and `push --plan` (issue 260810-0456).
map_migrate() {
  map_view
  if [ ! -f "$MAP" ]; then
    printf 'STATUS: nothing to migrate (no map at %s)\n' "$MAP"
    return "$EXIT_OK"
  fi
  if [ "$MAP_VIEW" = "$MAP" ]; then
    printf 'STATUS: already marker-free (%s entries) — nothing written\n' "$(jq 'length' "$MAP")"
    return "$EXIT_OK"
  fi
  map_write '.' || return "$EXIT_CONFIG"
  printf 'STATUS: migrated (%s entries)\n' "$(jq 'length' "$MAP")"
}

# map_prune — drop every entry whose Plane issue is DEFINITIVELY gone.
#
# C4 doctrine: only an HTTP 404 counts as gone. A transport failure, a 5xx, a
# 429, an absent key — every "we could not tell" answer leaves the entry alone
# and returns EXIT_DEFERRED. An unreachable Plane must never delete anything;
# that would turn a network outage into map loss.
map_prune() {
  local nk pid keys checked=0 dropped=0 unknown=0
  cfg_load     || return "$EXIT_CONFIG"
  build_base
  config_valid || return "$EXIT_CONFIG"
  if ! plane_key_present; then
    err "map --prune: PLANE_API_KEY absent — cannot confirm any issue is gone; map not changed"
    printf 'STATUS: deferred (0 pruned) — key absent\n'
    return "$EXIT_DEFERRED"
  fi
  # The key list is SNAPSHOT before the loop, not streamed out of the file: the
  # loop replaces the map on every 404, and a reader still walking the file (or
  # the folded view) it just replaced reads whatever is left of it.
  keys="$(map_json | jq -r 'keys[]')"
  while IFS= read -r nk; do
    [ -n "$nk" ] || continue
    pid="$(map_get_id "$nk")"
    [ -n "$pid" ] || continue
    checked=$((checked + 1))
    if ! plane_curl GET "$BASE/issues/${pid}/"; then
      info "prune: keeping '$nk' — Plane unreachable (curl rc $PLANE_CURL_RC), cannot confirm"
      unknown=$((unknown + 1))
      continue
    fi
    case "$PLANE_HTTP_CODE" in
      404)
        map_write 'del(.[$k])' --arg k "$nk" || return "$EXIT_CONFIG"
        info "prune: dropped '$nk' (Plane issue $pid is gone — HTTP 404)"
        dropped=$((dropped + 1))
        ;;
      2*) : ;;
      *)
        info "prune: keeping '$nk' — HTTP $PLANE_HTTP_CODE is not a definitive 404"
        unknown=$((unknown + 1))
        ;;
    esac
    sleep 0.2   # pace calls under 60/min
  done <<PRUNE_KEYS
$keys
PRUNE_KEYS
  if [ "$unknown" -gt 0 ]; then
    printf 'STATUS: deferred (%d pruned of %d checked, %d unconfirmed) — nothing deleted on doubt\n' \
      "$dropped" "$checked" "$unknown"
    return "$EXIT_DEFERRED"
  fi
  printf 'STATUS: ok (%d pruned of %d checked)\n' "$dropped" "$checked"
}

# map_rebuild [<fixture>] — the rebuild AS A COMMAND OF ITS OWN: replace
# .plane-map.json from Plane (or from a captured `GET issues/` response) and stop.
# Same shape as map_migrate — mutate the map, report, return — and the same body as
# `push --rebuild-map`, because both end in rebuild_map(). What differs is only what
# happens next: nothing here, a full reconcile there.
#
# It exists because the refusal of `push --plan --rebuild-map` had nowhere honest to
# send the operator (issue 260810-0939). Its remedy was
# `push --rebuild-map --circle <dir> && plan --circle <dir>`, and that first command
# is a live reconcile: config, key, fetch_states, then POSTs and PATCHes on the
# board. Someone who asked for a PREVIEW was told to mutate Plane to obtain one, and
# the doc printed it under a heading promising nothing goes over the wire. This
# command reads the board — a rebuild is by definition a read of it — and writes
# only the local map.
#
# The live path needs config + key, exactly like map_prune, and answers an absent
# key the same way it answers an unreachable Plane: EXIT_DEFERRED, map not changed.
# Never a rebuild "from nothing", which would empty the map on an outage. The
# fixture path needs neither key nor network (test seam), so it runs ahead of both
# checks.
map_rebuild() {
  local fixture="${1:-}"
  if [ -n "$fixture" ]; then
    rebuild_map "$fixture" || return "$?"
    printf 'STATUS: rebuilt (%s entries, from fixture %s)\n' "$(jq 'length' "$MAP")" "$fixture"
    return "$EXIT_OK"
  fi
  cfg_load     || return "$EXIT_CONFIG"
  build_base
  config_valid || return "$EXIT_CONFIG"
  if ! plane_key_present; then
    err "map --rebuild: PLANE_API_KEY absent — a rebuild reads the board and nothing was read; map not changed"
    printf 'STATUS: deferred (0 rebuilt) — key absent\n'
    return "$EXIT_DEFERRED"
  fi
  rebuild_map || return "$?"
  printf 'STATUS: rebuilt (%s entries)\n' "$(jq 'length' "$MAP")"
}

cmd_map() {
  local forget="" want_prune=0 want_migrate=0 want_rebuild=0 fixture="" key="" mutators=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --forget)   shift; forget="${1:-}"; [ -n "$forget" ] || { err "map --forget needs a natural key"; return "$EXIT_USAGE"; } ;;
      --forget=*) forget="${1#--forget=}"; [ -n "$forget" ] || { err "map --forget needs a natural key"; return "$EXIT_USAGE"; } ;;
      --prune)    want_prune=1 ;;
      --migrate)  want_migrate=1 ;;
      --rebuild)  want_rebuild=1 ;;
      # Test seam, same captured `GET issues/` response `push --rebuild-map` reads.
      --fixture)   shift; fixture="${1:-}"; [ -n "$fixture" ] || { err "map --fixture needs a path"; return "$EXIT_USAGE"; } ;;
      --fixture=*) fixture="${1#--fixture=}"; [ -n "$fixture" ] || { err "map --fixture needs a path"; return "$EXIT_USAGE"; } ;;
      -*)         err "map: unknown flag '$1'"; return "$EXIT_USAGE" ;;
      "")         : ;;
      *)          [ -z "$key" ] || { err "map: unexpected extra argument '$1'"; return "$EXIT_USAGE"; }; key="$1" ;;
    esac
    shift
  done
  [ -z "$forget" ]          || mutators=$((mutators + 1))
  [ "$want_prune" -eq 0 ]   || mutators=$((mutators + 1))
  [ "$want_migrate" -eq 0 ] || mutators=$((mutators + 1))
  [ "$want_rebuild" -eq 0 ] || mutators=$((mutators + 1))
  if [ "$mutators" -gt 1 ]; then
    err "map: --forget, --prune, --migrate and --rebuild are mutually exclusive"
    return "$EXIT_USAGE"
  fi
  # A fixture with nothing to feed is a typo, not a no-op: `map --fixture x` would
  # otherwise dump the map and exit 0, reporting a rebuild that never ran.
  if [ -n "$fixture" ] && [ "$want_rebuild" -eq 0 ]; then
    err "map: --fixture belongs to --rebuild"
    return "$EXIT_USAGE"
  fi
  # The env twin is read only where it means something, so exporting it cannot
  # change what `map` or `map --forget` do.
  [ "$want_rebuild" -eq 1 ] && [ -z "$fixture" ] && [ -n "${FUSION_PLANE_ISSUES_FIXTURE:-}" ] \
    && fixture="$FUSION_PLANE_ISSUES_FIXTURE"

  resolve_workbench || return "$EXIT_CONFIG"
  # Build the read view once, in this shell, before any branch below looks the map
  # up through a command substitution or a pipe (both subshells — 260810-0744).
  map_view

  # Bare `map` and `map <key>` are INSPECTION and write nothing — not the file's
  # bytes, not even an empty map where none exists. They read the folded view, so
  # what they print is the mapping a push would resolve; if the file behind it is
  # still in the old form, map_view says so on stderr and names what a fold costs.
  if [ -n "$forget" ]; then
    map_forget "$forget"
  elif [ "$want_prune" -eq 1 ]; then
    map_prune
  elif [ "$want_migrate" -eq 1 ]; then
    map_migrate
  elif [ "$want_rebuild" -eq 1 ]; then
    map_rebuild "$fixture"
  elif [ -n "$key" ]; then
    map_json | jq --arg k "$key" '.[$k] // "no such key"'
  else
    map_json | jq '.'
  fi
}

cmd_doctor() {
  local rc=0
  if ! resolve_workbench; then
    return "$EXIT_CONFIG"
  fi
  printf 'workbench:        %s\n' "$WORKBENCH"

  if [ -f "$CONFIG_FILE" ]; then
    printf 'config file:      present (%s)\n' "$CONFIG_FILE"
    if cfg_load; then
      build_base
      if config_valid; then
        printf 'config valid:     yes (base=%s ws=%s project=%s)\n' "$BASE_URL" "$WORKSPACE_SLUG" "$PROJECT_ID"
      else
        printf 'config valid:     NO — see the config: lines above\n'
        rc="$EXIT_CONFIG"
      fi
    else
      printf 'config valid:     NO — could not parse\n'
      rc="$EXIT_CONFIG"
    fi
  else
    printf 'config file:      MISSING (%s) — copy templates/plane.config.yaml\n' "$CONFIG_FILE"
    rc="$EXIT_CONFIG"
  fi

  if plane_key_present; then
    printf 'PLANE_API_KEY:    present (in shell env; never read from a file)\n'
  else
    printf 'PLANE_API_KEY:    ABSENT — export it in ~/.zshrc (never store it in config)\n'
    rc="$EXIT_CONFIG"
  fi

  # states/ reachability only when config+key are usable.
  if [ "$rc" -eq 0 ]; then
    if fetch_states; then
      local n
      n="$(printf '%s' "$STATES_JSON" | jq '((.results? // .)|length)' 2>/dev/null || echo '?')"
      printf 'states/ reachable: yes (%s states)\n' "$n"
    else
      printf 'states/ reachable: NO (curl rc %s / HTTP %s)\n' "$PLANE_CURL_RC" "${PLANE_HTTP_CODE:-none}"
      rc="$EXIT_CONFIG"
    fi
  else
    printf 'states/ reachable: skipped (fix config/key first)\n'
  fi

  if [ "$rc" -eq 0 ]; then
    printf 'doctor:           OK\n'
  else
    printf 'doctor:           NOT OK — see lines above\n'
  fi
  return "$rc"
}

# ── seed: the bounded one-shot seeding read (agenda item 4 / plan Step 5) ─────
# Two phases, cleanly split so the map key can be the not-yet-created Circle's
# stable directory name:
#
#   Phase A  seed <seq>                    THE bounded read. Resolve
#            sequence_id→UUID (Martin's verified GET issues/?per_page=100 |
#            jq 'select(.sequence_id==$s)' lookup) and GET the issue's title +
#            description ONCE. Emit the fetched text + origin UUID as JSON on
#            stdout for the skill to consume. Writes NOTHING to the map — the
#            Circle directory (the natural key) does not exist yet.
#            (Reuse: MARTIN.md /new-fe-feature "read-once-then-materialise":
#            resolve the ticket by sequence_id, pull its description as the
#            brief, then hand off — the read has happened, files take over.)
#
#   Phase B  seed --record-origin <circle-dir> <origin-plane-id>
#            Pure map write, no network. The SKILL calls this AFTER shaper has
#            created the Circle and returned its directory name, recording the
#            origin Plane UUID under that stable natural key so the seeded
#            Circle's future push --circle lands on the SAME origin story
#            (closing Martin's round-trip). Map stays helper-owned; last_state
#            is left empty so the first real push PATCHes the origin to the
#            marker-derived state rather than assuming it is already synced.
#            The entry is stamped origin="seed", which makes every later push
#            against it STATE-ONLY — the human wrote that story's description and
#            fusion must not overwrite it with its own mirror body.
#
# Dry-run seam (Step 8): `seed --plan --fixture <captured issue JSON>` (or
# FUSION_PLANE_SEED_FIXTURE / FUSION_PLANE_DRYRUN=1) runs the identical
# lookup+extract jq against a captured `GET issues/` response and emits the same
# result JSON — executing NO curl. Same seam shape as `push --plan` (files/
# fixtures in, JSON op out, no network).
#
# C4 never-silent fallback: absent key / Plane-down / transport error prints the
# issue's board URL and the exact fetch command, asks the user to paste the
# description, and returns EXIT_DEFERRED (non-crash). The skill relays it and
# proceeds into the same Circle-creation path with the pasted text.

# seed_defer_manual <seq> <reason> — C4 fallback: emit the manual-paste hint
# (human-readable to stderr, machine JSON to stdout) and let the caller defer.
seed_defer_manual() {
  local seq="$1" reason="$2" board_url fetch_cmd
  board_url="$(printf '%s/%s/projects/%s/issues' "${BASE_URL%/}" "$WORKSPACE_SLUG" "$PROJECT_ID")"
  # The exact command the user runs in their OWN interactive zsh (where
  # $PLANE_API_KEY lives) to read the story and paste its description.
  fetch_cmd="zsh -ic 'curl -s -H \"X-API-Key: \$PLANE_API_KEY\" \"$BASE/issues/?per_page=100\"' | jq '.results[] | select(.sequence_id==$seq)'"
  info "seed deferred ($reason) — never silent. Fetch story #$seq manually and paste its description:"
  info "  Plane board: $board_url"
  info "  Fetch cmd:   $fetch_cmd"
  jq -cn --argjson s "$seq" --arg r "$reason" --arg b "$board_url" --arg f "$fetch_cmd" \
    '{op:"seed", sequence_id:$s, status:"deferred", reason:$r, board_url:$b, fetch_cmd:$f,
      origin_plane_id:null, title:null, description:null}'
}

cmd_seed() {
  local seq="" fixture="" want_plan=0 mode="read" record_dir="" record_pid=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --plan)          want_plan=1 ;;
      --fixture)       shift; fixture="${1:-}"; [ -n "$fixture" ] || { err "seed: --fixture needs a path"; return "$EXIT_USAGE"; } ;;
      --fixture=*)     fixture="${1#--fixture=}" ;;
      --record-origin) mode="record" ;;
      -*)              err "seed: unknown flag '$1'"; return "$EXIT_USAGE" ;;
      *)
        if [ "$mode" = "record" ]; then
          if   [ -z "$record_dir" ]; then record_dir="$1"
          elif [ -z "$record_pid" ]; then record_pid="$1"
          else err "seed --record-origin takes exactly <circle-dir> <origin-plane-id>"; return "$EXIT_USAGE"
          fi
        elif [ -z "$seq" ]; then
          seq="$1"
        else
          err "seed: unexpected extra argument '$1'"; return "$EXIT_USAGE"
        fi
        ;;
    esac
    shift
  done
  [ "${FUSION_PLANE_DRYRUN:-0}" = "1" ] && want_plan=1
  [ -z "$fixture" ] && [ -n "${FUSION_PLANE_SEED_FIXTURE:-}" ] && fixture="$FUSION_PLANE_SEED_FIXTURE"

  resolve_workbench || return "$EXIT_CONFIG"

  # ── Phase B: record the origin UUID under the now-known Circle key ──────────
  if [ "$mode" = "record" ]; then
    [ -n "$record_dir" ] && [ -n "$record_pid" ] || {
      err "seed --record-origin needs <circle-dir> <origin-plane-id>"; return "$EXIT_USAGE"; }
    # kind=circle; last_state empty on purpose (see header) — the next
    # `push --circle <dir>` reconciles the origin issue to the marker state.
    # origin=seed is the DURABLE discriminator: this issue is a human's story,
    # so every future push writes its state only and never its body. (last_state
    # ""  is not a substitute — it disappears after the first push.)
    map_view   # built here, in the parent: map_set looks the origin up in a subshell
    if ! map_set "$record_dir" "$record_pid" circle "" seed; then
      err "seed --record-origin: the origin UUID was NOT recorded. Fix $MAP and re-run; until then a push against $record_dir may overwrite that human's story."
      printf 'STATUS: not recorded (%s → %s)\n' "$record_dir" "$record_pid"
      return "$EXIT_CONFIG"
    fi
    info "recorded origin: $record_dir → $record_pid (kind=circle, origin=seed — pushes write state only). Next 'push --circle $record_dir' syncs its state."
    printf 'STATUS: origin recorded (%s → %s)\n' "$record_dir" "$record_pid"
    return "$EXIT_OK"
  fi

  # ── Phase A: the bounded read ───────────────────────────────────────────────
  [ -n "$seq" ] || { err "seed: need a <seq> (Plane sequence_id)"; return "$EXIT_USAGE"; }
  case "$seq" in ''|*[!0-9]*) err "seed: <seq> must be a numeric Plane sequence_id"; return "$EXIT_USAGE" ;; esac

  cfg_load || return "$EXIT_CONFIG"
  build_base

  local issues_json=""
  if [ -n "$fixture" ]; then
    # Dry-run / fixture path: no network, config values only format the URL.
    [ -f "$fixture" ] || { err "seed: fixture not found: $fixture"; return "$EXIT_CONFIG"; }
    issues_json="$(cat "$fixture")"
  else
    if [ "$want_plan" -eq 1 ]; then
      err "seed --plan requires --fixture <captured issue JSON> (dry-run performs no network read)."
      return "$EXIT_USAGE"
    fi
    # Live read: needs valid config + a key. Absent key / Plane-down → defer.
    config_valid || return "$EXIT_CONFIG"
    if ! plane_key_present; then
      seed_defer_manual "$seq" "PLANE_API_KEY absent"
      return "$EXIT_DEFERRED"
    fi
    if ! plane_curl GET "$BASE/issues/?per_page=100"; then
      seed_defer_manual "$seq" "Plane unreachable (curl rc $PLANE_CURL_RC)"
      return "$EXIT_DEFERRED"
    fi
    case "$PLANE_HTTP_CODE" in
      2*) issues_json="$PLANE_BODY" ;;
      *)  seed_defer_manual "$seq" "HTTP $PLANE_HTTP_CODE"; return "$EXIT_DEFERRED" ;;
    esac
  fi

  # sequence_id → issue (Martin's verified lookup; numeric compare via --argjson).
  local issue origin_id title desc url
  issue="$(printf '%s' "$issues_json" \
    | jq -c --argjson s "$seq" '(.results? // .) | map(select(.sequence_id==$s)) | (.[0] // empty)' 2>/dev/null || true)"
  if [ -z "$issue" ] || [ "$issue" = "null" ]; then
    err "seed: no issue with sequence_id=$seq in the fetched set (check the story number)."
    return "$EXIT_USAGE"
  fi

  origin_id="$(printf '%s' "$issue" | jq -r '.id // empty')"
  title="$(printf '%s' "$issue" | jq -r '.name // empty')"
  # Prefer the plain-text description; fall back to the HTML field, then empty.
  desc="$(printf '%s' "$issue" | jq -r '(.description_stripped // .description_html // "")')"
  url="$(issue_web_url "$origin_id")"

  if [ -z "$origin_id" ]; then
    err "seed: matched issue has no id — cannot bind the round-trip."
    return "$EXIT_CONFIG"
  fi

  # Emit the fetched brief + origin UUID for the skill. The map entry is NOT
  # written here (the Circle key is unknown until shaper creates it) — the skill
  # calls `seed --record-origin <circle-dir> <origin_id>` afterwards (Phase B).
  jq -cn \
    --argjson s "$seq" --arg id "$origin_id" --arg url "$url" \
    --arg t "$title" --arg d "$desc" \
    --argjson dry "$( [ -n "$fixture" ] && echo true || echo false )" \
    --arg rec "seed --record-origin <circle-dir> $origin_id" \
    '{op:"seed", status:"ok", dry_run:$dry, sequence_id:$s, origin_plane_id:$id,
      issue_url:$url, title:$t, description:$d, record_origin_cmd:$rec}'
  return "$EXIT_OK"
}

usage() {
  cat >&2 <<'EOF'
Usage: fusion-plane <subcommand> [args]

Subcommands:
  push [--circle <dir>|--all] [--plan] [--rebuild-map [--fixture <json>]]
       [--closure]
                        Reconcile a Circle (or all) into Plane.
                        --plan      dry-run: emit the JSON op list, no curl.
                        --rebuild-map  rebuild .plane-map.json from Plane first,
                                   reading the embedded fusion-key back out of
                                   description_stripped / _html / description,
                                   THEN reconcile (a live run: it writes to the
                                   board). --fixture <json> rebuilds from a
                                   captured `GET issues/` response instead of the
                                   wire (test seam); the reconcile still follows.
                                   NOT combinable with --plan: a rebuild replaces
                                   the map, a dry run writes nothing. For a plan
                                   against a rebuilt map use `map --rebuild`,
                                   which rebuilds without reconciling, and then
                                   `plan` — two commands, not chained with &&.
  plan --circle <dir>|--all
                        Dry-run alias for `push --plan`.
  seed <seq>            Bounded one-shot read: resolve sequence_id, GET the
                        issue title+description once, emit JSON for the skill.
    seed --record-origin <circle-dir> <origin-plane-id>
                        Phase B: record the origin UUID under the new Circle's
                        key (no network) — closes the seed→push round-trip.
    seed --plan --fixture <captured issue JSON>
                        Dry-run seam: lookup+extract against a fixture, no curl.
  map [<natural-key>]   Dump .plane-map.json, or inspect one entry. Read-only:
                        it never writes the file and never creates one.
    map --forget <natural-key>
                        Drop ONE entry (use after deleting its issue in Plane,
                        so the next push creates rather than PATCHing a dead
                        UUID). Reports whether the key was there; an absent key
                        exits 1 rather than silently succeeding.
    map --prune         Drop every entry whose Plane issue is definitively gone
                        (HTTP 404). Needs the key and a reachable Plane; on any
                        inconclusive answer it deletes NOTHING and exits 10.
    map --migrate       Fold a legacy marker-bearing map onto the stable keys ON
                        DISK. Reads alone never do this; every dropped duplicate
                        is named by key and UUID so the strays can be closed.
    map --rebuild       Rebuild the WHOLE map from Plane and stop — the rebuild
                        `push --rebuild-map` performs, without the reconcile that
                        follows it there, so a plan can be computed against a
                        rebuilt map without writing to the board. Reads Plane
                        (GET issues/), writes only the map: it needs the key, and
                        an unreachable Plane or an absent key changes NOTHING and
                        exits 10. --fixture <json> rebuilds from a captured
                        `GET issues/` response instead (test seam: no key, no
                        call). Every dropped, skipped and orphaned entry is named.
  states                Resolve+print canonical → instance → UUID states.
  doctor                Report key presence, config validity, states/ reach.

Env:
  PLANE_API_KEY            (in ~/.zshrc) the only place the key ever lives.
  FUSION_PLANE_DRYRUN=1    force --plan for any push / seed. Beside --rebuild-map
                           it forces the refused pair, so that spelling exits 2;
                           it means nothing to `map --rebuild`, which is no push.
  FUSION_PLANE_WORKBENCH   override workbench dir (test seam).
  FUSION_PLANE_SEED_FIXTURE  captured `GET issues/` JSON for `seed --plan` (test seam).
  FUSION_PLANE_ISSUES_FIXTURE  captured `GET issues/` JSON for `map --rebuild` /
                           `push --rebuild-map` (test seam).
EOF
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift || true
case "$cmd" in
  push)   cmd_push "$@" ;;
  plan)   cmd_plan "$@" ;;
  seed)   cmd_seed "$@" ;;
  map)    cmd_map "$@" ;;
  states) cmd_states ;;
  doctor) cmd_doctor ;;
  ""|-h|--help|help)
    usage
    [ -z "$cmd" ] && exit "$EXIT_USAGE"
    exit "$EXIT_OK"
    ;;
  *)
    err "unknown subcommand '$cmd'"
    usage
    exit "$EXIT_USAGE"
    ;;
esac
