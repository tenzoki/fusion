#!/usr/bin/env bash
# fusion-citation-sweep — rewrite a consuming project's store-prefixed record
# citations to the storeless form, behind three guards, and never on its own.
#
# Usage:
#   fusion-citation-sweep [--root <workbench>] [--dry-run | --write [--yes]] [--repair] [<path>...]
#
# --dry-run is the default and runs anywhere a workbench does: it prints the
# census (one `<file>  rewrites=<n>` line per file it would touch, the bare
# stamps it will not judge, then one `files=<n> rewrites=<n> ... mode=dry-run`
# summary line) and writes nothing. --repair selects the repair pass over the
# sweep; --write applies whichever was selected, behind three guards:
#
#   (a) the workbench is inside a git work tree and tracked by it
#       (git ls-files --error-unmatch); no uncommitted change names a file
#       this run will read — the corpus question, not a clean-tree question,
#       because the machine-written orchestrator-events.jsonl is tracked and
#       makes a clean tree unreachable inside a session; and every extra
#       <path> sits inside that same work tree AND is tracked by it, asked
#       with that same git ls-files --error-unmatch, because inside is not
#       tracked and only tracked gives the revert. Else one stderr line names
#       the condition and the offending paths, exit 4, nothing written:
#       without a commit to return to there is no way back. Declared files
#       need no such check and get none — git ls-files cannot name an
#       untracked or ignored file, so only a hand-passed <path> reaches it.
#   (b) the census is printed first and nothing is written unless --yes was
#       passed; without it, one stderr line and exit 5.
#   (c) there is no bare-stamp resolution and no option enables one. A bare
#       stamp names a minute, not a file; the rule that expanded a uniquely
#       matching stamp into a filename produced every corrupted token the
#       v10.20.0 sweep left in fusion's own workbench, and it was removed
#       rather than bounded.
#
# Corpus: every .md under the workbench, plus each <path> argument (a
# directory walked for *.md, a file taken as named whatever its extension),
# plus the declared corpus — every file the project named in
# citations.extraPaths in its fusion.json, as git pathspecs under :(glob),
# deduplicated by absolute path. Declared files join the corpus at the same
# place a <path> argument does, BEFORE guard (a) is asked, so the guard covers
# them with no new guard code. A pattern matching nothing, or refused for
# being absolute or carrying a `..` segment, is named on stderr; the summary
# line is untouched by any of it. Declare nothing and the sweep reads exactly
# what it read before the leaf existed.
#
# bin/fusion-citation-check resolves the same leaf through the same function:
# the two hand-run helpers share one corpus, because a reporter narrower than
# the rewriter is how this program came to change files the checker then
# declared clean. The blocking gate
# hooks/lib/__tests__/workbench-citation-lint.test.ts does NOT read the
# declaration, on purpose, and is not to be made to.
#
# No fusion pipeline or skill runs this helper. `/fusion:cleanup` prints the
# checker's verdict (bin/fusion-citation-check) and stops there; a person runs
# the sweep by hand, --dry-run first, then --write --yes on a clean tree so
# the sweep is its own commit and the way back is one revert.
#
# Exit codes:
#   0  ran; in a writing mode, wrote.
#   1  usage error.
#   2  no fusion workbench above the working directory and no --root.
#   3  the plugin's compiled hooks are missing, so nothing could be asked. Its
#      own code and not 2: "there is no workbench" is an answer about the
#      project, and a broken install must never be reported as one.
#   4  guard (a) refused; nothing written.
#   5  guard (b) refused (--write without --yes); the census was printed,
#      nothing written.
#
# The work is hooks/dist/citation-sweep.js, resolved relative to this script
# rather than through $FUSION_PLUGIN_ROOT, so an install copy and a work tree
# each run their own build; its header carries the per-kind rewrite table and
# the repair pass's three classes. A call site guards with [ -x ]: the
# installed copy need not carry a helper added between releases (decision
# 260810-0921_*_how-should-a-prompt-call-a-bin-helper-that-the-installed-copy-may-not-have.md).

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
entry="$here/../hooks/dist/citation-sweep.js"

if [ ! -f "$entry" ]; then
  echo "fusion-citation-sweep: $entry is missing — the plugin's compiled hooks are not installed." >&2
  exit 3
fi

exec node "$entry" "$@"
