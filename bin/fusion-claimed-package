#!/usr/bin/env bash
# fusion-claimed-package — which work package this checkout has claimed.
#
# Usage:
#   fusion-claimed-package
#
# Takes no arguments. Output on stdout, in the KEY=value shape
# `bin/fusion-paths` established: either both lines below, or nothing at all.
#
#   PACKAGE=work-packages/<stamp>-<slug>/<stamp>-<slug>.md
#   CONTAINER=work-packages/<stamp>-<slug>
#
#   PACKAGE    the work package's narrative, workbench-relative: the file an
#              agent reads, and the one `bin/fusion-rules` reads a Topic: or
#              Tags: line from. Its control data is the `package.json` beside it.
#   CONTAINER  the directory holding both, workbench-relative. Derivable from
#              PACKAGE and printed anyway, so no caller re-implements the dirname.
#
# Every reason on stderr, one line each, plus whatever `bin/fusion-identity`
# writes there: its stderr is passed through rather than swallowed, and a
# caller that wants a quiet Setup redirects it.
#
# Exit codes:
#   0  answered. Either both lines are printed, naming the one item this
#      checkout has claimed, or NOTHING is printed and no item is in scope.
#      An empty answer is a real answer: it is what puts a consumer's writes in
#      the shared store, and it is not a degradation.
#   1  the caller stops. Two causes, both named on stderr: no fusion workbench
#      above the working directory, or `bin/fusion-identity` exiting 1, which
#      is that helper's own only stop code (a git work tree whose `user.name`
#      or `user.email` is unset, or no runnable `git` at all).
#   2  usage error: an argument was given, or -h/--help. Nothing on stdout.
#   3  the item in scope cannot be determined. Nothing on stdout, and NEVER a
#      fall back to the shared store. The message names the cause, which is
#      one of:
#        - two or more packages carry a claim naming this checkout, every one
#          of them named on stderr;
#        - this checkout's own identifier could not be read inside a git work
#          tree (`bin/fusion-identity` exiting 3 or 5, or that helper or the
#          compiled entry `hooks/dist/scope.js` missing from the install);
#        - the workbench is `legacy` (Markdown control data, no
#          `workbench.json`) or `unsupported` (a manifest requiring a feature
#          this version's codec does not know);
#        - the codec refused a read, `recovery-blocked` among the reasons, or
#          gave no answer this program can read;
#        - a package record did not read, by the codec's own validation or
#          a status outside the five, so its status is unknown;
#        - a package changed between the list and the read of it twice over;
#        - an internal fault stopped `hooks/dist/scope.js`, a fusion bug or an
#          incomplete install, named with its stack.
#
# ---------------------------------------------------------------------------
# The criterion, and where it is read
#
# A package is this checkout's when its `status` is `claimed` and its
# `claim.checkout_id` equals the eight hex characters `bin/fusion-identity`
# prints as CHECKOUT=. Both come out of the package's JSON control record,
# read through the codec (`codec/dist/fusion-record.js`) by way of the record
# client and `hooks/lib/scope.ts`; nothing here or there reads a head line of
# the narrative. The read is `inspect`, then `list`, then `show` of each
# claimed row at the revision `list` named, with one bounded re-read when a
# revision moved in between; that module's header carries the sequence and
# what each answer of the codec means. A workbench that is not JSON-controlled
# is refused by name, never read as empty: `bin/fusion-stores` and the v11
# container root are no longer consulted, because a JSON-controlled workbench
# has the store-name migration behind it.
#
# ---------------------------------------------------------------------------
# One criterion, one implementation
#
# "Which item has this checkout claimed" is asked from two places in the same
# Setup step: `bin/fusion-paths`, to decide which container a write goes into,
# and `bin/fusion-rules`, to derive the context-manifest topic. It was
# implemented in the second of those and about to be implemented again in the
# first. Two implementations of one criterion drift, and the drift is invisible
# because each answers plausibly on its own; this program exists so that there
# is one answer to compare against, not two to reconcile. `bin/fusion-rules`
# deliberately does not reach it through `bin/fusion-paths`: that resolver
# derives a key set from a CONSUMER PROMPT and `fusion-rules` has no prompt of
# its own, so a third helper is the only place the two can share.
#
# ---------------------------------------------------------------------------
# Ambiguity is refused, never resolved
#
# Nothing in the store enforces at most one claim per checkout: two claimed
# items is a state the store can reach, so this program may not assume it away.
# It could take the first, which is what `bin/fusion-rules` did while it carried
# its own scan, and there that is tolerable, because a wrong topic costs a few
# optional context units. Here it is not: the same wrong pick files a plan, a
# defect record or a decision silently into the other item's container, which is
# the same silent-wrong-place failure `bin/fusion-paths` refuses one step later
# by exiting 4 rather than emitting an empty `KEY=`. So exit 3 names every
# claimed item and resolves nothing. Binding record:
# `260910-2145_*_how-does-the-resolver-learn-which-work-item-is-in-scope.md`.
#
# ---------------------------------------------------------------------------
# Exit 3 is unknown scope, and a tree that is not a git work tree is not it
#
# The two look alike and are not, which is the distinction the whole table turns
# on. An identifier that could not be read INSIDE a git work tree means the
# question has an answer this program failed to obtain: falling back to the
# shared store there would file an item's work outside it and say nothing. A
# project that is not a git work tree at all takes no part in the multi-checkout
# arrangement the claim field exists for, so no item in scope is the TRUE answer
# and it reaches exit 0. That is why `bin/fusion-identity` splits its 3 and 5
# from its 4, and why this program must not merge them back.
#
# The consequence is stated rather than smoothed: in a tree that is not a git
# work tree, a claim somebody wrote is not read, even though the checkout
# identifier there is minted and readable. That is the cost of exit 4 meaning
# one thing. The codec is still asked one thing there, the workbench's format
# through `inspect`, so a legacy or unsupported workbench is exit 3 by name
# outside git as inside it: the claim is what a tree without git lacks, not the
# format (Prior's ruling on request 28, `codec/README.md` `## The CLI`).
#
# ---------------------------------------------------------------------------
# Another checkout's claim is not a match, and not an error
#
# The comparison is equality on the eight hex characters, so an item another
# checkout holds simply does not match here. It is not a conflict to report and
# not a scope to inherit: that checkout's writes go into its container, this
# one's go into whatever this one holds, or the shared store. The claim travels
# with git and the identifier does not, so both read one store and reach
# different answers out of it, with nothing per-checkout to reconcile.
#
# ---------------------------------------------------------------------------
# What a caller owes
#
# Guard the call with `[ -x ]`: an installed copy may predate this helper, and
# a bare call is exit 127 at a consumer's own first step (decision
# `260810-0921_*_how-should-a-prompt-call-a-bin-helper-that-the-installed-copy-may-not-have.md`).
# On the miss, and on any non-zero, a caller resolves NO item rather than
# guessing one: `bin/fusion-rules` then derives no topic, and `bin/fusion-paths`
# passes the 1 and the 3 straight through instead of answering with the shared
# store. The one thing no caller may do with a non-zero is treat it as "none
# claimed": that is exit 0 with no output, and it is a different answer.
#
# This program is called by a person or from an agent's Setup, never by an
# automatic hook: a read through the codec may finish a committed intent, and
# that is admitted for a helper somebody called and for nothing else
# (`hooks/lib/record-client.ts` `## The recovery declaration`).

set -eu

usage() {
  cat >&2 <<'USAGE'
usage: fusion-claimed-package
Prints PACKAGE= and CONTAINER= for the one work package this checkout has claimed, or
nothing when it has claimed none. See the header of this script for the
exit-code table; exit 3 is unknown scope and never a fall back to the shared
store.
USAGE
}

if [ "$#" -ne 0 ]; then
  usage
  exit 2
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- the workbench ----------------------------------------------------------

if [ ! -x "$here/fusion-workbench-root" ]; then
  printf 'fusion-claimed-package: %s is missing; the plugin install is incomplete.\n' \
    "$here/fusion-workbench-root" >&2
  exit 1
fi

root="$("$here/fusion-workbench-root" 2>/dev/null || true)"
if [ -z "$root" ]; then
  printf 'fusion-claimed-package: no fusion workbench found above %s. Run /fusion:setup at the project root.\n' \
    "$(pwd)" >&2
  exit 1
fi

# --- the entry --------------------------------------------------------------
#
# hooks/dist/scope.js, resolved relative to this script rather than through
# $FUSION_PLUGIN_ROOT, so an install copy and a work tree each run their own
# build and their own codec bundle. It prints the two lines or nothing, and
# exits 0 or 3 with the cause on stderr; this script adds nothing to either.

entry="$here/../hooks/dist/scope.js"
if [ ! -f "$entry" ]; then
  printf 'fusion-claimed-package: %s is missing, so nothing could be asked and the item in scope is unknown. The plugin install is incomplete.\n' \
    "$entry" >&2
  exit 3
fi

# --- this checkout ----------------------------------------------------------
#
# Established before the store is read, because every outcome below except the
# read itself is decided by which code the identity helper returned.

if [ ! -x "$here/fusion-identity" ]; then
  printf 'fusion-claimed-package: %s is missing, so this checkout cannot be identified and the item in scope is unknown.\n' \
    "$here/fusion-identity" >&2
  exit 3
fi

set +e
id_out="$("$here/fusion-identity")"
id_rc=$?
set -e

case "$id_rc" in
  0) ;;
  1)
    printf 'fusion-claimed-package: bin/fusion-identity stopped, for the reason it printed above. Nothing is resolved.\n' >&2
    exit 1
    ;;
  4)
    # No claim is held here, but the workbench's format is still asked first:
    # a legacy or unsupported one is refused by name outside git as inside it.
    node "$entry" gate "$root/fusion-workbench" || exit $?
    printf 'fusion-claimed-package: not a git work tree, so no claim is held here and no item is in scope.\n' >&2
    exit 0
    ;;
  3|5)
    printf 'fusion-claimed-package: this checkout identifier could not be read inside a git work tree, so the item in scope is unknown. Nothing falls back to the shared store.\n' >&2
    exit 3
    ;;
  *)
    printf 'fusion-claimed-package: bin/fusion-identity exited %s, which this program does not recognise, so the item in scope is unknown.\n' \
      "$id_rc" >&2
    exit 3
    ;;
esac

checkout="$(printf '%s\n' "$id_out" | sed -n 's/^CHECKOUT=//p' | head -n 1)"
if [ -z "$checkout" ]; then
  # Exit 0 from the identity helper promises the line. Reaching here means the
  # promise was broken, which is unknown scope and not an empty answer.
  printf 'fusion-claimed-package: bin/fusion-identity exited 0 without a CHECKOUT line, so the item in scope is unknown.\n' >&2
  exit 3
fi

# --- the read ---------------------------------------------------------------

exec node "$entry" claimed "$root/fusion-workbench" "$checkout"
