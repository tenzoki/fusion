#!/usr/bin/env bash
# fusion-campaign — the frame above the checkouts of one project: who holds
# which work package at the commit the remote stands at, read out of a fetched
# ref and never out of the working tree; and the steering writes of the
# campaign record, `campaigns/<id>/campaign.json`, whose one writer this is.
#
# THIS HEADER IS THE AUTHORITATIVE DOCUMENTATION of every sub-command, of the
# KEY=value output, of the state vocabulary and of the exit table. The row in
# README-hooks.md and every call site summarise it and do not restate it.
#
# ## Usage
#
#   fusion-campaign overview [--window <hours>] [--ref <upstream>]
#   fusion-campaign cut --checkouts <N> [--tolerance <k>]
#   fusion-campaign sync
#   fusion-campaign open --id <YYMMDD-HHMM-slug> --objective <text> --authorisation <citation> [--stop <text>]...
#   fusion-campaign lanes --from <proposal file> [--assign <lane>=<hex>]... [--campaign <id>]
#   fusion-campaign pause --reason <text> [--campaign <id>]
#   fusion-campaign resume [--campaign <id>]
#   fusion-campaign move <package> --to <lane> [--campaign <id>]
#   fusion-campaign reassign <lane> --checkout <hex> [--campaign <id>]
#   fusion-campaign end --outcome completed|bounded|failed|cancelled [--reason <text>]
#                       [--objective-met] [--intake-closed] [--all-attempts-terminal] [--final-audit-passed]
#                       [--watermark <text>] [--audit-ref <text>] [--campaign <id>]
#
# `overview` is the read side, both tiers in one run: the reduced tier that
# needs no campaign record (the held packages), and the full tier that reads
# the campaign files at the ref (the lane view and the seven conditions,
# `## The lane view and the conditions` below). `cut` proposes the lanes
# (`## cut` below). `sync` is the commit-cycle read of a working session
# (`## sync` below), and the seven others are the steering writes (`## The
# steering writes` below). A sub-command this script does not know is a
# usage error, never a silent no-op.
#
#   --window <hours>  The overview window, a whole number of hours above zero,
#                     24 when absent. Nothing stores it: it is a parameter of
#                     the run and is printed back as `window_hours=`. The
#                     `silent=` rows are decided against it.
#   --ref <upstream>  The ref to read in place of the branch's upstream, e.g.
#                     `origin/main`. With it no branch is needed, so a detached
#                     HEAD and a branch that tracks nothing are both readable.
#                     Its remote is the longest configured remote name that
#                     prefixes it; a ref no remote prefixes is a local ref.
#
# ## `overview` — what it does, in order
#
# Resolve the workbench by walking up from pwd; require a git work tree;
# resolve the branch and its upstream (or take `--ref`); fetch that remote;
# name the commit the ref stands at; extract the tracked workbench at that
# commit into a scratch directory; read the extract through the codec; print.
#
# The fetch is `git fetch <remote>` with `GIT_TERMINAL_PROMPT=0` and a batch
# mode ssh, so a credential prompt is an immediate, reportable failure and a
# slow transfer stays visible and interruptible. The reasons for that shape,
# for the absence of a timeout and for fetching the whole remote are argued in
# `bin/fusion-forum` `## Why there is no timeout`, whose state vocabulary and
# exit codes this script takes over unchanged.
#
# What is extracted is the workbench manifest and setup marker, the container
# store, the campaign store and the event log, each as the commit holds it
# (`git archive` into a file, then `tar`); an entry in no tree at the commit is
# left out. The store names are never spelled here: the program reads them
# from `hooks/lib/stores.ts`, the TypeScript copy of the table `bin/fusion-stores`
# prints, which `hooks/lib/__tests__/fusion-stores.test.ts` holds equal to it.
#
# ## Output of `overview`, one KEY=value per line, in this order
#
#   state=ok            The only state that reaches exit 0. Every other value
#                       names why there is nothing to read against; see
#                       `## The state vocabulary`.
#   ref=<upstream>      The ref read: the upstream's short name, or the value
#                       of `--ref` as given.
#   head=<sha>          The commit that ref names AFTER the fetch. Everything
#                       below describes the tree of this commit.
#   head_time=<time>    That commit's committer time.
#   age_minutes=<n>     Whole minutes from `head_time` to now, never below 0.
#                       It is the age of the newest push to the ref, and so the
#                       least age of everything else on this page.
#   window_hours=<n>    The overview window of this run.
#   campaigns=<n>       The campaign files at the commit, as the codec's `list`
#                       names them, readable or not.
#   campaign=<id>\t<state>\t<reason|->\t<lanes|->
#                       One per readable campaign, ascending by id: the
#                       directory's name, `state.state`, `state.reason` or
#                       `-`, the number of lanes or `-` where `lanes` is null.
#   campaign-unreadable=<id>\t<class>/<reason>
#                       One per campaign the codec reports a finding against
#                       (the schema, or one of the three lane rules),
#                       ascending by id. It is evaluated no further: no lane,
#                       no condition.
#   held=<checkout>\t<alias|->\t<package>\t<last_push|none>\t<waits>
#                       One line per package whose control file reads `claimed`
#                       at the commit, TAB-separated, ascending by checkout,
#                       then by package. Zero lines is an answer: nobody holds
#                       anything at that commit.
#                         checkout   the eight hex characters the claim names
#                         alias      the registry's name for that checkout as it
#                                    stood at the commit
#                                    (`bin/fusion-checkout-name resolve <hex> --at
#                                    <head>`), `-` where the registry has no
#                                    entry or no alias for it
#                         package    the package's container name
#                         last_push  see `## last_push`; `none` where the
#                                    checkout's rows name no commit on the ref
#                         waits      `none`, or a comma-separated list, edges
#                                    first: `edge:<container>` per dependency
#                                    that blocks the package (an edge on a live
#                                    package, or an unmet condition on one that
#                                    is not live), then `decision:<basename>`
#                                    per open decision record inside the
#                                    package's container, named by its
#                                    narrative's basename
#   lane=<campaign>\t<lane id>\t<checkout|->\t<alias|->\t<held|none>\t<next|none>\t<next waits>
#                       One per lane of each LIVE readable campaign (`running`
#                       or `paused`; a terminal campaign steers nobody and its
#                       lanes are not evaluated), in campaign order then lane
#                       order. `held` is every package the lane's checkout
#                       holds, anywhere in the workbench, comma-separated and
#                       ascending; `next` the first member in lane order that
#                       is live and unheld (`open` or `paused`), and `next
#                       waits` what it waits for, in the vocabulary of `waits`
#                       above.
#   silent=<campaign>\t<lane>\t<checkout>\t<last_push|none>
#   out-of-lane=<checkout>\t<package>\t<package's lane>\t<holder's lane|->
#   in-no-lane=<checkout>\t<package>
#   waits-decision=<campaign>\t<lane>\t<next>\t<decision basename>
#   handoff-possible=<from>\t<to>\t<from lane>\t<to lane>
#   cross-lane=<hash>\t<path>\t<committer lane>\t<declaring lane>
#   unconfirmed=<campaign>\t<lane>\t<checkout>\t<revision>\t<last confirmation|none>
#                       The seven conditions, each printed only when it holds,
#                       in this order; `## The lane view and the conditions`
#                       states each rule.
#   note=<token>[\t<field>...]
#                       Zero or more. A degradation that changed the answer,
#                       stated rather than hidden; see `## The notes`.
#
# Every time on this page is RFC 3339 in UTC at second resolution,
# `2026-11-09T13:04:44Z`.
#
# ## The lane view and the conditions
#
# A lane's members are record references, each resolved to its container
# through the package rows of `list`; one that resolves to nothing is a
# `lane-member-unknown` note. The conditions:
#
#   silent            the lane has a checkout, that checkout holds no package,
#                     and its `last_push` is `none` or older than `--window`
#                     hours before the run.
#   out-of-lane       a held package stands in a lane and its holder is not
#                     that lane's checkout. The fourth field is the holder's
#                     own lane in the same campaign, `-` where it has none.
#   in-no-lane        a held package stands in no lane of any live campaign.
#                     With `out-of-lane` it is evaluated only while some live
#                     campaign has lanes: a campaign whose `lanes` is null has
#                     nothing to be in or out of, and the cut is still owed.
#                     Ascending by checkout, then by package.
#   waits-decision    the lane's `next` carries an open decision record
#                     inside its container; one row per decision.
#   handoff-possible  a dependency edge whose source is terminal (`done` or
#                     `dropped`), whose target is live and unheld, and whose
#                     ends sit in different lanes of one campaign. One row per
#                     edge: a target with two such sources prints two rows,
#                     and a target that also waits on a held package is still
#                     printed, since the row names the edge and not the
#                     target's readiness. Ascending by source, then target.
#   cross-lane        over `git log --name-only` from the commit that first
#                     added the campaign file (exclusive) to `head`, newest
#                     first. Each commit is attributed to a checkout by the
#                     join of `## last_push` run the other way round, over
#                     every `commit` row of the extracted log, so a commit a
#                     rebase renamed is still its checkout's; two rows of
#                     different checkouts naming one commit attribute it to
#                     nobody. A lane's area is the union of its members'
#                     `resources`, every member counted; a path is inside an
#                     area when it equals a declared path or lies under it at
#                     a `/` boundary. A path of a commit by a lane's checkout
#                     that lies inside another lane's area and outside the
#                     committer lane's own is a row, one per declaring lane;
#                     `<hash>` is the abbreviated hash as `git log` prints it.
#                     A commit by a checkout in no lane prints nothing (the
#                     row compares two lanes), and a file several lanes share
#                     by design is declared on none of them, so a commit into
#                     it prints nothing either: the limit of ruling B of
#                     2026-11-09 in the campaign package, which plan step 20's
#                     page states.
#   unconfirmed       no `campaign_read` row by the lane's checkout names the
#                     `sha256:` revision the campaign file has at `head`, as
#                     `list` returns it. The last field is the newest such
#                     row of any revision, so a stale confirmation is told
#                     from none.
#
# ## last_push
#
# The newest committer time among the commits on the ref that the checkout's
# `commit` rows in the event log name. Which commit a row names is decided
# over one listing of the head's ancestors, in this order: the one commit
# whose hash the row's short hash abbreviates; else the one commit that
# carries the row's subject and an author time within 60 seconds of the row's
# `ts`, which is what a rebase made of the row's commit, since a rebase keeps
# subject and author time and replaces the hash; else none, two candidates
# included. A row is never matched by guess.
#
# THE FIGURE IS A LOWER BOUND ON THE PUSH. A row that names no commit and is
# newer than the row the figure came from is counted in a
# `note=commit-rows-unmatched` line, so an under-report is never silent. And a
# row reaches the ref only with the commit that carries the log, so the figure
# can trail the checkout's newest push by that one commit. The measurement
# behind the rule, and the three alternatives it ruled out, are in
# `hooks/lib/campaign.ts`.
#
# ## The notes
#
#   commit-rows-unmatched\t<checkout>\t<count>\t<time>
#       `<count>` rows by that checkout name no commit on the ref and are newer
#       than the row its `last_push` came from; `<time>` is the newest such
#       row's `ts`. With `last_push` `none`, every row of the checkout that
#       names nothing is counted.
#   no-commit-rows\t<checkout>
#       The event log at the commit carries no `commit` row by that checkout,
#       so its `last_push` is `none` and no time was guessed.
#   event-log-untracked
#       The event log is in no tree at the commit; every `last_push` is `none`.
#   log-lines-unreadable\t<count>
#       That many lines of the event log are no JSON object, or are `commit`
#       rows without a `detail` or a readable `ts`, or `campaign_read` rows
#       without a `campaign`, a `revision` or a readable `ts`. They were left
#       out.
#   registry-unreadable\t<checkout>\t<exit code>
#       `bin/fusion-checkout-name` could not look the checkout up at the commit
#       (its exit code: 6 where the registry could not be read there, -1 where
#       the helper could not be started), so the alias column carries `-` for
#       a lookup that did not happen.
#   package-unreadable\t<package>\t<class>/<reason>
#       The codec reports that package's control file unreadable at the commit.
#       It is outside the read; a claim it carries prints no `held=` line.
#   lane-member-unknown\t<campaign>\t<lane>\t<record id>
#       A lane names a record id no package row of `list` carries, so the
#       member is left out of the lane: it holds nothing, is nobody's `next`,
#       and declares no area.
#   commit-unattributed\t<campaign>\t<hash>
#       A commit in the cross-lane range touches a path inside some lane's
#       area and no `commit` row names it (none by hash, none by subject and
#       author time, or two checkouts' rows name it), so no `cross-lane=` row
#       could be decided for it. A commit touching no declared area gets no
#       note: it could print no row whatever its attribution.
#   campaign-first-commit-unknown\t<campaign>
#       No commit on the ref adds the campaign file, so the cross-lane range
#       has no start and the check was not made for that campaign.
#   local-ref
#       The ref belongs to no remote, so no fetch was owed and the answer is as
#       local as the ref is.
#
# ## cut — the lane proposal
#
# `cut --checkouts <N> [--tolerance <k>]` distributes the LIVE work packages
# of the workbench above pwd over N lanes, one per checkout, so that two
# packages whose declared areas overlap never stand in different lanes, and
# writes the proposal `lanes --from` takes. It reads the WORKING TREE (the
# steering checkout plans on its own pulled tree), never a ref, and fetches
# nothing: `hooks/lib/work-graph.ts` for the live packages, their order,
# depth and resolved edges (a `done` or `dropped` package is no node, so an
# edge on one is no hand-off), and each live package's `resources` through
# the codec's `show`. Without `--checkouts` it is a usage error, exit 2, and
# nothing is on stdout. The mechanism is `hooks/lib/campaign-cut.ts`, whose
# header states each rule; in short:
#
#   --checkouts <N>   The number of lanes, a whole number above zero. Required.
#   --tolerance <k>   The imbalance tolerance, a whole number from zero, 1 when
#                     absent: a lane stays within tolerance while its member
#                     count is at most `ceil(members / N) + k`.
#
# Packages whose declared areas overlap (equal, or one a prefix of the other
# at a `/` boundary) form one group, never split. Groups are placed in order
# of dependency depth descending, then member count descending, then name;
# each on the lane with the fewest members among those that hold an edge
# neighbour of the group and stay within tolerance, else on the lane with the
# fewest members overall. A group that fits in no lane within tolerance still
# goes to the smallest lane and is printed as an `imbalance=` row: the user
# accepts it, takes a shared file out of `resources`, or changes N. A file
# several lanes touch by design is declared on no package (ruling B of
# 2026-11-09 in the campaign package); declared all the same, it joins every
# group that names it into one, which the `imbalance=` row shows. No size
# figure enters: a count is a number of members, never an estimate of effort.
# Deterministic: two runs over one store print the same bytes.
#
# ## Output of `cut`, one KEY=value per line, in this order
#
#   checkouts=<N>
#   tolerance=<k>
#   members=<n>         The live packages, the nodes of the cut.
#   bound=<n>           `ceil(members / N)`.
#   lane=<n>\t<package>
#                       One per live package, lane 1 first, each lane's
#                       members in the global order `bin/fusion-work-order`
#                       prints, prerequisites first. Lane `<n>` is `lane-<n>`
#                       in the proposal file.
#   handoff=<from>\t<to>\t<from lane>\t<to lane>
#                       One per dependency edge whose ends stand in different
#                       lanes, from the prerequisite to the dependent, the
#                       direction the work passes. Ascending by `from`, then
#                       `to`.
#   no-areas=<package>  One per live package with no declared area, ascending.
#   no-areas-count=<n>
#   imbalance=<lane>\t<size>\t<members>
#                       One per group that fit in no lane within tolerance:
#                       the lane it went to, that lane's member count after
#                       the placement, the group's members comma-separated.
#   delta-plus=checkouts\t<N+1>
#   delta-plus=move\t<package>\t<lane at N>\t<lane at N+1>
#   delta-plus=handoff-appears\t<from>\t<to>
#   delta-plus=handoff-disappears\t<from>\t<to>
#                       The same cut at N+1 against the cut at N: the first
#                       row always, then one row per package whose lane
#                       number differs and per hand-off that is there at N+1
#                       and not at N, or at N and not at N+1. Lane numbers are
#                       what the rules assign, so a renumbering counts as
#                       moves.
#   delta-minus=...     The same rows against N-1. None at N=1: there is no
#                       cut over zero lanes.
#   proposal=<path>     The proposal file, `campaign-cut-<N>-<k>.json` under
#                       what `bin/fusion-tmp path` prints, so a second run
#                       with the same parameters replaces it and the file
#                       survives the run for `lanes --from`.
#
# ## The proposal file
#
# One JSON object. `lanes --from` reads its `lanes` key alone
# (`hooks/lib/campaign-write.ts` `readProposal`) and ignores every other key,
# which restates the rows above for a reader of the file:
#
#   {
#     "checkouts": <N>,
#     "tolerance": <k>,
#     "bound": <n>,
#     "lanes": [{"id": "lane-1", "members": ["<container name>", ...]}, ...],
#     "handoffs": [{"from", "to", "from_lane": "lane-<n>", "to_lane": "lane-<n>"}, ...],
#     "no_areas": ["<container name>", ...],
#     "imbalance": [{"lane": "lane-<n>", "size": <n>, "members": [...]}, ...]
#   }
#
# By construction every live package stands in exactly one lane and every
# lane id is distinct, two of the codec's three lane rules; the third, one
# checkout per lane, is `lanes --assign`'s.
#
# ## The steering writes
#
# The campaign record is `campaigns/<id>/campaign.json` in the workbench above
# pwd, read and written in the WORKING TREE (the steering checkout plans on
# its own pulled tree), never at a ref. The codec reads a campaign and writes
# none, so these sub-commands are its writer (`hooks/lib/campaign-write.ts`,
# whose header is the account of the mechanism). They commit nothing: the
# steering session commits the file through the ordinary commit step, and the
# act reaches a working session at that session's next commit cycle.
#
# Every write runs the same sequence. The codec's gate first (exit 4 where the
# workbench is refused by name). Then THE CLAIM TEST: `bin/fusion-claimed-package`
# from pwd; a `PACKAGE=` line, or that helper's refusal over two claimed
# packages, is exit 8 and nothing is written, because a steering act runs only
# from a checkout holding no claimed package. Then the candidate, the stored
# record with the act applied (or, for `open`, the new document), with
# `state.charter_hash` and `state.revision` set to placeholders; the candidate
# is placed in a scratch workbench under what `bin/fusion-tmp path` prints and
# the codec's `show` is asked, whose member `prior` for a campaign holds
# Prior's `charterHash` and `stateRevision`, computed by the bundle
# (`codec/README.md`, "The member `prior` on a campaign's `show`"); the two
# values replace the placeholders; the filled candidate is placed again and
# the codec's `validate` must answer no finding, the three lane rules
# included; the file is written beside its target and renamed into place. A
# refusal at `show` or at `validate`, and an act that does not apply, is exit 9
# with nothing written. The scratch directory is removed on every way out.
#
# The two stored values therefore equal `prior` after every write. `lanes`,
# `register` and `formation` are no part of the export, so a write that
# changes the lanes alone stores the two values it had, while the file's own
# `sha256:` revision moves; `pause`, `resume` and `end` move `state.revision`.
#
# `--campaign <id>` names the campaign on every write but `open`. Without it
# the write names the one live campaign of the workbench (a `state.state`
# outside `completed`, `bounded`, `failed`, `cancelled`, `archived`,
# `discarded`); none or several is refused, the several named.
#
#   open      writes `campaigns/<id>/campaign.json`, refusing an id that is
#             not `YYMMDD-HHMM-<slug>` (exit 2) and one that exists (exit 9,
#             `conflict/campaign-exists`). The charter carries the values
#             request 80 `### Stated and not asked` states
#             (`codec/fixtures/prior/REQUESTS.md`): `revision`
#             `prior-opaque:r1`, `authorisation_ref` and `objective` as given,
#             `stop_conditions` the `--stop` values in order, `delivery_policy`
#             the working rule "commit, then pull with rebase, then read the
#             campaign, then push", the limits at the minimum Prior admits.
#             The state is `running` with `reason` null and empty `sessions`
#             and `runs` (the first stored state Prior's lifecycle cannot
#             produce, a stated Claude-side deviation), counters and
#             settlement at zero; `lanes`, `register`, `formation`,
#             `baseline_hash`, `requested_outcome`, `previous_terminal` and
#             `completion_evidence` null; `provenance.source` `created`.
#   lanes     replaces `lanes` whole from a proposal file, the file `cut` will
#             write: of it the key `lanes`, an array of
#             `{"id": <lane id>, "members": [<container name>, ...]}`, every
#             other key ignored. Each member is resolved to its record through
#             the codec's `list` (`display` is the container name); a name no
#             package carries is `unknown-scope/package-unknown`. A lane's
#             `checkout_id` is the `--assign <lane>=<hex>` given for it, else
#             null; a lane `--assign` names and the proposal does not is
#             `unknown-scope/lane-unknown`. A proposal that is no such file is
#             `schema-invalid/proposal-unreadable`. A package in two lanes, a
#             lane id twice or a checkout in two lanes is the codec's finding
#             (`schema-invalid/duplicate-lane-member`, `duplicate-lane-id`,
#             `duplicate-lane-checkout`), exit 9.
#   pause     from `running` alone (`conflict/campaign-not-running`): writes
#             `paused` and `state.reason` = the text.
#   resume    from `paused` alone (`conflict/campaign-not-paused`): writes
#             `running` and `state.reason` null (Prior's correction to request
#             80's question 3(a)).
#   move      takes the package out of whichever lane names it and appends it
#             to lane `--to`. The package is its container name; one the
#             workbench does not list is `unknown-scope/package-unknown`, a
#             lane that is not there `unknown-scope/lane-unknown`, no lanes at
#             all `conflict/no-lanes`, the package already in that lane
#             `conflict/package-already-in-lane`.
#   reassign  sets lane `<lane>`'s `checkout_id` to `<hex>`; the same refusals
#             for the lane, and the codec's `duplicate-lane-checkout` where
#             another lane carries that checkout.
#   end       from `running` or `paused` (`conflict/campaign-not-live`): writes
#             the outcome as `state.state` and `--reason` as `state.reason`
#             (null without it). On `completed` alone, `completion_evidence`
#             is written: the four booleans as the user states them, each
#             flag given being true and each absent false; `--watermark` and
#             `--audit-ref` null unless given. Any of those six flags on
#             another outcome is a usage error.
#
# Every act but `open` refuses a terminal campaign named by `--campaign`
# (`conflict/campaign-terminal`), and a record that changed between the read
# and the write (`conflict/revision-moved`).
#
# ## Output of a steering write
#
#   path=<workbench-relative path>   `campaigns/<id>/campaign.json`.
#   revision=sha256:<64 hex>          The written file's revision, over its
#                                     exact bytes, as the codec's `list` and
#                                     `show` answer it.
#
# Exit 0 prints those two lines and nothing else. Exit 8 prints
# `state=holds-package` and `held=<what the claim test found>`; exit 9 prints
# `state=refused` and `refused=<class>/<reason>`; each puts the detail on
# stderr. Every other code prints nothing on stdout.
#
# ## sync — the commit-cycle read, in order
#
# The orchestrator runs it after its commit under the lock, every cycle
# (`agents/orchestrator.md` `### Step 4 — commit`, from plan step 19 on). It
# takes no flag: it reads the branch's upstream and nobody's named ref. The
# mechanism is `hooks/lib/campaign-sync.ts`, whose header argues each step.
#
#   1  resolve the branch and its upstream, fetch, name the fetched head, as
#      `overview` does and under its states;
#   2  extract the manifest, the marker and the campaign store at the fetched
#      head and read them through the codec: `list` for the set, `reconcile`
#      for the findings (the three lane rules among them, which `list` alone
#      does not carry), `show` per readable campaign. A campaign the codec
#      reports a finding against is unreadable: outside the read, never
#      `mine`, no row;
#   3  `mine`: of the live campaigns (`running` or `paused`; a terminal one
#      steers nobody) the one whose lanes name this checkout's identifier,
#      else the one whose `lanes` is null; two under either rule are none,
#      with a `note=`. The identifier is `FUSION_CHECKOUT` where the session
#      exported it, else `bin/fusion-identity`'s `CHECKOUT=`;
#   4  append one `campaign_read` row per readable campaign to the working
#      tree's event log, while `FUSION_SESSION_ID` is set (the `commit` row's
#      own rule): `{"ts","event":"campaign_read","person","checkout",
#      "session_id","campaign","state","revision","detail"}`, the revision the
#      file's `sha256:`, the detail `<id> <state> <first 12 hex of it>`, an
#      unresolved identity half an absent key;
#   5  settle the log: where `git diff --name-only` and `--cached` name the
#      event log alone, commit it under
#      `fusion-commit-lock with campaign -- bash -c 'git add <log> && git commit -F <message>'`,
#      the message file under what `bin/fusion-tmp path` prints, the message
#      `chore(events): the commit and campaign-read rows of checkout <hex>`
#      (no hash: the rebase may replace any). Where other tracked paths are
#      dirty, nothing is committed, every dirty path is deferred, the rebase is
#      skipped and the push is still attempted, as a fast-forward;
#   6  `git rebase <upstream>`; on a stop, `git rebase --abort`, the
#      conflicting paths named, `state=conflict`, exit 10. The user resolves
#      it, nothing is forced;
#   7  `git push` of HEAD to the upstream branch; a push that did not land,
#      the remote's refusal and a transport failure alike, is `state=rejected`
#      with git's stderr passed through, exit 11; after a push that landed, the
#      commits it landed are listed, oldest first, read after the rebase.
#
# WHY THE READ COMES BEFORE THE PULL, AND WHAT THE COMMIT ROW IS WORTH AFTER
# THE REBASE. The tree is dirty by the event log after every locked commit, by
# the lock's design, and git refuses a rebase on a dirty tree; the read
# therefore happens at the fetched ref, needs no pull, and the settling commit
# of step 5 is what makes the rebase possible without a stash (decision
# `261108-2301-how-does-a-working-session-rebase-pull-over-the-log-row-the-lock-just-appended.md`,
# option 1). Where the upstream had moved, the rebase replaces the hash the
# lock's `commit` row carries, and step 5 has already committed that row: the
# remote then holds the row's `checkout`, `ts` and subject beside a hash no
# other clone resolves, and those three are what `## last_push` reads. `sync`
# writes no row after the push, which would reach the remote one cycle late,
# and none before step 5 beyond the `campaign_read` rows, which would cost a
# second settling commit per cycle and go stale again on a rejected push. A
# commit hash is final once the upstream holds it: a hash written into a
# record is the one a `pushed=` line names, never the one `git commit` printed.
#
# ## Output of `sync`, one KEY=value per line, in this order
#
#   state=ok|conflict|rejected
#                       `ok` covers pushed and nothing to push and alone
#                       reaches exit 0; `conflict` is exit 10, `rejected` 11.
#                       A state of `## The state vocabulary` stands here
#                       instead, under its own code, when there was nothing
#                       to read against, and then nothing below is printed.
#   ref=<upstream>      The ref read, the upstream's short name.
#   head=<sha>          The fetched head, before the rebase; the campaigns
#                       below are the tree of this commit.
#   campaign=<id>\t<state>\t<revision>\t<reason|->
#                       One per readable campaign, ascending by id: the
#                       directory's name, `state.state`, the file's `sha256:`
#                       as `list` returns it, `state.reason` or `-`.
#   campaign-unreadable=<id>\t<class>/<reason>
#                       One per campaign the codec reports a finding against,
#                       ascending by id.
#   mine=<id>|none      Step 3.
#   settled=yes         The settling commit landed; absent where nothing was
#                       owed or the dirty paths were deferred.
#   deferred=<path>     One per dirty tracked path, toplevel-relative, the log
#                       included, when the log was not the only one.
#   conflict=<path>     One per conflicting path of the aborted rebase.
#   pushed=<full hash>\t<subject>
#                       One per commit the push landed, oldest first
#                       (`git log --reverse <fetched head>..HEAD`, read after
#                       the rebase). THE ONE SOURCE OF A COMMIT HASH A RECORD
#                       TAKES. None on `conflict` and on `rejected`.
#   paused=<id>\t<reason>
#                       When `mine` is `paused`: the orchestrator dispatches
#                       nothing more, reports the reason and keeps the claim;
#                       the cycle's push has happened by then.
#   note=<token>[\t<field>...]
#                       Zero or more: `local-ref` as on `overview`;
#                       `checkout-unreadable` where no identifier resolved;
#                       `several-campaigns-name-checkout\t<hex>\t<ids>` and
#                       `several-campaigns-without-lanes\t<ids>`, the two
#                       cases step 3 refuses to pick between.
#
# ## Exit codes
#
#   0  the printed answer is the answer: `state=ok` on `overview`, no `held=`
#      line included; the page of `cut` with its `proposal=` line; `path=` and
#      `revision=` on a write; `state=ok` on `sync`, pushed or nothing to push.
#   1  the helper itself could not run: the compiled hooks or the codec bundle
#      are missing, `bin/fusion-tmp path` gave no scratch directory, `git` or
#      `tar` failed where no state names the failure, the claim test could not
#      be made (`bin/fusion-claimed-package` exited for a reason that is no
#      answer), or an internal error. The reason is on stderr and nothing is
#      on stdout.
#   2  usage error: no sub-command or an unknown one, an unknown or repeated
#      flag, a flag without its value, `--window` that is no whole number above
#      zero, `--ref` that is empty or begins with a dash, `cut` without
#      `--checkouts` or with one that is no whole number above zero, a
#      `--tolerance` that is no whole number from zero, a write without a
#      required flag, an `--id` that is not `YYMMDD-HHMM-<slug>`, a checkout
#      that is not eight lowercase hex characters, an `--outcome` outside the
#      four, an evidence flag on an outcome other than `completed`.
#   3  no fusion workbench above pwd.
#   4  the workbench was not read: the codec's gate refused it by name
#      (`legacy`, a workbench without its manifest, or `unsupported`), or the
#      codec refused a read or gave no answer. For `overview` that is the
#      workbench at the commit; for `cut` and for a write, the one in the
#      working tree. The cause is on stderr and NOTHING is on stdout: a named
#      failure and never an empty overview, an empty cut or a half-made write.
#   5  nothing to read against: `state=` is `no-work-tree`, `no-branch`,
#      `no-upstream`, `upstream-unresolved` or `workbench-untracked`
#      (`overview`, `sync`).
#   6  the fetch did not complete, `state=fetch-failed`. git's own stderr is
#      passed through unmodified (`overview`, `sync`).
#   7  the workbench is not inside this repository,
#      `state=workbench-outside-repo` (`overview`, `sync`).
#   8  `state=holds-package`: a steering act from a checkout that holds a
#      claimed package, or whose two claims `bin/fusion-claimed-package`
#      refused to choose between. Nothing was written (`open`, `lanes`,
#      `pause`, `resume`, `move`, `reassign`, `end`).
#   9  `state=refused`: the write did not validate or the act does not apply,
#      `refused=<class>/<reason>` says which, and nothing was written (the
#      same seven).
#  10  `state=conflict`: the rebase stopped and was aborted; the conflicting
#      paths are the `conflict=` lines, the rows were read and settled, and
#      nothing was pushed (`sync`).
#  11  `state=rejected`: the push did not land; git's stderr is passed
#      through. The rebase, where one ran, stands (`sync`).
#
# 2, 3, 5, 6 and 7 are `bin/fusion-forum`'s numbers with its meanings; 1 and 4
# are this script's own, that script having no codec to fail and no compiled
# half to miss; 8 and 9 are the writes' and 10 and 11 `sync`'s (the plan's
# `## API Changes`, one table across every sub-command, after
# `261109-1440-the-plans-exit-codes-for-steps-16-and-17-collide-with-the-ones-overview-already-uses.md`).
# A caller reads `state=` and defines no code.
#
# ## The state vocabulary
#
# The values and the order in which they are tested are those of
# `bin/fusion-forum` `## The state vocabulary`, which argues each.
#
#   ok                      Exit 0. The lines above are the answer.
#   no-work-tree            Exit 5. A workbench and no repository, so no remote
#                           and no ref.
#   no-branch               Exit 5. Detached HEAD and no `--ref`: a detached
#                           HEAD has no upstream, and none is guessed.
#   no-upstream             Exit 5. The branch tracks nothing and no `--ref`
#                           was given; `origin` is never assumed.
#   upstream-unresolved     Exit 5. The upstream, or the ref `--ref` names,
#                           resolves to no commit even after the fetch.
#   workbench-untracked     Exit 5. The workbench is in no tree at the commit:
#                           the project does not track it there, so nothing
#                           another checkout wrote can arrive by fetch, and an
#                           overview with no `held=` line would be a false
#                           answer.
#   fetch-failed            Exit 6.
#   workbench-outside-repo  Exit 7. The workbench marker sits in an ancestor of
#                           the repository, so the workbench has no path in a
#                           commit.
#   conflict                Exit 10, `sync` alone: the rebase stopped and was
#                           aborted.
#   rejected                Exit 11, `sync` alone: the push did not land.
#
# On a state of exit 5, 6 or 7 the `state=` line is followed by `branch=<name>`
# and `ref=<upstream>` as far as each was resolved before the read stopped,
# and by nothing else. With `--ref` no `branch=` line is printed. On
# `conflict` and `rejected` the whole page of `## Output of \`sync\`` stands.
#
# ## What it touches
#
# `overview`: the fetch updates the repository's remote-tracking refs, as any
# fetch does. Nothing in the working tree is read except to find the workbench
# and the repository's root, and nothing in it is written: `git status
# --porcelain` is the same before and after. The full tier reads the campaign
# files out of the same extract, through the codec's `list`, `reconcile` and
# `show`, and runs `git log` over the ref for the cross-lane check. The one thing written is a
# scratch directory under what `bin/fusion-tmp path` prints, removed on every
# way out, an interrupt included. One side effect is that helper's and not
# this one's: on the first run in a checkout that has no identifier yet, the
# identity helper it calls mints one, as it does for every program that asks.
#
# `cut` reads the working tree's workbench through the codec and writes one
# file, the proposal under what `bin/fusion-tmp path` prints, outside every
# git tree; it fetches nothing, commits nothing and touches no workbench file.
#
# A steering write touches one file of the working tree, the campaign record
# it names, written whole by rename; on exit 8 and 9 it touches none. It
# fetches nothing and commits nothing.
#
# `sync` is the one sub-command that moves the repository: it appends to the
# working tree's event log, commits that log alone under the lock, rebases
# the branch onto its upstream and pushes it. It runs no `stash`,
# `--autostash`, `checkout .`, `reset --hard` or `clean`, and an aborted
# rebase leaves the branch where the settling commit left it. Its scratch
# directory is removed on every way out, as `overview`'s is.
#
# No sub-command sends the codec a mutation: the codec has none for a
# campaign, and the writes reach it through `show` and `validate` alone. No
# cache, no index: the overview is recomputed per run and discarded.
#
# The work is hooks/dist/campaign.js, resolved relative to this script rather
# than through $FUSION_PLUGIN_ROOT, so an install copy and a work tree each run
# their own build, their own codec bundle and their own sibling helpers. node
# is already a hard requirement: the plugin's hooks are node programs.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
entry="$here/../hooks/dist/campaign.js"

if [ ! -f "$entry" ]; then
  echo "fusion-campaign: $entry is missing — the plugin's compiled hooks are not installed." >&2
  exit 1
fi

exec node "$entry" "$@"
